    <!-- Nút Bấm Tác Chiến Đỏ Mạ Vàng (Combat Primary Button) -->
    <Style x:Key="CombatPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource MilRedBrush}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="{StaticResource MilGoldLightBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource MilRedHoverBrush}"/>
                            <Setter TargetName="btnBorder" Property="BorderBrush" Value="{StaticResource MilGoldBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource MilRedDarkBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nút Bấm Tác Chiến Ô-liu Viền Đồng (Combat Secondary Button) -->
    <Style x:Key="CombatSecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource MilSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource MilTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MilBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource MilSurface2Brush}"/>
                            <Setter TargetName="btnBorder" Property="BorderBrush" Value="{StaticResource MilBorderHighBrush}"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource MilOliveDarkBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ô Nhập Liệu Giấy Quân Lệnh (Combat Parchment TextBox) -->
    <Style x:Key="CombatParchmentTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource MilInputBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource MilTextDarkBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MilBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource MilGoldBrush}"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            <Setter Property="Background" Value="#FFF6D8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox Giấy Quân Lệnh (Combat Parchment ComboBox) -->
    <Style x:Key="CombatParchmentComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource MilInputBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource MilTextDarkBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MilBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="8,6"/>
    </Style>

    <!-- Khung Thẻ Tác Chiến Quân Đội (Combat Card Border) -->
    <Style x:Key="CombatCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource MilSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MilBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- Khung Thẻ KPI Tác Chiến (Combat KPI Card) -->
    <Style x:Key="CombatKpiCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource MilOliveDarkBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MilBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="14,12"/>
    </Style>

</ResourceDictionary>
