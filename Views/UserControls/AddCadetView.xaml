<UserControl x:Class="QL_HocVien.Views.UserControls.AddCadetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local_cv="clr-namespace:QL_HocVien.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="800" HorizontalAlignment="Left">
            <!-- Tiêu đề -->
            <TextBlock Text="THÊM MỚI HỒ SƠ HỌC VIÊN" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="Học viên có thể sử dụng mã gợi ý sẵn có hoặc tự điền mã định danh của mình, cùng họ tên, số điện thoại, lớp và đơn vị" 
                       FontSize="13" Foreground="#64748B" Margin="0,4,0,24"/>

            <!-- Thông báo thành công / lỗi -->
            <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16"
                    Visibility="{Binding SuccessMessage, Converter={x:Static local_cv:StringToVisibilityConverter.Instance}}">
                <TextBlock Text="{Binding SuccessMessage}" Foreground="#16A34A" FontSize="13" FontWeight="SemiBold"/>
            </Border>
            <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16"
                    Visibility="{Binding ErrorMessage, Converter={x:Static local_cv:StringToVisibilityConverter.Instance}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="13" FontWeight="SemiBold"/>
            </Border>

            <!-- Khung Form nhập liệu -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="28">
                <StackPanel>
                    <!-- Hàng 1: Mã học viên (Có sẵn mã gợi ý + tự viết được) -->
                    <TextBlock Text="Mã học viên (Tự do nhập hoặc dùng mã gợi ý có sẵn):" FontSize="13" FontWeight="SemiBold" Foreground="#1E3A8A" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding CadetCode, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource ModernTextBoxStyle}" Height="40" FontSize="15" FontWeight="Bold" Foreground="#1E3A8A"/>
                        <Button Grid.Column="2" Content="🔄 Đổi Mã Gợi Ý Mới" Style="{StaticResource SecondaryButtonStyle}" Height="40"
                                Command="{Binding GenerateSuggestedCodeCommand}"/>
                    </Grid>

                    <!-- Hàng 2: Họ và Tên & Số điện thoại -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Họ và tên học viên (*):" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="40"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Số điện thoại (*):" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="40"/>
                        </StackPanel>
                    </Grid>

                    <!-- Hàng 3: Lớp học & Đơn vị -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Lớp học (*):" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding ClassName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="40"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Đơn vị quân đội:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding UnitList}" SelectedItem="{Binding SelectedUnit}" Style="{StaticResource ModernComboBoxStyle}" Height="40"/>
                        </StackPanel>
                    </Grid>

                    <!-- Hàng 4: Cấp bậc & Chức vụ -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Cấp bậc quân hàm:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding RankList}" SelectedItem="{Binding SelectedRank}" Style="{StaticResource ModernComboBoxStyle}" Height="40"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Chức vụ:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding PositionList}" SelectedItem="{Binding SelectedPosition}" Style="{StaticResource ModernComboBoxStyle}" Height="40"/>
                        </StackPanel>
                    </Grid>

                    <!-- Hàng 5: Giới tính, Ngày sinh & Email -->
                    <Grid Margin="0,0,0,28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Giới tính:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding GenderList}" SelectedItem="{Binding SelectedGender}" Style="{StaticResource ModernComboBoxStyle}" Height="40"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Ngày tháng năm sinh:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                            <DatePicker SelectedDate="{Binding DateOfBirth}" Height="40" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Địa chỉ Email:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="40"/>
                        </StackPanel>
                    </Grid>

                    <!-- Các nút hành động -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Quay Lại Danh Sách" Style="{StaticResource SecondaryButtonStyle}" Height="42" Margin="0,0,12,0"
                                Command="{Binding CancelCommand}"/>
                        <Button Content="💾 Lưu &amp; Thêm Tiếp" Style="{StaticResource SecondaryButtonStyle}" Height="42" Margin="0,0,12,0"
                                Command="{Binding SaveAndContinueCommand}"/>
                        <Button Content="✓ LƯU HỒ SƠ HỌC VIÊN" Style="{StaticResource PrimaryButtonStyle}" Height="42" Width="200"
                                Command="{Binding SaveCadetCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
