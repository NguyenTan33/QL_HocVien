<UserControl x:Class="QL_HocVien.Views.UserControls.ClassManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local_cv="clr-namespace:QL_HocVien.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <Border Padding="24">
        <Grid>
            <!-- Giao diện chính -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Tiêu đề & Nút Thao tác -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,6">
                        <TextBlock Text="QUẢN LÝ LỚP HỌC QUÂN ĐỘI" FontSize="20" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap"/>
                        <TextBlock Text="Quản lý cơ cấu lớp học, đơn vị trực thuộc, chuyên ngành đào tạo và sĩ số quân số" 
                                   FontSize="13" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="{Binding SelectAllButtonText}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,6"
                                Command="{Binding ToggleSelectAllCommand}" ToolTip="Chọn hoặc bỏ chọn tất cả lớp học"/>
                        <Button Content="📥 Nhập Excel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,6"
                                Command="{Binding ImportExcelCommand}"/>
                        <Button Content="📤 Xuất Excel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,6"
                                Command="{Binding ExportExcelCommand}"/>
                        <Button Content="👥 Xem Quân Số" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,6"
                                Command="{Binding ViewClassCadetsCommand}"/>
                        <Button Content="➕ Thêm Lớp Mới" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,6"
                                Command="{Binding OpenAddFormCommand}"/>
                        <Button Content="✏️ Sửa" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,6"
                                Command="{Binding OpenEditFormCommand}"/>
                        <Button Content="🗑️ Xóa" Style="{StaticResource DangerButtonStyle}" Margin="0,0,0,6"
                                Command="{Binding DeleteClassCommand}"/>
                    </WrapPanel>
                </Grid>

                <!-- Thanh Tìm Kiếm & Bộ Lọc Nâng Cao Đa Tiêu Chí -->
                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="14">
                    <StackPanel>
                        <!-- Hàng lọc cơ bản -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Tìm kiếm từ khóa -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tìm kiếm theo mã, tên lớp, cán bộ:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBoxStyle}" Height="36"/>
                            </StackPanel>

                            <!-- Lọc theo Đơn vị -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Đơn vị quản lý:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit}" 
                                          Style="{StaticResource ModernComboBoxStyle}" Height="36"/>
                            </StackPanel>

                            <!-- Lọc theo Chuyên ngành -->
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Chuyên ngành đào tạo:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding Majors}" SelectedItem="{Binding SelectedMajor}" 
                                          Style="{StaticResource ModernComboBoxStyle}" Height="36"/>
                            </StackPanel>

                            <!-- Nút Lọc Nâng Cao -->
                            <Button Grid.Column="6" Content="⚙️ Lọc Nâng Cao" VerticalAlignment="Bottom" Height="36" 
                                    Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ToggleAdvancedFilterCommand}"/>

                            <!-- Nút Xóa Lọc -->
                            <Button Grid.Column="8" Content="✕ Xóa Lọc" VerticalAlignment="Bottom" Height="36" 
                                    Style="{StaticResource DangerButtonStyle}" Command="{Binding ResetFiltersCommand}"/>
                        </Grid>

                        <!-- Khung mở rộng: Lọc Nâng Cao Lớp Học -->
                        <Border Visibility="{Binding IsAdvancedFilterVisible, Converter={x:Static local_cv:BooleanToVisibilityConverter.Instance}}"
                                Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="🎯 BỘ LỌC NÂNG CAO LỚP HỌC (Niên khóa, Phân công cán bộ &amp; Quy mô sĩ số)" 
                                           FontSize="12" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,10"/>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="1.8*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Lọc Khóa học / Niên khóa -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Niên khóa / Khóa học:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                                        <ComboBox ItemsSource="{Binding AcademicYears}" SelectedItem="{Binding SelectedAcademicYear}" 
                                                  Style="{StaticResource ModernComboBoxStyle}" Height="34"/>
                                    </StackPanel>

                                    <!-- Lọc Phân công cán bộ -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Tình trạng phân công cán bộ:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                                        <ComboBox ItemsSource="{Binding HasOfficerList}" SelectedItem="{Binding SelectedHasOfficer}" 
                                                  Style="{StaticResource ModernComboBoxStyle}" Height="34"/>
                                    </StackPanel>

                                    <!-- Lọc Sĩ số học viên -->
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Khoảng sĩ số học viên (Từ - Đến):" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding FilterMinCadets, UpdateSourceTrigger=PropertyChanged}" 
                                                     Style="{StaticResource ModernTextBoxStyle}" Height="34" Tag="Tối thiểu"/>
                                            <TextBlock Grid.Column="1" Text="-" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#94A3B8"/>
                                            <TextBox Grid.Column="2" Text="{Binding FilterMaxCadets, UpdateSourceTrigger=PropertyChanged}" 
                                                     Style="{StaticResource ModernTextBoxStyle}" Height="34" Tag="Tối đa"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Bảng Dữ Liệu Lớp Học -->
                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="0">
                    <DataGrid ItemsSource="{Binding Classes}" SelectedItem="{Binding SelectedClass}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="White"
                              BorderThickness="0" RowHeight="42" SelectionMode="Single"
                              AlternationCount="2"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="48" CanUserResize="False">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox IsChecked="{Binding DataContext.IsAllSelected, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Mã Lớp" Binding="{Binding ClassCode}" Width="100"/>
                            <DataGridTextColumn Header="Tên Lớp Học" Binding="{Binding ClassName}" Width="220"/>
                            <DataGridTextColumn Header="Đơn Vị Trực Thuộc" Binding="{Binding Unit}" Width="140"/>
                            <DataGridTextColumn Header="Chuyên Ngành" Binding="{Binding Major}" Width="180"/>
                            <DataGridTextColumn Header="Cán Bộ Quản Lý" Binding="{Binding OfficerInCharge}" Width="180"/>
                            <DataGridTextColumn Header="Khóa Học" Binding="{Binding AcademicYear}" Width="120"/>
                            <DataGridTemplateColumn Header="Quân Số" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#EFF6FF" CornerRadius="12" Padding="8,3" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Cadets.Count, StringFormat='{}{0} HV'}" FontWeight="Bold" Foreground="#1E40AF" FontSize="12"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Ghi Chú / Mô Tả" Binding="{Binding Description}" MinWidth="180" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- ==================== MODAL THÊM / SỬA LỚP HỌC ==================== -->
            <Grid Background="#7F000000" Visibility="{Binding IsFormVisible, Converter={x:Static local_cv:BooleanToVisibilityConverter.Instance}}">
                <Border Background="White" CornerRadius="12" Width="550" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" Color="#000000" Opacity="0.3" ShadowDepth="5"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="{Binding IsEditing, Converter={x:Static local_cv:BooleanToVisibilityConverter.Instance}}" 
                                   Visibility="Collapsed"/>
                        <TextBlock Text="THÔNG TIN LỚP HỌC QUÂN ĐỘI" 
                                   FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4"/>
                        <TextBlock Text="Cấu hình mã lớp, tên lớp, đơn vị và phân công cán bộ chủ nhiệm" FontSize="12" Foreground="#64748B" Margin="0,0,0,16"/>

                        <!-- Thông báo lỗi modal -->
                        <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,14"
                                Visibility="{Binding FormErrorMessage, Converter={x:Static local_cv:StringToVisibilityConverter.Instance}}">
                            <TextBlock Text="{Binding FormErrorMessage}" Foreground="#DC2626" FontSize="12"/>
                        </Border>

                        <!-- Hàng 1: Mã lớp & Tên lớp -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Mã lớp (*):" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormClassCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="36"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Tên lớp (*):" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormClassName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="36"/>
                            </StackPanel>
                        </Grid>

                        <!-- Hàng 2: Đơn vị & Chuyên ngành -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Đơn vị trực thuộc:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormUnit, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="36"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Chuyên ngành:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormMajor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="36"/>
                            </StackPanel>
                        </Grid>

                        <!-- Hàng 3: Cán bộ quản lý & Khóa học -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Cán bộ chủ nhiệm / Phụ trách:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding AvailableOfficers}" Text="{Binding FormOfficerInCharge, UpdateSourceTrigger=PropertyChanged}" 
                                          IsEditable="True" Style="{StaticResource ModernComboBoxStyle}" Height="36"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Khóa / Niên khóa:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormAcademicYear, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="36"/>
                            </StackPanel>
                        </Grid>

                        <!-- Mô tả -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Mô tả / Ghi chú:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="60" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Hủy Bỏ" Style="{StaticResource SecondaryButtonStyle}" Width="90" Height="36" Margin="0,0,10,0"
                                    Command="{Binding CloseFormCommand}"/>
                            <Button Content="Lưu Lớp Học" Style="{StaticResource PrimaryButtonStyle}" Width="120" Height="36"
                                    Command="{Binding SaveFormCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ==================== MODAL XEM QUÂN SỐ HỌC VIÊN THUỘC LỚP ==================== -->
            <Grid Background="#7F000000" Visibility="{Binding IsCadetListVisible, Converter={x:Static local_cv:BooleanToVisibilityConverter.Instance}}">
                <Border Background="White" CornerRadius="12" Width="750" MaxHeight="550" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" Color="#000000" Opacity="0.3" ShadowDepth="5"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{Binding ViewingClass.ClassName, StringFormat='{}QUÂN SỐ LỚP: {0}'}" 
                                           FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="{Binding ClassCadets.Count, StringFormat='{}Tổng quân số: {0} học viên'}" 
                                           FontSize="13" Foreground="#2563EB" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" 
                                    Width="32" Height="32" Style="{StaticResource SecondaryButtonStyle}" 
                                    Command="{Binding CloseCadetListCommand}"/>
                        </Grid>

                        <!-- Cadet Table -->
                        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="0" Margin="0,0,0,16">
                            <DataGrid ItemsSource="{Binding ClassCadets}" AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                      Background="Transparent" BorderThickness="0" RowHeight="38">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã Học Viên" Binding="{Binding CadetCode}" Width="120"/>
                                    <DataGridTextColumn Header="Họ và Tên" Binding="{Binding FullName}" Width="180"/>
                                    <DataGridTextColumn Header="Cấp Bậc" Binding="{Binding Rank}" Width="100"/>
                                    <DataGridTextColumn Header="Chức Vụ" Binding="{Binding Position}" Width="110"/>
                                    <DataGridTextColumn Header="Số Điện Thoại" Binding="{Binding PhoneNumber}" Width="120"/>
                                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- Footer -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Đóng" Style="{StaticResource SecondaryButtonStyle}" Width="100" Height="36"
                                    Command="{Binding CloseCadetListCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Border>
</UserControl>
