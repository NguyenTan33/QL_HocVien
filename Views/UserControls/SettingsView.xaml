<UserControl x:Class="QL_HocVien.Views.UserControls.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local_cv="clr-namespace:QL_HocVien.Converters"
             xmlns:helpers="clr-namespace:QL_HocVien.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="950" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="860" HorizontalAlignment="Left">
            <!-- HEADER TRANG CÀI ĐẶT -->
            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="CÀI ĐẶT HỆ THỐNG &amp; BẢO MẬT DỮ LIỆU" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Cấu hình Khóa bảo vệ dữ liệu cấp 2 (Khóa rương), Đổi mật khẩu tài khoản người dùng và Cập nhật phiên bản hệ thống" 
                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- THÔNG BÁO CHUNG -->
            <Border Background="{DynamicResource SuccessCardBackgroundBrush}" BorderBrush="{DynamicResource SuccessCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,18"
                    Visibility="{Binding StatusMessage, Converter={x:Static local_cv:StringToVisibilityConverter.Instance}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔔 " FontSize="14"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SuccessCardForegroundBrush}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ==================== 1. KHÓA BẢO MẬT CẤP 2 (KHÓA RƯƠNG) ==================== -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="22" Margin="0,0,0,22">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🛡️" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Khóa Bảo Mật Cấp 2 (Bảo Vệ Dữ Liệu An Toàn)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Chặn mọi hành vi Thêm, Sửa, Xóa, Nhập/Xuất Excel (chỉ cho phép xem). Mở khóa 1 lần được tự do 5 phút; quá 5 phút hệ thống tự động khóa lại." 
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Nút khóa ngay nếu đang mở khóa -->
                        <Button Grid.Column="1" Content="🔒 Khóa Ngay Lập Tức" Height="34" Padding="14,0"
                                Style="{StaticResource DangerButtonStyle}" FontWeight="Bold" Cursor="Hand"
                                Command="{Binding LockNowCommand}"
                                Visibility="{Binding IsUnlocked, Converter={x:Static local_cv:BooleanToVisibilityConverter.Instance}}"/>
                    </Grid>

                    <!-- Trạng thái bảo mật hiện tại -->
                    <Border Background="{DynamicResource PageBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Trạng thái hiện tại:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding SecurityStatusDisplay}" FontSize="13" FontWeight="Bold" Margin="0,4,0,0"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Thông báo phản hồi bảo mật -->
                    <Border Background="{DynamicResource DangerCardBackgroundBrush}" BorderBrush="{DynamicResource DangerCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,14"
                            Visibility="{Binding SecurityMessage, Converter={x:Static local_cv:StringToVisibilityConverter.Instance}}">
                        <TextBlock Text="{Binding SecurityMessage}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource DangerCardForegroundBrush}"/>
                    </Border>

                    <!-- KHU VỰC KÍCH HOẠT (Nếu chưa bật) -->
                    <StackPanel Visibility="{Binding IsProtectionEnabled, Converter={x:Static local_cv:InvertedBooleanToVisibilityConverter.Instance}}">
                        <TextBlock Text="KÍCH HOẠT KHÓA BẢO VỆ CẤP 2" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Thiết lập Mật khẩu mới:*" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <PasswordBox Height="36" helpers:PasswordBoxHelper.BindPassword="True"
                                             helpers:PasswordBoxHelper.BoundPassword="{Binding EnablePassword, Mode=TwoWay}"
                                             Style="{StaticResource ModernPasswordBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Xác nhận lại Mật khẩu mới:*" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <PasswordBox Height="36" helpers:PasswordBoxHelper.BindPassword="True"
                                             helpers:PasswordBoxHelper.BoundPassword="{Binding EnableConfirmPassword, Mode=TwoWay}"
                                             Style="{StaticResource ModernPasswordBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <Button Content="🛡️ Kích Hoạt Khóa Bảo Mật Cấp 2" Height="38" Width="260" HorizontalAlignment="Left"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding EnableProtectionCommand}"/>
                    </StackPanel>

                    <!-- KHU VỰC QUẢN LÝ (Khi đã bật: Đổi mật khẩu & Tắt khóa) -->
                    <Grid Visibility="{Binding IsProtectionEnabled, Converter={x:Static local_cv:BooleanToVisibilityConverter.Instance}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Đổi mật khẩu -->
                        <Border Grid.Column="0" Background="{DynamicResource PageBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                            <StackPanel>
                                <TextBlock Text="🔑 ĐỔI MẬT KHẨU CẤP 2" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                                <TextBlock Text="Mật khẩu hiện tại:*" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <PasswordBox Height="34" helpers:PasswordBoxHelper.BindPassword="True"
                                             helpers:PasswordBoxHelper.BoundPassword="{Binding ChangeOldPassword, Mode=TwoWay}"
                                             Style="{StaticResource ModernPasswordBoxStyle}" Margin="0,0,0,10"/>

                                <TextBlock Text="Mật khẩu mới:*" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <PasswordBox Height="34" helpers:PasswordBoxHelper.BindPassword="True"
                                             helpers:PasswordBoxHelper.BoundPassword="{Binding ChangeNewPassword, Mode=TwoWay}"
                                             Style="{StaticResource ModernPasswordBoxStyle}" Margin="0,0,0,10"/>

                                <TextBlock Text="Xác nhận mật khẩu mới:*" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <PasswordBox Height="34" helpers:PasswordBoxHelper.BindPassword="True"
                                             helpers:PasswordBoxHelper.BoundPassword="{Binding ChangeConfirmPassword, Mode=TwoWay}"
                                             Style="{StaticResource ModernPasswordBoxStyle}" Margin="0,0,0,14"/>

                                <Button Content="💾 Lưu Mật Khẩu Mới" Height="36" Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding ChangePasswordCommand}"/>
                            </StackPanel>
                        </Border>

                        <!-- Tắt bảo mật -->
                        <Border Grid.Column="2" Background="{DynamicResource DangerCardBackgroundBrush}" BorderBrush="{DynamicResource DangerCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                            <StackPanel>
                                <TextBlock Text="⚠️ TẮT BẢO MẬT CẤP 2" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource DangerCardForegroundBrush}" Margin="0,0,0,6"/>
                                <TextBlock Text="Hệ thống sẽ cho phép mọi người dùng thêm/sửa/xóa mà không cần mật khẩu bảo vệ." 
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                <TextBlock Text="Mật khẩu hiện tại để xác thực:*" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <PasswordBox Height="34" helpers:PasswordBoxHelper.BindPassword="True"
                                             helpers:PasswordBoxHelper.BoundPassword="{Binding DisablePassword, Mode=TwoWay}"
                                             Style="{StaticResource ModernPasswordBoxStyle}" Margin="0,0,0,14"/>

                                <Button Content="⚪ Tắt Bảo Mật Cấp 2" Height="36" Style="{StaticResource DangerButtonStyle}"
                                        FontWeight="Bold" Cursor="Hand"
                                        Command="{Binding DisableProtectionCommand}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==================== 2. ĐỔI MẬT KHẨU TÀI KHOẢN ĐĂNG NHẬP ==================== -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="22" Margin="0,0,0,22">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="🔑" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="ĐỔI MẬT KHẨU TÀI KHOẢN ĐĂNG NHẬP" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Thay đổi mật khẩu đăng nhập trực tiếp trên hệ thống máy cục bộ (Chế độ hoạt động độc lập Offline 100%, bảo mật cao)" 
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16"/>

                    <!-- Thông tin tài khoản hiện tại -->
                    <Border Background="{DynamicResource PageBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tài khoản đăng nhập:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding CurrentUsername}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Họ và tên người dùng:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding CurrentFullName}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Vai trò hệ thống:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <Border Background="{DynamicResource SuccessCardBackgroundBrush}" BorderBrush="{DynamicResource SuccessCardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding CurrentRole}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource SuccessCardForegroundBrush}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Thông báo phản hồi đổi mật khẩu tài khoản -->
                    <Border Background="{DynamicResource DangerCardBackgroundBrush}" BorderBrush="{DynamicResource DangerCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,14"
                            Visibility="{Binding AccountPasswordMessage, Converter={x:Static local_cv:StringToVisibilityConverter.Instance}}">
                        <TextBlock Text="{Binding AccountPasswordMessage}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource DangerCardForegroundBrush}"/>
                    </Border>

                    <!-- Form nhập mật khẩu -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Mật khẩu hiện tại:*" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <PasswordBox Height="36" helpers:PasswordBoxHelper.BindPassword="True"
                                         helpers:PasswordBoxHelper.BoundPassword="{Binding AccountOldPassword, Mode=TwoWay}"
                                         Style="{StaticResource ModernPasswordBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Mật khẩu mới (tối thiểu 6 ký tự):*" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <PasswordBox Height="36" helpers:PasswordBoxHelper.BindPassword="True"
                                         helpers:PasswordBoxHelper.BoundPassword="{Binding AccountNewPassword, Mode=TwoWay}"
                                         Style="{StaticResource ModernPasswordBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Xác nhận mật khẩu mới:*" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <PasswordBox Height="36" helpers:PasswordBoxHelper.BindPassword="True"
                                         helpers:PasswordBoxHelper.BoundPassword="{Binding AccountConfirmPassword, Mode=TwoWay}"
                                         Style="{StaticResource ModernPasswordBoxStyle}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="💾 Cập Nhật Mật Khẩu Mới" Style="{StaticResource PrimaryButtonStyle}" Height="36" Padding="18,0"
                                Command="{Binding ChangeAccountPasswordCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ==================== 3. THÔNG TIN PHIÊN BẢN & CẬP NHẬT TỰ ĐỘNG ==================== -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="22" Margin="0,0,0,24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="🚀" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="THÔNG TIN PHIÊN BẢN &amp; TỰ ĐỘNG CẬP NHẬT (AUTO-UPDATE)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Cấu hình địa chỉ kiểm tra phiên bản mới từ GitHub hoặc máy chủ riêng, hỗ trợ tải ngầm và tự động cập nhật khi có bản phát hành mới" 
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Phiên bản phần mềm hiện tại:" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Border Grid.Column="1" Background="{DynamicResource SuccessCardBackgroundBrush}" BorderBrush="{DynamicResource SuccessCardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,4" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding AppVersionDisplay}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource SuccessCardForegroundBrush}"/>
                        </Border>
                    </Grid>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Đường dẫn máy chủ kiểm tra (URL version.json):" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding VersionCheckUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="36"/>
                        <TextBlock Text="* Hỗ trợ GitHub Raw Link (ví dụ: https://raw.githubusercontent.com/NguyenTan33/QL_HocVien/main/version.json) hoặc máy chủ nội bộ." 
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Trạng thái kiểm tra cập nhật -->
                    <Border Background="{DynamicResource PageBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,14"
                            Visibility="{Binding UpdateStatusText, Converter={x:Static local_cv:StringToVisibilityConverter.Instance}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔄 " FontSize="12"/>
                            <TextBlock Text="{Binding UpdateStatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="🔍 Kiểm Tra Cập Nhật Ngay" Style="{StaticResource SecondaryButtonStyle}" Height="36" Padding="14,0" Margin="0,0,10,0"
                                Command="{Binding CheckForUpdateManualCommand}"
                                IsEnabled="{Binding IsCheckingUpdate, Converter={x:Static local_cv:InvertedBooleanConverter.Instance}}"/>
                        <Button Content="💾 Lưu Cấu Hình Cập Nhật" Style="{StaticResource PrimaryButtonStyle}" Height="36" Padding="16,0"
                                Command="{Binding SaveSettingsCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
