<UserControl x:Class="QL_HocVien.Views.UserControls.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local_cv="clr-namespace:QL_HocVien.Converters"
             xmlns:helpers="clr-namespace:QL_HocVien.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="950" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="860" HorizontalAlignment="Left">
            <!-- HEADER TRANG CÀI ĐẶT -->
            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="CÀI ĐẶT HỆ THỐNG &amp; BẢO MẬT DỮ LIỆU TÁC CHIẾN" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentLightBrush}"/>
                <TextBlock Text="Cấu hình Khóa bảo vệ dữ liệu cấp 2 (Khóa rương), máy chủ gửi Email OTP (SMTP) và Cổng kết nối tin nhắn SMS cảnh báo" 
                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- THÔNG BÁO CHUNG -->
            <Border Background="#1A2E20" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,18"
                    Visibility="{Binding StatusMessage, Converter={x:Static local_cv:StringToVisibilityConverter.Instance}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔔 " FontSize="14"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#4ADE80" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ==================== 1. KHÓA BẢO MẬT CẤP 2 (KHÓA RƯƠNG) ==================== -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="22" Margin="0,0,0,22" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🛡️" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Khóa Bảo Mật Cấp 2 (Bảo Vệ Dữ Liệu An Toàn)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentLightBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Chặn mọi hành vi Thêm, Sửa, Xóa, Nhập/Xuất Excel (chỉ cho phép xem). Mở khóa 1 lần được tự do 5 phút; quá 5 phút hệ thống tự động khóa lại." 
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Nút khóa ngay nếu đang mở khóa -->
                        <Button Grid.Column="1" Content="🔒 Khóa Ngay Lập Tức" Height="34" Padding="14,0"
                                Background="#B32020" Foreground="White" BorderBrush="#F2C94C" BorderThickness="1" FontWeight="Bold" Cursor="Hand"
                                Command="{Binding LockNowCommand}"
                                Visibility="{Binding IsUnlocked, Converter={x:Static local_cv:BooleanToVisibilityConverter.Instance}}">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <!-- Trạng thái bảo mật hiện tại -->
                    <Border Background="#142016" BorderBrush="#625C34" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Trạng thái hiện tại:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding SecurityStatusDisplay}" FontSize="13" FontWeight="Bold" Margin="0,4,0,0"
                                       Foreground="{DynamicResource AccentLightBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Thông báo phản hồi bảo mật -->
                    <Border Background="#2B1515" BorderBrush="#DC2626" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,14"
                            Visibility="{Binding SecurityMessage, Converter={x:Static local_cv:StringToVisibilityConverter.Instance}}">
                        <TextBlock Text="{Binding SecurityMessage}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{Binding IsSecuritySuccess, Converter={x:Static local_cv:BooleanToBrushConverter.Instance}}"/>
                    </Border>

                    <!-- KHU VỰC KÍCH HOẠT (Nếu chưa bật) -->
                    <StackPanel Visibility="{Binding IsProtectionEnabled, Converter={x:Static local_cv:InvertedBooleanToVisibilityConverter.Instance}}">
                        <TextBlock Text="KÍCH HOẠT KHÓA BẢO VỆ CẤP 2" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Thiết lập Mật khẩu mới:*" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <PasswordBox Height="36" helpers:PasswordBoxHelper.BindPassword="True"
                                             helpers:PasswordBoxHelper.BoundPassword="{Binding EnablePassword, Mode=TwoWay}"
                                             Style="{StaticResource ModernPasswordBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Xác nhận lại Mật khẩu mới:*" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <PasswordBox Height="36" helpers:PasswordBoxHelper.BindPassword="True"
                                             helpers:PasswordBoxHelper.BoundPassword="{Binding EnableConfirmPassword, Mode=TwoWay}"
                                             Style="{StaticResource ModernPasswordBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <Button Content="🛡️ Kích Hoạt Khóa Bảo Mật Cấp 2" Height="38" Width="260" HorizontalAlignment="Left"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding EnableProtectionCommand}"/>
                    </StackPanel>

                    <!-- KHU VỰC QUẢN LÝ (Khi đã bật: Đổi mật khẩu & Tắt khóa) -->
                    <Grid Visibility="{Binding IsProtectionEnabled, Converter={x:Static local_cv:BooleanToVisibilityConverter.Instance}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Đổi mật khẩu -->
                        <Border Grid.Column="0" Background="#142016" BorderBrush="#625C34" BorderThickness="1" CornerRadius="6" Padding="14">
                            <StackPanel>
                                <TextBlock Text="🔑 ĐỔI MẬT KHẨU CẤP 2" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource AccentLightBrush}" Margin="0,0,0,10"/>

                                <TextBlock Text="Mật khẩu hiện tại:*" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <PasswordBox Height="34" helpers:PasswordBoxHelper.BindPassword="True"
                                             helpers:PasswordBoxHelper.BoundPassword="{Binding ChangeOldPassword, Mode=TwoWay}"
                                             Style="{StaticResource ModernPasswordBoxStyle}" Margin="0,0,0,10"/>

                                <TextBlock Text="Mật khẩu mới:*" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <PasswordBox Height="34" helpers:PasswordBoxHelper.BindPassword="True"
                                             helpers:PasswordBoxHelper.BoundPassword="{Binding ChangeNewPassword, Mode=TwoWay}"
                                             Style="{StaticResource ModernPasswordBoxStyle}" Margin="0,0,0,10"/>

                                <TextBlock Text="Xác nhận mật khẩu mới:*" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <PasswordBox Height="34" helpers:PasswordBoxHelper.BindPassword="True"
                                             helpers:PasswordBoxHelper.BoundPassword="{Binding ChangeConfirmPassword, Mode=TwoWay}"
                                             Style="{StaticResource ModernPasswordBoxStyle}" Margin="0,0,0,14"/>

                                <Button Content="💾 Lưu Mật Khẩu Mới" Height="36" Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding ChangePasswordCommand}"/>
                            </StackPanel>
                        </Border>

                        <!-- Tắt bảo mật -->
                        <Border Grid.Column="2" Background="#2B1515" BorderBrush="#8F1515" BorderThickness="1" CornerRadius="6" Padding="14">
                            <StackPanel>
                                <TextBlock Text="⚠️ TẮT BẢO MẬT CẤP 2" FontSize="12.5" FontWeight="Bold" Foreground="#F87171" Margin="0,0,0,6"/>
                                <TextBlock Text="Hệ thống sẽ cho phép mọi người dùng thêm/sửa/xóa mà không cần mật khẩu bảo vệ." 
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                <TextBlock Text="Mật khẩu hiện tại để xác thực:*" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <PasswordBox Height="34" helpers:PasswordBoxHelper.BindPassword="True"
                                             helpers:PasswordBoxHelper.BoundPassword="{Binding DisablePassword, Mode=TwoWay}"
                                             Style="{StaticResource ModernPasswordBoxStyle}" Margin="0,0,0,14"/>

                                <Button Content="⚪ Tắt Bảo Mật Cấp 2" Height="36" Background="#B32020" Foreground="White" BorderBrush="#F87171" BorderThickness="1"
                                        FontWeight="Bold" Cursor="Hand"
                                        Command="{Binding DisableProtectionCommand}">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==================== 2. CẤU HÌNH DỊCH VỤ EMAIL XÁC THỰC (SMTP) ==================== -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="22" Margin="0,0,0,22">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="📧" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="CẤU HÌNH DỊCH VỤ GỬI EMAIL XÁC THỰC (SMTP)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentLightBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <CheckBox Content="Bật chế độ thử nghiệm (Mã OTP hiển thị thông báo trực tiếp mà không cần gửi qua Internet)" 
                              IsChecked="{Binding IsTestMode}" FontWeight="SemiBold" Foreground="#4ADE80" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Máy chủ SMTP (VD: smtp.gmail.com):" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SmtpServer, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="36"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Cổng kết nối (Port):" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SmtpPort, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="36"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tên người gửi hiển thị:" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SenderName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="36"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Email người gửi:" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SenderEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="36"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tài khoản SMTP (Username/Email):" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SmtpUsername, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="36"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Mật khẩu ứng dụng (App Password):" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SmtpPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="36"/>
                        </StackPanel>
                    </Grid>

                    <CheckBox Content="Kích hoạt mã hóa bảo mật SSL/TLS" IsChecked="{Binding EnableSsl}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="🔍 Kiểm Tra SMTP" Style="{StaticResource SecondaryButtonStyle}" Height="36" Padding="14,0" Margin="0,0,10,0"
                                Command="{Binding TestSmtpCommand}"/>
                        <Button Content="💾 Lưu Cấu Hình SMTP" Style="{StaticResource PrimaryButtonStyle}" Height="36" Padding="16,0"
                                Command="{Binding SaveSettingsCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ==================== 3. CẤU HÌNH DỊCH VỤ TIN NHẮN SMS GATEWAY ==================== -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="22" Margin="0,0,0,24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="📱" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="CẤU HÌNH DỊCH VỤ GỬI TIN NHẮN SMS GATEWAY" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentLightBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Gửi mã xác thực OTP qua SMS và phát thông báo khẩn cấp khi hệ thống ghi nhận sửa đổi dữ liệu quan trọng hoặc mở khóa cấp 2" 
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <CheckBox Content="Kích hoạt dịch vụ gửi SMS Gateway" IsChecked="{Binding IsSmsEnabled}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,24,0"/>
                        <CheckBox Content="Chế độ thử nghiệm SMS (Không tốn cước phí thực tế)" IsChecked="{Binding IsSmsTestMode}" Foreground="#4ADE80"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Cổng kết nối SMS / Nhà cung cấp:" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailableSmsProviders}" SelectedItem="{Binding SmsProvider}" Height="36"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Định danh người gửi (Brandname / Sender ID):" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SmsSenderId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="36"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Mã xác thực API Key / Token kết nối:" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SmsApiKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="36"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Số điện thoại Quản trị viên nhận tin cảnh báo:" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SmsAdminPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="36"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="📲 Gửi Thử Tin Nhắn SMS" Style="{StaticResource SecondaryButtonStyle}" Height="36" Padding="14,0" Margin="0,0,10,0"
                                Command="{Binding TestSmsCommand}"/>
                        <Button Content="💾 Lưu Cấu Hình Toàn Bộ" Style="{StaticResource PrimaryButtonStyle}" Height="36" Padding="16,0"
                                Command="{Binding SaveSettingsCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
