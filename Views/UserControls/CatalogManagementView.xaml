<UserControl x:Class="QL_HocVien.Views.UserControls.CatalogManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local_cv="clr-namespace:QL_HocVien.Converters"
             xmlns:vm="clr-namespace:QL_HocVien.ViewModels"
             xmlns:components="clr-namespace:QL_HocVien.Views.Components"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100">
    <UserControl.Resources>
        <local_cv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local_cv:IntEqualsToVisibilityConverter x:Key="IntEqualsToVis"/>

        <Style x:Key="TabHeaderStyle" TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Foreground" Value="{DynamicResource TabHeaderForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,3" Margin="0,0,8,0" Padding="{TemplateBinding Padding}" Cursor="Hand">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource TabHeaderActiveBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TabHeaderActiveForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource TabHeaderBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Template Style cho TreeViewItem cơ cấu rễ sơ đồ tổ chức -->
        <Style x:Key="OrgTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid Margin="0,1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Thẻ đơn vị (Card Node) -->
                            <Border x:Name="Bd" Grid.Row="0" Background="{TemplateBinding Background}" Padding="0">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Stretch"/>
                            </Border>

                            <!-- Nhánh rễ cây con (Children Host with Branch Root Lines) -->
                            <Grid Grid.Row="1" x:Name="ItemsHostGrid" Visibility="Collapsed" Margin="28,2,0,4">
                                <!-- Đường rễ cây kết nối thẳng đứng (Vertical Branch Root Line) -->
                                <Border Width="2.5" HorizontalAlignment="Left" Margin="-14,0,0,0" 
                                        Background="{DynamicResource AccentBrush}" Opacity="0.35"/>
                                <ItemsPresenter/>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHostGrid" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- HierarchicalDataTemplate cho UnitTreeNode -->
        <HierarchicalDataTemplate x:Key="UnitTreeNodeTemplate" DataType="{x:Type vm:UnitTreeNode}" ItemsSource="{Binding Children}">
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1.5" CornerRadius="8" Padding="12,10" Margin="0,2,8,2"
                    Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" 
                                  Command="{Binding DataContext.SelectTreeNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Background" Value="{DynamicResource TabHeaderActiveBackgroundBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Cột 0: Nút [+] / [-] mở rộng hoặc dấu chấm tròn -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Cột 1: Icon Huy hiệu quân sự theo cấp -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Cột 2: Thông tin tên, cấp bậc, chỉ huy, liên hệ, sĩ số -->
                        <ColumnDefinition Width="*"/>
                        <!-- Cột 3: Nút thao tác nhanh (Thêm cấp con, Sửa, Xóa) -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cánh tay rễ cây nối ngang từ đường thẳng đứng vào thẻ card (Horizontal Connector Arm) -->
                    <Border Height="2" Width="14" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-26,0,0,0"
                            Background="{DynamicResource AccentBrush}" Opacity="0.35"/>

                    <!-- Nút bấm [+] mở rộng / [-] thu gọn (Rễ sơ đồ bộ máy) -->
                    <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                        <!-- Nút khi có đơn vị con -->
                        <Button Command="{Binding ToggleExpandCommand}"
                                Width="30" Height="30" Cursor="Hand"
                                ToolTip="Bấm dấu cộng (+) để mở rộng hoặc dấu trừ (-) để thu gọn rễ sơ đồ"
                                Visibility="{Binding HasChildren, Converter={x:Static local_cv:BooleanToVisibilityConverter.Instance}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" CornerRadius="15" 
                                            Background="{DynamicResource PageBackgroundBrush}" 
                                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="−"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                <Setter Property="Text" Value="＋"/>
                                                <Setter Property="Foreground" Value="#E5A93C"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>

                        <!-- Dấu chấm chốt tròn khi là đơn vị cơ sở không có cấp con -->
                        <Border Width="30" Height="30"
                                Visibility="{Binding HasChildren, Converter={x:Static local_cv:InvertedBooleanToVisibilityConverter.Instance}}">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Opacity="0.4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- Cột 1: Icon Huy hiệu theo phân cấp (🏛️ Trung đoàn, 🛡️ Tiểu đoàn, 🚩 Đại đội, 🎓 Lớp) -->
                    <Border Grid.Column="1" Width="44" Height="44" CornerRadius="8" 
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.2"
                            VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="{Binding Icon}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Cột 2: Thông tin chi tiết đơn vị -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <!-- Hàng 1: Tên đơn vị, Mã định danh, Cấp bậc nhãn, Số lượng đơn vị trực thuộc -->
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            
                            <!-- Badge Mã đơn vị -->
                            <Border Background="{DynamicResource PageBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Code, StringFormat='{}Mã: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>

                            <!-- Badge Cấp bậc phân cấp bộ máy -->
                            <Border Background="{DynamicResource PrimaryButtonBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding LevelName}" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Border>

                            <!-- Badge Số lượng cấp con -->
                            <Border Background="{DynamicResource PageBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center"
                                    Visibility="{Binding HasChildren, Converter={x:Static local_cv:BooleanToVisibilityConverter.Instance}}">
                                <TextBlock Text="{Binding ChildCountText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                        </WrapPanel>

                        <!-- Hàng 2: Chỉ huy trưởng, Số điện thoại liên hệ, Mô tả chức trách -->
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Commander, StringFormat='{}👤 Chỉ huy: {0}'}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,14,0"/>
                            <TextBlock Text="{Binding Phone, StringFormat='{}📞 SĐT: {0}'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,14,0"/>
                            <TextBlock Text="{Binding Description, StringFormat='{}• {0}'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" MaxWidth="450" TextTrimming="CharacterEllipsis"/>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Cột 3: Nút thao tác nhanh trực tiếp trên Card -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <!-- Nút Thêm đơn vị con (+) -->
                        <Button Content="➕ Cấp con" Style="{StaticResource SecondaryButtonStyle}" Height="28" Padding="8,2" Margin="0,0,6,0" FontSize="11"
                                ToolTip="Thêm đơn vị con trực thuộc đơn vị này"
                                Visibility="{Binding CanAddChild, Converter={x:Static local_cv:BooleanToVisibilityConverter.Instance}}"
                                Command="{Binding DataContext.AddChildUnitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>

                        <!-- Nút Sửa -->
                        <Button Content="✏️ Sửa" Style="{StaticResource SecondaryButtonStyle}" Height="28" Padding="8,2" Margin="0,0,6,0" FontSize="11"
                                ToolTip="Chỉnh sửa thông tin đơn vị này"
                                Visibility="{Binding CanEdit, Converter={x:Static local_cv:BooleanToVisibilityConverter.Instance}}"
                                Command="{Binding DataContext.EditUnitNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>

                        <!-- Nút Xóa -->
                        <Button Content="🗑️ Xóa" Style="{StaticResource DangerButtonStyle}" Height="28" Padding="8,2" FontSize="11"
                                ToolTip="Xóa đơn vị này khỏi cơ cấu"
                                Visibility="{Binding CanDelete, Converter={x:Static local_cv:BooleanToVisibilityConverter.Instance}}"
                                Command="{Binding DataContext.DeleteUnitNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Border Padding="24">
        <Grid>
            <!-- Giao diện chính -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. Tiêu đề trang (Page Header) -->
                <StackPanel Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock Text="DANH MỤC TỔ CHỨC QUÂN SỰ" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="Quản lý tập trung 4 danh mục: Cấp bậc quân hàm, Chức vụ quân sự, Đơn vị quản lý và Chuyên ngành đào tạo" 
                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- 2. Thanh công cụ thao tác (Page Toolbar) -->
                <WrapPanel Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,12">
                    <Button Content="📥 Nhập Excel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
                            Command="{Binding ImportExcelCommand}"/>
                    <Button Content="📤 Xuất Excel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
                            Command="{Binding ExportExcelCommand}"/>
                    <Button Content="➕ Thêm Mới" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8"
                            Command="{Binding OpenAddModalCommand}"/>
                    <Button Content="✏️ Sửa" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
                            Command="{Binding OpenEditModalCommand}"/>
                    <Button Content="🗑️ Xóa" Style="{StaticResource DangerButtonStyle}" Margin="0,0,8,8"
                            Command="{Binding DeleteCommand}"/>
                    <Button Content="🔄 Làm Mới" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,8"
                            Command="{Binding LoadAllDataCommand}"/>
                </WrapPanel>

                <!-- 3. Thanh tìm kiếm và bộ lọc nâng cao -->
                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernTextBoxStyle}" Height="36"
                                     Tag="Tìm kiếm theo mã, tên, phân loại, mô tả trong danh mục hiện tại..."/>

                            <Button Grid.Column="2" Content="🔍 Tìm Kiếm" Height="36" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding SearchCommand}"/>

                            <Button Grid.Column="4" Content="⚙️ Lọc Nâng Cao" Height="36" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ToggleAdvancedFilterCommand}"/>

                            <Button Grid.Column="6" Content="✕ Xóa Lọc" Height="36" Style="{StaticResource DangerButtonStyle}"
                                    Command="{Binding ResetFiltersCommand}"/>
                        </Grid>

                        <!-- Khung mở rộng: Bộ Lọc Nâng Cao Đa Tiêu Chí cho Danh mục Tổ chức -->
                        <Border Visibility="{Binding IsAdvancedFilterVisible, Converter={x:Static local_cv:BooleanToVisibilityConverter.Instance}}"
                                Background="{DynamicResource PageBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="🎯 BỘ LỌC NÂNG CAO THEO NHÓM CẤP BẬC, CHỨC VỤ, ĐƠN VỊ CẤP TRÊN &amp; KHOA PHỤ TRÁCH" 
                                           FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Lọc Nhóm Cấp bậc (Sheet 1) -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Nhóm quân hàm (Cấp bậc):" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                        <ComboBox ItemsSource="{Binding RankGroups}" SelectedItem="{Binding SelectedRankGroup}" 
                                                  Style="{StaticResource ModernComboBoxStyle}" Height="34"/>
                                    </StackPanel>

                                    <!-- Lọc Nhóm Chức vụ (Sheet 2) -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Nhóm chức vụ (Chức vụ):" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                        <ComboBox ItemsSource="{Binding PositionGroups}" SelectedItem="{Binding SelectedPositionGroup}" 
                                                  Style="{StaticResource ModernComboBoxStyle}" Height="34"/>
                                    </StackPanel>

                                    <!-- Lọc Đơn vị cấp trên (Sheet 3) -->
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Đơn vị cấp trên (Đơn vị):" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                        <components:UnitTreeComboBox SelectedUnit="{Binding SelectedParentUnitFilter, Mode=TwoWay}" IsFilterMode="True" Height="34" Placeholder="[ Tất cả đơn vị ]"/>
                                    </StackPanel>

                                    <!-- Lọc Khoa phụ trách (Sheet 4) -->
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="Khoa phụ trách (Chuyên ngành):" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                        <ComboBox ItemsSource="{Binding DepartmentFilters}" SelectedItem="{Binding SelectedDepartmentFilter}" 
                                                  Style="{StaticResource ModernComboBoxStyle}" Height="34"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 4. TabControl Multi-Sheet quản lý 4 danh mục -->
                <TabControl Grid.Row="3" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0">

                    <!-- TAB 1: CẤP BẬC QUÂN HÀM -->
                    <TabItem Header="🎖️ Cấp Bậc Quân Hàm" Style="{StaticResource TabHeaderStyle}">
                        <Border Style="{StaticResource CardBorderStyle}" Padding="0" Margin="0,8,0,0">
                            <DataGrid ItemsSource="{Binding Ranks}" SelectedItem="{Binding SelectedRank}"
                                      Style="{StaticResource MilitaryDataGridStyle}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                      RowHeaderWidth="0"
                                      BorderThickness="0" RowHeight="42" SelectionMode="Single"
                                      AlternationCount="2"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.CanContentScroll="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã Cấp Bậc" Binding="{Binding RankCode}" Width="120" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="Tên Cấp Bậc Quân Hàm" Binding="{Binding RankName}" Width="220"/>
                                    <DataGridTextColumn Header="Nhóm Cấp Bậc" Binding="{Binding RankGroup}" Width="200"/>
                                    <DataGridTemplateColumn Header="Thứ Tự Hiển Thị" Width="130" HeaderStyle="{StaticResource CenterDataGridHeaderStyle}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource PageBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8,3" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayOrder, StringFormat='{}Bậc {0}'}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" FontSize="12"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Mô Tả / Ghi Chú" Binding="{Binding Description}" MinWidth="160" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </TabItem>

                    <!-- TAB 2: CHỨC VỤ QUÂN SỰ -->
                    <TabItem Header="🛡️ Chức Vụ Quân Sự" Style="{StaticResource TabHeaderStyle}">
                        <Border Style="{StaticResource CardBorderStyle}" Padding="0" Margin="0,8,0,0">
                            <DataGrid ItemsSource="{Binding Positions}" SelectedItem="{Binding SelectedPosition}"
                                      Style="{StaticResource MilitaryDataGridStyle}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                      RowHeaderWidth="0"
                                      BorderThickness="0" RowHeight="42" SelectionMode="Single"
                                      AlternationCount="2"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.CanContentScroll="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã Chức Vụ" Binding="{Binding PositionCode}" Width="120" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="Tên Chức Vụ Quân Sự" Binding="{Binding PositionName}" Width="240"/>
                                    <DataGridTextColumn Header="Nhóm Chức Vụ" Binding="{Binding PositionGroup}" Width="200"/>
                                    <DataGridTemplateColumn Header="Thứ Tự Quản Lý" Width="130" HeaderStyle="{StaticResource CenterDataGridHeaderStyle}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource PageBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8,3" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayOrder, StringFormat='{}Mức {0}'}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Nhiệm Vụ / Mô Tả" Binding="{Binding Description}" MinWidth="160" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </TabItem>

                    <!-- TAB 3: CƠ CẤU ĐƠN VỊ & ĐẠI ĐỘI (SƠ ĐỒ RỄ CÂY BỘ MÁY NHÀ NƯỚC / QUÂN ĐỘI) -->
                    <TabItem Header="🚩 Cơ Cấu Đơn Vị &amp; Đại Đội" Style="{StaticResource TabHeaderStyle}">
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <!-- Thanh công cụ điều khiển sơ đồ rễ cây -->
                                <RowDefinition Height="Auto"/>
                                <!-- Vùng hiển thị sơ đồ cây hoặc bảng dữ liệu -->
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Thanh công cụ điều khiển sơ đồ rễ cây -->
                            <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Tiêu đề & Chú giải sơ đồ -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="🌳 SƠ ĐỒ CƠ CẤU BỘ MÁY TỔ CHỨC ĐƠN VỊ &amp; ĐẠI ĐỘI" 
                                                   FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="Mô hình rễ cây phân cấp quân sự: Trung đoàn ➔ Tiểu đoàn ➔ Đại đội ➔ Lớp đào tạo. Bấm dấu cộng [+] để mở rộng hoặc dấu trừ [−] để thu gọn." 
                                                   FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Các nút mở rộng, thu gọn, chuyển chế độ xem -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="➕ Mở Rộng Tất Cả" Style="{StaticResource SecondaryButtonStyle}" Height="32" Padding="12,0" Margin="0,0,8,0"
                                                ToolTip="Bung mở toàn bộ các nhánh rễ cây bộ máy tổ chức"
                                                Command="{Binding ExpandAllTreeCommand}"/>

                                        <Button Content="➖ Thu Gọn Tất Cả" Style="{StaticResource SecondaryButtonStyle}" Height="32" Padding="12,0" Margin="0,0,12,0"
                                                ToolTip="Thu gọn sơ đồ về các cấp chỉ huy cao nhất"
                                                Command="{Binding CollapseAllTreeCommand}"/>

                                        <!-- Nút chuyển chế độ xem Sơ đồ cây / Bảng dòng -->
                                        <Border Background="{DynamicResource PageBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="3">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="🌳 Sơ Đồ Cây" Height="28" Padding="10,0" FontSize="11.5"
                                                        Command="{Binding ToggleViewModeCommand}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsTreeViewMode}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="📋 Dạng Bảng Dòng" Height="28" Padding="10,0" FontSize="11.5"
                                                        Command="{Binding ToggleViewModeCommand}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsTreeViewMode}" Value="False">
                                                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- CHẾ ĐỘ 1: SƠ ĐỒ RỄ CÂY PHÂN CẤP BỘ MÁY (Mặc định) -->
                            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16,12"
                                    Visibility="{Binding IsTreeViewMode, Converter={x:Static local_cv:BooleanToVisibilityConverter.Instance}}">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <TreeView ItemsSource="{Binding UnitTreeNodes}"
                                              ItemContainerStyle="{StaticResource OrgTreeItemStyle}"
                                              ItemTemplate="{StaticResource UnitTreeNodeTemplate}"
                                              Background="Transparent" BorderThickness="0"/>
                                </ScrollViewer>
                            </Border>

                            <!-- CHẾ ĐỘ 2: DẠNG BẢNG DÒNG DATAGRID TRUYỀN THỐNG -->
                            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="0"
                                    Visibility="{Binding IsTreeViewMode, Converter={x:Static local_cv:InvertedBooleanToVisibilityConverter.Instance}}">
                                <DataGrid ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit}"
                                          Style="{StaticResource MilitaryDataGridStyle}"
                                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                          RowHeaderWidth="0"
                                          BorderThickness="0" RowHeight="42" SelectionMode="Single"
                                          AlternationCount="2"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.CanContentScroll="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Mã Đơn Vị" Binding="{Binding UnitCode}" Width="120" FontWeight="SemiBold"/>
                                        <DataGridTextColumn Header="Tên Đơn Vị" Binding="{Binding UnitName}" Width="220"/>
                                        <DataGridTextColumn Header="Đơn Vị Cấp Trên" Binding="{Binding ParentUnit}" Width="180"/>
                                        <DataGridTextColumn Header="Chỉ Huy Trưởng" Binding="{Binding CommanderName}" Width="180"/>
                                        <DataGridTextColumn Header="Điện Thoại Liên Hệ" Binding="{Binding ContactPhone}" Width="150"/>
                                        <DataGridTextColumn Header="Mô Tả / Địa Bàn" Binding="{Binding Description}" MinWidth="160" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- TAB 4: CHUYÊN NGÀNH ĐÀO TẠO -->
                    <TabItem Header="🎯 Chuyên Ngành Đào Tạo" Style="{StaticResource TabHeaderStyle}">
                        <Border Style="{StaticResource CardBorderStyle}" Padding="0" Margin="0,8,0,0">
                            <DataGrid ItemsSource="{Binding Majors}" SelectedItem="{Binding SelectedMajor}"
                                      Style="{StaticResource MilitaryDataGridStyle}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                      RowHeaderWidth="0"
                                      BorderThickness="0" RowHeight="42" SelectionMode="Single"
                                      AlternationCount="2"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.CanContentScroll="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã Ngành" Binding="{Binding MajorCode}" Width="120" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="Tên Chuyên Ngành" Binding="{Binding MajorName}" Width="240"/>
                                    <DataGridTemplateColumn Header="Thời Gian Đào Tạo" Width="150" HeaderStyle="{StaticResource CenterDataGridHeaderStyle}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource PageBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8,3" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding TrainingDuration}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" FontSize="12"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Khoa / Viện Phụ Trách" Binding="{Binding Department}" Width="200"/>
                                    <DataGridTextColumn Header="Mục Tiêu Đào Tạo" Binding="{Binding Description}" MinWidth="160" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- 4. MODAL DIALOG THÊM / SỬA DANH MỤC -->
            <Grid Background="#80000000" Visibility="{Binding IsFormVisible, Converter={StaticResource BoolToVis}}">
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="28" Effect="{DynamicResource CardShadow}">
                    <StackPanel>
                        <!-- Tiêu đề Form -->
                        <TextBlock Text="{Binding FormTitle}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                        <!-- Mã & Tên -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Mã định danh (*):" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormCode, UpdateSourceTrigger=PropertyChanged}" 
                                         IsEnabled="{Binding IsEditing, Converter={x:Static local_cv:InvertedBooleanToVisibilityConverter.Instance}}"
                                         Style="{StaticResource ModernTextBoxStyle}" Height="36"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Tên gọi (*):" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBoxStyle}" Height="36"/>
                            </StackPanel>
                        </Grid>

                        <!-- Fields cho Cấp Bậc (Tab 0) -->
                        <Grid Margin="0,0,0,12" Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsToVis}, ConverterParameter=0}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Nhóm cấp bậc:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormGroup, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBoxStyle}" Height="36"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Thứ tự hiển thị:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormDisplayOrder, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBoxStyle}" Height="36"/>
                            </StackPanel>
                        </Grid>

                        <!-- Fields cho Chức Vụ (Tab 1) -->
                        <Grid Margin="0,0,0,12" Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsToVis}, ConverterParameter=1}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Nhóm chức vụ:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormGroup, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBoxStyle}" Height="36"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Thứ tự hiển thị:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormDisplayOrder, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBoxStyle}" Height="36"/>
                            </StackPanel>
                        </Grid>

                        <!-- Fields cho Đơn Vị (Tab 2) -->
                        <StackPanel Margin="0,0,0,12" Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsToVis}, ConverterParameter=2}">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Đơn vị cấp trên:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                    <components:UnitTreeComboBox SelectedUnit="{Binding FormParentUnit, Mode=TwoWay}" Height="36" Placeholder="Chọn đơn vị cấp trên (Học viện, Tiểu đoàn 1...)..."/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Chỉ huy trưởng:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding FormCommanderName, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource ModernTextBoxStyle}" Height="36"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel>
                                <TextBlock Text="Số điện thoại liên hệ:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormContactPhone, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBoxStyle}" Height="36"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Fields cho Chuyên Ngành (Tab 3) -->
                        <Grid Margin="0,0,0,12" Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsToVis}, ConverterParameter=3}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Thời gian đào tạo:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormTrainingDuration, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBoxStyle}" Height="36"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Khoa / Viện phụ trách:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormDepartment, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBoxStyle}" Height="36"/>
                            </StackPanel>
                        </Grid>

                        <!-- Ghi Chú / Mô Tả (Chung) -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Ghi chú / Mô tả chi tiết:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernTextBoxStyle}" Height="64" AcceptsReturn="True" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Hủy Bỏ" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"
                                    Command="{Binding CloseFormCommand}"/>
                            <Button Content="💾 Lưu Dữ Liệu" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding SaveFormCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
