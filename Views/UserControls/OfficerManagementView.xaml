<UserControl x:Class="QL_HocVien.Views.UserControls.OfficerManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local_cv="clr-namespace:QL_HocVien.Converters"
             xmlns:components="clr-namespace:QL_HocVien.Views.Components"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100">
    <UserControl.Resources>
        <local_cv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border Padding="24">
        <Grid>
            <!-- 1. GIAO DIỆN CHÍNH -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. Tiêu đề trang (Page Header) -->
                <StackPanel Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock Text="QUẢN LÝ CÁN BỘ QUÂN SỰ" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="Hồ sơ cán bộ chỉ huy, quản trị lớp học, phân cấp quân hàm, chức vụ, đơn vị và phân quyền" 
                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- 2. Thanh công cụ thao tác (Page Toolbar) -->
                <WrapPanel Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,12">
                    <Button Content="{Binding SelectAllButtonText}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
                            Command="{Binding ToggleSelectAllCommand}" ToolTip="Chọn hoặc bỏ chọn tất cả cán bộ"/>
                    <Button Content="📥 Nhập Excel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
                            Command="{Binding ImportExcelCommand}"/>
                    <Button Content="📤 Xuất Excel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
                            Command="{Binding ExportExcelCommand}"/>
                    <Button Content="🔑 Đặt Lại Mật Khẩu" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
                            Command="{Binding OpenResetPasswordDialogCommand}"/>
                    <Button Content="➕ Thêm Cán Bộ" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8"
                            Command="{Binding OpenAddFormCommand}"/>
                    <Button Content="✏️ Sửa" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
                            Command="{Binding OpenEditFormCommand}"/>
                    <Button Content="🗑️ Xóa" Style="{StaticResource DangerButtonStyle}" Margin="0,0,8,8"
                            Command="{Binding DeleteOfficerCommand}"/>
                    <Button Content="🔄 Làm Mới" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,8"
                            Command="{Binding LoadDataCommand}"/>
                </WrapPanel>

                <!-- 3. Bộ Lọc Nâng Cao Đa Tiêu Chí -->
                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="14">
                    <StackPanel>
                        <!-- Hàng lọc cơ bản -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" MinWidth="160"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1.1*" MinWidth="100"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1.1*" MinWidth="100"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1.1*" MinWidth="100"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Tìm kiếm từ khóa -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tìm kiếm theo mã, tên, SĐT, Email:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBoxStyle}" Height="36"/>
                            </StackPanel>

                            <!-- Lọc Cấp bậc -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Cấp bậc quân hàm:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding FilterRanks}" SelectedItem="{Binding SelectedFilterRank}" 
                                          Style="{StaticResource ModernComboBoxStyle}" Height="36"/>
                            </StackPanel>

                            <!-- Lọc Chức vụ -->
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Chức vụ quân sự:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding FilterPositions}" SelectedItem="{Binding SelectedFilterPosition}" 
                                          Style="{StaticResource ModernComboBoxStyle}" Height="36"/>
                            </StackPanel>

                            <!-- Lọc Đơn vị -->
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="Đơn vị trực thuộc:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <components:UnitTreeComboBox SelectedUnit="{Binding SelectedFilterUnit, Mode=TwoWay}" IsFilterMode="True" Height="36" Placeholder="[ Tất cả đơn vị ]"/>
                            </StackPanel>

                            <!-- Nút Lọc Nâng Cao -->
                            <Button Grid.Column="8" Content="⚙️ Lọc Nâng Cao" VerticalAlignment="Bottom" Height="36" 
                                    Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ToggleAdvancedFilterCommand}"/>

                            <!-- Nút Xóa Lọc -->
                            <Button Grid.Column="10" Content="✕ Xóa Lọc" VerticalAlignment="Bottom" Height="36" 
                                    Style="{StaticResource DangerButtonStyle}" Command="{Binding ResetFiltersCommand}"/>
                        </Grid>

                        <!-- Khung mở rộng: Lọc Nâng Cao Cán Bộ -->
                        <Border Visibility="{Binding IsAdvancedFilterVisible, Converter={x:Static local_cv:BooleanToVisibilityConverter.Instance}}"
                                Background="{DynamicResource PageBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="🎯 BỘ LỌC NÂNG CAO CÁN BỘ (Chuyên môn / Nhiệm vụ, Tài khoản &amp; Phụ trách lớp học)" 
                                           FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="1.5*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Lọc Chuyên môn -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Chuyên môn / Lĩnh vực huấn luyện phụ trách:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding FilterSpecialty, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource ModernTextBoxStyle}" Height="34" Tag="Ví dụ: Chỉ huy, Huấn luyện, Bắn súng..."/>
                                    </StackPanel>

                                    <!-- Lọc Tài khoản -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Trạng thái tài khoản đăng nhập:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                        <ComboBox ItemsSource="{Binding HasAccountList}" SelectedItem="{Binding SelectedHasAccount}" 
                                                  Style="{StaticResource ModernComboBoxStyle}" Height="34"/>
                                    </StackPanel>

                                    <!-- Lọc Phụ trách lớp -->
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Tình trạng chủ nhiệm lớp học:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                        <ComboBox ItemsSource="{Binding HasAssignedClassesList}" SelectedItem="{Binding SelectedHasAssignedClasses}" 
                                                  Style="{StaticResource ModernComboBoxStyle}" Height="34"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 4. DataGrid Cán Bộ -->
                <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="0">
                    <DataGrid ItemsSource="{Binding Officers}" SelectedItem="{Binding SelectedOfficer}"
                              Style="{StaticResource MilitaryDataGridStyle}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              RowHeaderWidth="0"
                              BorderThickness="0" RowHeight="42" SelectionMode="Single"
                              AlternationCount="2"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="48" CanUserResize="False">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox IsChecked="{Binding DataContext.IsAllSelected, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Mã Cán Bộ" Binding="{Binding OfficerCode}" Width="110" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Họ và Tên" Binding="{Binding FullName}" Width="190" FontWeight="Bold"/>
                            <DataGridTemplateColumn Header="Cấp Bậc" Width="130" HeaderStyle="{StaticResource CenterDataGridHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource PageBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8,3" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Rank}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" FontSize="12"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Chức Vụ" Width="150" HeaderStyle="{StaticResource CenterDataGridHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource PageBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8,3" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Position}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Đơn Vị" Binding="{Binding Unit}" Width="130"/>
                            <DataGridTextColumn Header="Số Điện Thoại" Binding="{Binding PhoneNumber}" Width="120"/>
                            <DataGridTextColumn Header="Email Liên Hệ" Binding="{Binding Email}" Width="180"/>
                            <DataGridTextColumn Header="Chuyên Môn" Binding="{Binding Specialty}" Width="140"/>
                            <DataGridTextColumn Header="Ngày Sinh" Binding="{Binding DateOfBirth, StringFormat='{}{0:dd/MM/yyyy}'}" Width="110"/>
                            <DataGridTextColumn Header="Ngày Nhập Ngũ" Binding="{Binding EnlistmentDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="120"/>
                            <DataGridTemplateColumn Header="Lớp Quản Lý" Width="110" HeaderStyle="{StaticResource CenterDataGridHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource PageBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8,3" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding ManagedClasses.Count, StringFormat='{}{0} lớp'}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" FontSize="12"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Ghi Chú" Binding="{Binding Notes}" MinWidth="160" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- 2. MODAL FORM THÊM / SỬA CÁN BỘ -->
            <Grid Background="#80000000" Visibility="{Binding IsFormVisible, Converter={StaticResource BoolToVis}}">
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Width="680" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="28" Effect="{DynamicResource CardShadow}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="600">
                        <StackPanel>
                            <!-- Tiêu đề Form -->
                            <TextBlock Text="{Binding FormTitle}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                            <!-- Hàng 1: Mã cán bộ & Họ tên -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Mã cán bộ (*):" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding FormOfficerCode, UpdateSourceTrigger=PropertyChanged}" 
                                             IsEnabled="{Binding IsEditing, Converter={x:Static local_cv:InvertedBooleanToVisibilityConverter.Instance}}"
                                             Style="{StaticResource ModernTextBoxStyle}" Height="36"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Họ và tên (*):" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding FormFullName, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource ModernTextBoxStyle}" Height="36"/>
                                </StackPanel>
                            </Grid>

                            <!-- Hàng 2: Cấp bậc & Chức vụ & Đơn vị -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Cấp bậc quân hàm:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding FormRanks}" SelectedItem="{Binding FormRank}" 
                                              Style="{StaticResource ModernComboBoxStyle}" Height="36"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Chức vụ quân sự:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding FormPositions}" SelectedItem="{Binding FormPosition}" 
                                              Style="{StaticResource ModernComboBoxStyle}" Height="36"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Đơn vị trực thuộc:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                    <components:UnitTreeComboBox SelectedUnit="{Binding FormUnit, Mode=TwoWay}" Height="36" Placeholder="Chọn đơn vị trực thuộc..."/>
                                </StackPanel>
                            </Grid>

                            <!-- Hàng 3: SĐT & Email & Chuyên môn -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="1.3*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Số điện thoại:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding FormPhoneNumber, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource ModernTextBoxStyle}" Height="36"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Email liên hệ:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource ModernTextBoxStyle}" Height="36"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Chuyên môn nghiệp vụ:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding FormSpecialty, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource ModernTextBoxStyle}" Height="36"/>
                                </StackPanel>
                            </Grid>

                            <!-- Hàng 4: Ngày sinh & Ngày nhập ngũ -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Ngày sinh:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                    <DatePicker SelectedDate="{Binding FormDateOfBirth}" Height="36" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Ngày nhập ngũ:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                    <DatePicker SelectedDate="{Binding FormEnlistmentDate}" Height="36" VerticalContentAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Hàng 5: Ghi chú -->
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Ghi chú thêm:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormNotes, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBoxStyle}" Height="54" AcceptsReturn="True" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Tùy chọn cấp tài khoản đăng nhập khi Thêm mới -->
                            <Border Background="{DynamicResource PageBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16"
                                    Visibility="{Binding IsEditing, Converter={x:Static local_cv:InvertedBooleanToVisibilityConverter.Instance}}">
                                <StackPanel>
                                    <CheckBox Content="Cấp tài khoản đăng nhập hệ thống cho cán bộ này" 
                                              IsChecked="{Binding FormCreateLoginAccount}" 
                                              FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>

                                    <Grid Visibility="{Binding FormCreateLoginAccount, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Tên tài khoản (Username):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding FormUsername, UpdateSourceTrigger=PropertyChanged}" 
                                                     Style="{StaticResource ModernTextBoxStyle}" Height="32"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Mật khẩu khởi tạo:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding FormPassword, UpdateSourceTrigger=PropertyChanged}" 
                                                     Style="{StaticResource ModernTextBoxStyle}" Height="32"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Action Buttons -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Hủy Bỏ" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"
                                        Command="{Binding CloseFormCommand}"/>
                                <Button Content="💾 Lưu Cán Bộ" Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding SaveFormCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- 3. MODAL ĐẶT LẠI MẬT KHẨU -->
            <Grid Background="#80000000" Visibility="{Binding IsResetPasswordDialogVisible, Converter={StaticResource BoolToVis}}">
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="24" Effect="{DynamicResource CardShadow}">
                    <StackPanel>
                        <TextBlock Text="🔑 Đặt Lại Mật Khẩu Cán Bộ" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                        <TextBlock Text="Cán bộ được chọn:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding ResetOfficerName}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,14"/>

                        <TextBlock Text="Mật khẩu mới (*):" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ResetNewPassword, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource ModernTextBoxStyle}" Height="36" Margin="0,0,0,20"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Hủy Bỏ" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"
                                    Command="{Binding CloseResetPasswordDialogCommand}"/>
                            <Button Content="✅ Xác Nhận Đổi" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding SaveResetPasswordCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
