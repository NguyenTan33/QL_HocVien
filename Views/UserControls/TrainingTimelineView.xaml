<UserControl x:Class="QL_HocVien.Views.UserControls.TrainingTimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:cv="clr-namespace:QL_HocVien.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="920" d:DesignWidth="1380">

    <UserControl.Resources>
        <cv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <cv:InvertedBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
        <cv:StringToBrushConverter x:Key="StringToBrush"/>

        <!-- Nút Trắng Ngà Dã Chiến (✓ Đổi Hoàn Thành, ✏ Sửa) chuẩn Celandar.png -->
        <Style x:Key="ParchmentOutlineButton" TargetType="Button">
            <Setter Property="Background" Value="#EFE7D5"/>
            <Setter Property="BorderBrush" Value="#C5BAA0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1E2518"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E5DCC2"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#AFA083"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D9CDAE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút Đỏ Xóa Dã Chiến (🗑 Xóa) chuẩn Celandar.png -->
        <Style x:Key="ParchmentDangerButton" TargetType="Button">
            <Setter Property="Background" Value="#9E1616"/>
            <Setter Property="BorderBrush" Value="#801010"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#BD2020"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#E53935"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#881212"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút Đỏ Gradient Quân Kỳ Viền Vàng (+ Thêm Sự Kiện Cho Ngày Này, + Thêm Mốc Sự Kiện Mới) -->
        <Style x:Key="ParchmentRedActionButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#9E1616" Offset="0"/>
                        <GradientStop Color="#7C0F0F" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#ECC867"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.30" Color="#000000"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#B71C1C" Offset="0"/>
                                            <GradientStop Color="#8F1212" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFE082"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút Đỏ Header (+ Thêm Mốc Sự Kiện) -->
        <Style x:Key="TopHeaderCrimsonButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#A31818" Offset="0"/>
                        <GradientStop Color="#831212" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#E55353"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#BA2020" Offset="0"/>
                                            <GradientStop Color="#991515" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF7373"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút Tối Header (📅 Xem Cuộn Lịch Tháng, 🔄 Tải Lại Lịch) -->
        <Style x:Key="TopHeaderDarkButton" TargetType="Button">
            <Setter Property="Background" Value="#182619"/>
            <Setter Property="BorderBrush" Value="#756A3C"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Foreground" Value="#E8CE7E"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#233825"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#9E8F52"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút Lọc Tác Chiến Đỏ Viền Vàng -->
        <Style x:Key="FilterCrimsonButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#8A1414" Offset="0"/>
                        <GradientStop Color="#A81A1A" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#DFC57B"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#BA1E1E"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFE082"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút Tất Cả (Reset) Viền Vàng -->
        <Style x:Key="FilterResetButton" TargetType="Button">
            <Setter Property="Background" Value="#1A2619"/>
            <Setter Property="BorderBrush" Value="#6D673B"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Foreground" Value="#E5DFCA"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#253A26"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#998F53"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <!-- 0. Header (Tiêu đề bên trái, 3 nút công cụ bên phải theo mẫu Celandar.png) -->
                <RowDefinition Height="Auto"/>
                <!-- 1. 4 Thẻ thống kê KPI với Icon tròn -->
                <RowDefinition Height="Auto"/>
                <!-- 2. Thanh lọc tác chiến -->
                <RowDefinition Height="Auto"/>
                <!-- 3. Không gian chính 2 cột (Dòng thời gian dã chiến & Sự kiện ngày) -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ========================================================================= -->
            <!-- HÀNG 0: HEADER CHUẨN CELANDAR.PNG (TIÊU ĐỀ TRÁI - 3 NÚT THAO TÁC PHẢI) -->
            <!-- ========================================================================= -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Tiêu đề & phụ đề bên trái -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="LỊCH TRÌNH HUẤN LUYỆN, THI CỬ &amp; SỰ KIỆN QUÂN SỰ" 
                               FontSize="23" FontWeight="ExtraBold" Foreground="{DynamicResource TextPrimaryBrush}" 
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                    </TextBlock>
                    <TextBlock Text="Theo dõi dòng thời gian (Timeline) các mốc kiểm tra thể lực, thi cử học phần, dã ngoại rèn luyện và hội thao" 
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" 
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Cụm 3 nút thao tác góc trên bên phải chuẩn Celandar.png -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Nút 1: Chuyển đổi Cuộn Lịch Tháng / Dòng Thời Gian -->
                    <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Height="36"
                            Command="{Binding SwitchToCalendarViewCommand}"
                            Visibility="{Binding IsCalendarViewVisible, Converter={StaticResource InvBoolToVis}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📅  " FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="Xem Cuộn Lịch Tháng" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Height="36"
                            Command="{Binding SwitchToTimelineViewCommand}"
                            Visibility="{Binding IsCalendarViewVisible, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📜  " FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="Dòng Thời Gian Dọc" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Nút 2: Tải lại lịch -->
                    <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Height="36"
                            Command="{Binding LoadEventsCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔄  " FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="Tải Lại Lịch" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Nút 3: Thêm mốc sự kiện đỏ quân kỳ viền vàng -->
                    <Button Style="{StaticResource PrimaryButtonStyle}" Height="36"
                            Command="{Binding OpenAddFormCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="➕  " FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="Thêm Mốc Sự Kiện" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ========================================================================= -->
            <!-- HÀNG 1: 4 THẺ THỐNG KÊ KPI VỚI ICON TRÒN CHUẨN CELANDAR.PNG -->
            <!-- ========================================================================= -->
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- KPI 1: TỔNG SỐ MỐC SỰ KIỆN (Xanh lục camo viền vàng) -->
                <Border Grid.Column="0" Background="{DynamicResource TimelineKpi1BackgroundBrush}" BorderBrush="{DynamicResource TimelineKpi1BorderBrush}" BorderThickness="1.2" CornerRadius="7" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Icon tròn xanh rêu quân đội -->
                        <Border Grid.Column="0" Width="46" Height="46" CornerRadius="23" Background="{DynamicResource InfoCardBackgroundBrush}" BorderBrush="{DynamicResource InfoCardBorderBrush}" BorderThickness="1.5" VerticalAlignment="Center">
                            <TextBlock Text="📅" FontSize="20" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <!-- Số liệu & Tiêu đề -->
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="TỔNG SỐ MỐC SỰ KIỆN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding TotalEventsCount}" FontSize="30" FontWeight="ExtraBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,1,0,0"/>
                            <TextBlock Text="Lịch trình trong cơ sở dữ liệu" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- KPI 2: ĐANG DIỄN RA (Xanh thủy quân viền lam-vàng) -->
                <Border Grid.Column="2" Background="{DynamicResource TimelineKpi2BackgroundBrush}" BorderBrush="{DynamicResource TimelineKpi2BorderBrush}" BorderThickness="1.2" CornerRadius="7" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Icon tròn lam dã chiến -->
                        <Border Grid.Column="0" Width="46" Height="46" CornerRadius="23" Background="{DynamicResource InfoCardBackgroundBrush}" BorderBrush="{DynamicResource InfoCardBorderBrush}" BorderThickness="1.5" VerticalAlignment="Center">
                            <TextBlock Text="⌛" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <!-- Số liệu & Tiêu đề -->
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ĐANG DIỄN RA" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource InfoCardForegroundBrush}"/>
                            <TextBlock Text="{Binding OngoingEventsCount}" FontSize="30" FontWeight="ExtraBold" Foreground="{DynamicResource InfoCardForegroundBrush}" Margin="0,1,0,0"/>
                            <TextBlock Text="Sự kiện đang trong tiến trình" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- KPI 3: KHẨN CẤP / TRỌNG ĐIỂM (Đỏ đun viền huyết dụ-vàng) -->
                <Border Grid.Column="4" Background="{DynamicResource TimelineKpi3BackgroundBrush}" BorderBrush="{DynamicResource TimelineKpi3BorderBrush}" BorderThickness="1.2" CornerRadius="7" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Icon tròn đỏ cảnh báo -->
                        <Border Grid.Column="0" Width="46" Height="46" CornerRadius="23" Background="{DynamicResource DangerCardBackgroundBrush}" BorderBrush="{DynamicResource DangerCardBorderBrush}" BorderThickness="1.5" VerticalAlignment="Center">
                            <TextBlock Text="⚠️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <!-- Số liệu & Tiêu đề -->
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="KHẨN CẤP / TRỌNG ĐIỂM" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource DangerCardForegroundBrush}"/>
                            <TextBlock Text="{Binding UrgentEventsCount}" FontSize="30" FontWeight="ExtraBold" Foreground="{DynamicResource DangerCardForegroundBrush}" Margin="0,1,0,0"/>
                            <TextBlock Text="Ưu tiên cần tập trung chuẩn bị" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- KPI 4: ĐÃ HOÀN THÀNH (Lục bảo viền ngọc) -->
                <Border Grid.Column="6" Background="{DynamicResource TimelineKpi4BackgroundBrush}" BorderBrush="{DynamicResource TimelineKpi4BorderBrush}" BorderThickness="1.2" CornerRadius="7" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Icon tròn xanh hoàn thành -->
                        <Border Grid.Column="0" Width="46" Height="46" CornerRadius="23" Background="{DynamicResource SuccessCardBackgroundBrush}" BorderBrush="{DynamicResource SuccessCardBorderBrush}" BorderThickness="1.5" VerticalAlignment="Center">
                            <TextBlock Text="✔️" FontSize="20" Foreground="{DynamicResource SuccessCardForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <!-- Số liệu & Tiêu đề -->
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ĐÃ HOÀN THÀNH" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessCardForegroundBrush}"/>
                            <TextBlock Text="{Binding CompletedEventsCount}" FontSize="30" FontWeight="ExtraBold" Foreground="{DynamicResource SuccessCardForegroundBrush}" Margin="0,1,0,0"/>
                            <TextBlock Text="Đã thực hiện xong kiểm tra / sự kiện" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================================================================= -->
            <!-- HÀNG 2: THANH LỌC LỊCH TRÌNH CHUẨN CELANDAR.PNG -->
            <!-- ========================================================================= -->
            <Border Grid.Row="2" Background="{DynamicResource TimelineFilterBackgroundBrush}" BorderBrush="{DynamicResource TimelineFilterBorderBrush}" BorderThickness="1.2" CornerRadius="6" Padding="14,10" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Lọc Loại sự kiện -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Phân loại sự kiện huấn luyện:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding SelectedCategory}" 
                                  Height="34" Style="{StaticResource ModernComboBoxStyle}"/>
                    </StackPanel>

                    <!-- Lọc Trạng thái -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Trạng thái thực hiện:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatus}" 
                                  Height="34" Style="{StaticResource ModernComboBoxStyle}"/>
                    </StackPanel>

                    <!-- Nút Lọc Lịch Trình (Đỏ viền vàng với icon phễu) -->
                    <Button Grid.Column="4" Style="{StaticResource PrimaryButtonStyle}" 
                            VerticalAlignment="Bottom" Height="34" Padding="20,0"
                            Command="{Binding LoadEventsCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 1,2 L 13,2 L 8.5,8 L 8.5,13 L 5.5,11.5 L 5.5,8 Z" Fill="#FFFFFF" 
                                  VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Lọc Lịch Trình" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Nút Tất Cả (Reset) -->
                    <Button Grid.Column="6" Content="Tất Cả" Style="{StaticResource SecondaryButtonStyle}" 
                            VerticalAlignment="Bottom" Height="34" Padding="18,0"
                            Command="{Binding ResetFilterCommand}"/>
                </Grid>
            </Border>

            <!-- ========================================================================= -->
            <!-- HÀNG 3: KHÔNG GIAN TÁC CHIẾN 2 CỘT (CHUẨN THIẾT KẾ CELANDAR.PNG) -->
            <!-- ========================================================================= -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <!-- Cột Trái: Dòng Thời Gian Dã Chiến (Hoặc Lịch Tháng) -->
                    <ColumnDefinition Width="*"/>
                    <!-- Cột Phải: Sự Kiện Ngày Đã Chọn & Form Biên Tập (Rộng 415px) -->
                    <ColumnDefinition Width="415"/>
                </Grid.ColumnDefinitions>

                <!-- ================================================================= -->
                <!-- CỘT TRÁI - CHẾ ĐỘ 1: DÒNG THỜI GIAN DÃ CHIẾN (PARCHMENT TIMELINE) -->
                <!-- ================================================================= -->
                <Border Grid.Column="0" Background="{DynamicResource TimelineBackgroundBrush}" BorderBrush="{DynamicResource TimelineBorderBrush}" BorderThickness="1.5" CornerRadius="8" Padding="16,12" Margin="0,0,14,0"
                        Visibility="{Binding IsCalendarViewVisible, Converter={StaticResource InvBoolToVis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Events}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.RowDefinitions>
                                            <!-- Hàng 0: Đường chỉ phân cách mảnh trang trí giữa các sự kiện -->
                                            <RowDefinition Height="Auto"/>
                                            <!-- Hàng 1: Thân sự kiện 3 cột (Ngày, Trục Timeline, Card chi tiết) -->
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Đường phân cách ngang với họa tiết thoi dã chiến trên đầu mốc -->
                                        <Grid Grid.Row="0" Margin="0,0,0,12">
                                            <Path Data="M 0,0 L 4,-3 L 8,0 L 4,3 Z" Fill="#B5A992" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            <Rectangle Height="1" Fill="#D8CEBC" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Thân mốc sự kiện -->
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <!-- Cột 0: Ngày tháng bên trái -->
                                                <ColumnDefinition Width="120"/>
                                                <!-- Cột 1: Trục Timeline dọc và Node tròn xanh lá -->
                                                <ColumnDefinition Width="32"/>
                                                <!-- Cột 2: Thẻ Card Sự Kiện nền ngà có Watermark -->
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 1. Ngày Tháng Bên Trái -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,8,0,0">
                                                <TextBlock Text="{Binding StartDate, StringFormat={}{0:dd/MM/yyyy}}" 
                                                           FontWeight="ExtraBold" FontSize="16.5" Foreground="#0F172A"/>
                                                <TextBlock Text="{Binding DayOfWeekVietnamese}" 
                                                           FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,3,0,0"/>
                                            </StackPanel>

                                            <!-- 2. Trục Timeline Dọc & Node Xanh Lá -->
                                            <Grid Grid.Column="1">
                                                <!-- Đường kẻ trục dọc nối liền xuyên suốt -->
                                                <Rectangle Width="1.5" Fill="#C5BC9F" VerticalAlignment="Stretch" HorizontalAlignment="Center"/>
                                                <!-- Node tròn xanh lá quân nhu căn thẳng hàng với tiêu đề ngày -->
                                                <Ellipse Width="15" Height="15" Fill="#0D7B48" Stroke="#095330" StrokeThickness="1"
                                                         HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,11,0,0"/>
                                                <!-- Nhánh ngang nối từ node sang thẻ -->
                                                <Rectangle Height="1.5" Width="10" Fill="#C5BC9F" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,0,0"/>
                                            </Grid>

                                            <!-- 3. Thẻ Card Sự Kiện Nền Ngà có Watermark Phác Họa Chuẩn Celandar.png -->
                                            <Border Grid.Column="2" 
                                                    Background="{DynamicResource TimelineCardBackgroundBrush}" BorderBrush="{DynamicResource TimelineCardBorderBrush}" BorderThickness="1" CornerRadius="8"
                                                    Padding="14,10" MinHeight="135">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.08" Color="#332B1E"/>
                                                </Border.Effect>
                                                <Grid>
                                                    <!-- Watermark Minh Họa Chìm ở góc phải Card (Lính bắn súng / Tháp canh / Hành quân) -->
                                                    <Image Source="{Binding WatermarkArtPath}" 
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" 
                                                           Stretch="Uniform" MaxHeight="108" Opacity="{DynamicResource TimelineWatermarkOpacity}" 
                                                           Margin="0,0,4,0" IsHitTestVisible="False"/>

                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <!-- Hàng 0: Badges -->
                                                            <RowDefinition Height="Auto"/>
                                                            <!-- Hàng 1: Tiêu đề sự kiện -->
                                                            <RowDefinition Height="Auto"/>
                                                            <!-- Hàng 2: Chi tiết Thời gian & Địa điểm & Ghi chú -->
                                                            <RowDefinition Height="Auto"/>
                                                            <!-- Hàng 3: 3 Nút hành động góc dưới phải -->
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Hàng 0: 4 Badges chuẩn Celandar.png -->
                                                        <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                                                            <!-- Phân loại -->
                                                            <Border CornerRadius="4" Padding="9,3" Background="{Binding CategoryBg, Converter={StaticResource StringToBrush}}" Margin="0,0,6,4">
                                                                <TextBlock Text="{Binding Category}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"/>
                                                            </Border>
                                                            <!-- Đơn vị -->
                                                            <Border CornerRadius="4" Padding="9,3" Background="#363636" Margin="0,0,6,4">
                                                                <TextBlock Text="{Binding TargetUnit}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"/>
                                                            </Border>
                                                            <!-- Mức độ ưu tiên -->
                                                            <Border CornerRadius="4" Padding="9,3" Background="{Binding PriorityBg, Converter={StaticResource StringToBrush}}" Margin="0,0,6,4">
                                                                <TextBlock Text="{Binding Priority}" Foreground="{Binding PriorityFg, Converter={StaticResource StringToBrush}}" FontWeight="Bold" FontSize="11"/>
                                                            </Border>
                                                            <!-- Trạng thái -->
                                                            <Border CornerRadius="4" Padding="9,3" Background="{Binding StatusBg, Converter={StaticResource StringToBrush}}" Margin="0,0,6,4">
                                                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusFg, Converter={StaticResource StringToBrush}}" FontWeight="Bold" FontSize="11"/>
                                                            </Border>
                                                        </WrapPanel>

                                                        <!-- Hàng 1: Tiêu đề sự kiện đen đậm sắc nét -->
                                                        <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="15.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6"/>

                                                        <!-- Hàng 2: Thời gian, Địa điểm, Kế hoạch chi tiết -->
                                                        <StackPanel Grid.Row="2" Margin="0,0,0,6">
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                                <TextBlock Text="🕒 Thời gian: " FontWeight="Bold" FontSize="12" Foreground="#292524"/>
                                                                <TextBlock Text="{Binding StartDate, StringFormat={}{0:dd/MM/yyyy}}" FontSize="12" Foreground="#292524" FontWeight="SemiBold"/>
                                                                <TextBlock Text=" ➔ " FontSize="12" Foreground="#57534E"/>
                                                                <TextBlock Text="{Binding EndDate, StringFormat={}{0:dd/MM/yyyy}}" FontSize="12" Foreground="#292524" FontWeight="SemiBold"/>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                                <TextBlock Text="📍 Địa điểm: " FontWeight="Bold" FontSize="12" Foreground="#292524"/>
                                                                <TextBlock Text="{Binding Location}" FontSize="12" Foreground="#292524"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#57534E" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                                        </StackPanel>

                                                        <!-- Hàng 3: Các nút hành động góc dưới phải chuẩn Celandar.png -->
                                                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                                            <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                                                                    Command="{Binding DataContext.ToggleCompleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="✓ " FontWeight="Bold" Foreground="#1E2518"/>
                                                                    <TextBlock Text="Đổi Hoàn Thành" Foreground="#1E2518"/>
                                                                </StackPanel>
                                                            </Button>

                                                            <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                                                                    Command="{Binding DataContext.OpenEditFormCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="✏ " FontSize="11" Foreground="#1E2518"/>
                                                                    <TextBlock Text="Sửa" Foreground="#1E2518"/>
                                                                </StackPanel>
                                                            </Button>

                                                            <Button Style="{StaticResource DangerButtonStyle}"
                                                                    Command="{Binding DataContext.DeleteEventCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="🗑 " FontSize="11" Foreground="#FFFFFF"/>
                                                                    <TextBlock Text="Xóa" Foreground="#FFFFFF" FontWeight="Bold"/>
                                                                </StackPanel>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- ================================================================= -->
                <!-- CỘT TRÁI - CHẾ ĐỘ 2: CUỐN LỊCH THÁNG (PHONE-STYLE MONTHLY CALENDAR) -->
                <!-- ================================================================= -->
                <Border Grid.Column="0" Background="{DynamicResource TimelineBackgroundBrush}" BorderBrush="{DynamicResource TimelineBorderBrush}" BorderThickness="1.5" CornerRadius="8" Padding="14,12" Margin="0,0,14,0"
                        Visibility="{Binding IsCalendarViewVisible, Converter={StaticResource BoolToVis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- Header điều hướng Tháng / Năm -->
                                <RowDefinition Height="Auto"/>
                                <!-- Tiêu đề 7 thứ trong tuần -->
                                <RowDefinition Height="Auto"/>
                                <!-- Lưới 42 ô ngày (6 tuần x 7 ngày) -->
                                <RowDefinition Height="Auto"/>
                                <!-- Chú thích màu sắc sự kiện -->
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- HÀNG 0: HEADER ĐIỀU HƯỚNG THÁNG / NĂM -->
                            <Border Grid.Row="0" Background="#E5DCBF" BorderBrush="#C5BAA0" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Button Content="◀ Tháng Trước" Style="{StaticResource SecondaryButtonStyle}" 
                                                Margin="0,0,6,0" Command="{Binding PreviousMonthCommand}"/>
                                        <Button Content="Hôm Nay" Style="{StaticResource SecondaryButtonStyle}" 
                                                Command="{Binding TodayCommand}"/>
                                    </StackPanel>

                                    <!-- Tiêu đề Tháng Năm -->
                                    <TextBlock Grid.Column="1" Text="{Binding MonthYearTitle}" 
                                               FontSize="15" FontWeight="ExtraBold" Foreground="#0F172A"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    <Button Grid.Column="2" Content="Tháng Sau ▶" Style="{StaticResource SecondaryButtonStyle}" 
                                            Command="{Binding NextMonthCommand}"/>
                                </Grid>
                            </Border>

                            <!-- HÀNG 1: TIÊU ĐỀ 7 THỨ TRONG TUẦN -->
                            <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,6">
                                <Border Background="#DFD5B8" BorderBrush="#C5BAA0" BorderThickness="1" CornerRadius="4" Margin="2" Padding="0,6">
                                    <TextBlock Text="THỨ 2" FontSize="11" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center"/>
                                </Border>
                                <Border Background="#DFD5B8" BorderBrush="#C5BAA0" BorderThickness="1" CornerRadius="4" Margin="2" Padding="0,6">
                                    <TextBlock Text="THỨ 3" FontSize="11" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center"/>
                                </Border>
                                <Border Background="#DFD5B8" BorderBrush="#C5BAA0" BorderThickness="1" CornerRadius="4" Margin="2" Padding="0,6">
                                    <TextBlock Text="THỨ 4" FontSize="11" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center"/>
                                </Border>
                                <Border Background="#DFD5B8" BorderBrush="#C5BAA0" BorderThickness="1" CornerRadius="4" Margin="2" Padding="0,6">
                                    <TextBlock Text="THỨ 5" FontSize="11" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center"/>
                                </Border>
                                <Border Background="#DFD5B8" BorderBrush="#C5BAA0" BorderThickness="1" CornerRadius="4" Margin="2" Padding="0,6">
                                    <TextBlock Text="THỨ 6" FontSize="11" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center"/>
                                </Border>
                                <Border Background="#D6E0D2" BorderBrush="#C2D1BC" BorderThickness="1" CornerRadius="4" Margin="2" Padding="0,6">
                                    <TextBlock Text="THỨ 7" FontSize="11" FontWeight="Bold" Foreground="#166534" HorizontalAlignment="Center"/>
                                </Border>
                                <Border Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="4" Margin="2" Padding="0,6">
                                    <TextBlock Text="CHỦ NHẬT" FontSize="11" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Center"/>
                                </Border>
                            </UniformGrid>

                            <!-- HÀNG 2: LƯỚI 42 Ô NGÀY TRONG THÁNG -->
                            <ItemsControl Grid.Row="2" ItemsSource="{Binding CalendarDays}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7" Rows="6"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="2" Padding="0" MinHeight="62" Cursor="Hand"
                                                Command="{Binding DataContext.SelectCalendarDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="DayBorder" Background="{DynamicResource TimelineCardBackgroundBrush}" BorderBrush="#D1C7B7" BorderThickness="1" CornerRadius="6" Padding="6,4">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="*"/>
                                                            </Grid.RowDefinitions>

                                                            <!-- Số ngày -->
                                                            <Grid Grid.Row="0">
                                                                <TextBlock x:Name="DayNumText" Text="{Binding DayNumber}" FontSize="12.5" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Left"/>
                                                                <Ellipse x:Name="EventDot" Width="7" Height="7" Fill="#DC2626" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                         Visibility="{Binding HasEvents, Converter={StaticResource BoolToVis}}"/>
                                                            </Grid>

                                                            <!-- Badge sự kiện -->
                                                            <Border Grid.Row="1" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="3" 
                                                                    Margin="0,3,0,0" Padding="3,1" VerticalAlignment="Center"
                                                                    Visibility="{Binding HasEvents, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="{Binding CategoryBadgeText}" FontSize="9.5" FontWeight="Bold" Foreground="#15803D" 
                                                                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <!-- Ngày ngoài tháng -->
                                                        <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                            <Setter TargetName="DayBorder" Property="Background" Value="#EDE5D0"/>
                                                            <Setter TargetName="DayNumText" Property="Foreground" Value="#94A3B8"/>
                                                            <Setter TargetName="DayNumText" Property="FontWeight" Value="Normal"/>
                                                        </DataTrigger>
                                                        <!-- Ngày Hôm nay -->
                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                            <Setter TargetName="DayBorder" Property="BorderBrush" Value="#DC2626"/>
                                                            <Setter TargetName="DayBorder" Property="BorderThickness" Value="2"/>
                                                            <Setter TargetName="DayBorder" Property="Background" Value="#FEF2F2"/>
                                                            <Setter TargetName="DayNumText" Property="Foreground" Value="#DC2626"/>
                                                        </DataTrigger>
                                                        <!-- Ngày được chọn -->
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="DayBorder" Property="BorderBrush" Value="#8F1515"/>
                                                            <Setter TargetName="DayBorder" Property="BorderThickness" Value="2"/>
                                                            <Setter TargetName="DayBorder" Property="Background" Value="#FEF08A"/>
                                                            <Setter TargetName="DayNumText" Property="Foreground" Value="#854D0E"/>
                                                        </DataTrigger>
                                                        <!-- Di chuột qua ô ngày -->
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="DayBorder" Property="Background" Value="#FFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- HÀNG 3: CHÚ THÍCH PHÂN LOẠI MÀU SẮC -->
                            <Border Grid.Row="3" Background="#E5DCBF" BorderBrush="#C5BAA0" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,10,0,0">
                                <WrapPanel HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                        <Ellipse Width="8" Height="8" Fill="#0C683B" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Kiểm tra thể lực" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                        <Ellipse Width="8" Height="8" Fill="#0A6A45" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Thi cử quân sự" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                        <Ellipse Width="8" Height="8" Fill="#0C683B" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Tập luyện / Rèn luyện" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="#1D4ED8" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Hội thao / Sự kiện" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </WrapPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Border>

                <!-- ========================================================================= -->
                <!-- CỘT PHẢI: BẢNG SỰ KIỆN THEO NGÀY & FORM BIÊN TẬP CHUẨN CELANDAR.PNG -->
                <!-- ========================================================================= -->
                <Border Grid.Column="1" Background="{DynamicResource TimelineBackgroundBrush}" BorderBrush="{DynamicResource TimelineBorderBrush}" BorderThickness="1.5" CornerRadius="8" Padding="14">
                    <Grid>
                        <!-- ===================================================== -->
                        <!-- CHẾ ĐỘ 1: XEM SỰ KIỆN THEO NGÀY (IsFormVisible == False) -->
                        <!-- ===================================================== -->
                        <Grid Visibility="{Binding IsFormVisible, Converter={StaticResource InvBoolToVis}}">
                            <Grid.RowDefinitions>
                                <!-- Header ngày đã chọn -->
                                <RowDefinition Height="Auto"/>
                                <!-- Khung hộp có viền chứa Watermark Ngọn Núi, Sao Vàng & Motto Quân Đội -->
                                <RowDefinition Height="*"/>
                                <!-- Nút đỏ lớn ở chân bảng: + Thêm Mốc Sự Kiện Mới -->
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Tiêu đề ngày chọn -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="📅" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedDayTitle}" FontSize="15" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap"/>
                                    <TextBlock Text="Danh sách các mốc sự kiện &amp; rèn luyện" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Khung hộp nội dung chính có viền bo góc & Watermark Ngọn Núi Tây Bắc -->
                            <Border Grid.Row="1" Background="{DynamicResource TimelineCardBackgroundBrush}" BorderBrush="{DynamicResource TimelineCardBorderBrush}" BorderThickness="1.2" CornerRadius="8" ClipToBounds="True">
                                <Grid>
                                    <!-- Background Watermark Ngọn Núi + Sao Vàng + VÌ TỔ QUỐC VÌ NHÂN DÂN -->
                                    <Image Source="/Assets/Images/timeline_right_watermark_bg.png" Stretch="Fill" IsHitTestVisible="False"/>

                                    <!-- 1. Danh sách sự kiện nếu ngày có sự kiện -->
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding SelectedDayEvents}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="6" Background="{DynamicResource TimelineCardBackgroundBrush}" BorderBrush="{DynamicResource TimelineCardBorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                                                            <Border.Effect>
                                                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.08" Color="#332B1E"/>
                                                            </Border.Effect>
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>

                                                                <!-- Badges -->
                                                                <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                                                                    <Border CornerRadius="3" Padding="7,2" Background="{Binding CategoryBg, Converter={StaticResource StringToBrush}}" Margin="0,0,4,2">
                                                                        <TextBlock Text="{Binding Category}" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold"/>
                                                                    </Border>
                                                                    <Border CornerRadius="3" Padding="7,2" Background="{Binding StatusBg, Converter={StaticResource StringToBrush}}" Margin="0,0,4,2">
                                                                        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusFg, Converter={StaticResource StringToBrush}}" FontSize="10" FontWeight="Bold"/>
                                                                    </Border>
                                                                    <Border CornerRadius="3" Padding="7,2" Background="{Binding PriorityBg, Converter={StaticResource StringToBrush}}" Margin="0,0,4,2">
                                                                        <TextBlock Text="{Binding Priority}" Foreground="{Binding PriorityFg, Converter={StaticResource StringToBrush}}" FontSize="10" FontWeight="Bold"/>
                                                                    </Border>
                                                                </WrapPanel>

                                                                <!-- Tiêu đề -->
                                                                <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap" Margin="0,0,0,4"/>

                                                                <!-- Chi tiết -->
                                                                <StackPanel Grid.Row="2" Margin="0,0,0,6">
                                                                    <TextBlock Text="{Binding TargetUnit, StringFormat='Đơn vị: {0}'}" FontSize="11.5" Foreground="#334155" Margin="0,0,0,2"/>
                                                                    <TextBlock Text="{Binding Location, StringFormat='Địa điểm: {0}'}" FontSize="11.5" Foreground="#334155" Margin="0,0,0,2"/>
                                                                    <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                                </StackPanel>

                                                                <!-- Nút thao tác -->
                                                                <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,4,0,0">
                                                                    <Button Content="✓ Hoàn Thành" Style="{StaticResource SecondaryButtonStyle}" 
                                                                            Padding="8,3" Margin="0,0,4,0" FontSize="11"
                                                                            Command="{Binding DataContext.ToggleCompleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding}"/>
                                                                    <Button Content="✏ Sửa" Style="{StaticResource SecondaryButtonStyle}" 
                                                                            Padding="8,3" Margin="0,0,4,0" FontSize="11"
                                                                            Command="{Binding DataContext.OpenEditFormCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding}"/>
                                                                    <Button Content="🗑" Style="{StaticResource DangerButtonStyle}" 
                                                                            Padding="8,3" FontSize="11"
                                                                            Command="{Binding DataContext.DeleteEventCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding}"/>
                                                                </WrapPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- 2. Empty State khi ngày chưa có sự kiện chuẩn Celandar.png -->
                                            <Border Background="Transparent" Padding="14,60,14,20">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedDayEvents.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <!-- Icon Lịch rỗng quân đội trích xuất chuẩn Celandar.png -->
                                                    <Image Source="/Assets/Images/timeline_empty_calendar_icon.png" Width="44" Height="44" 
                                                           HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                                    <TextBlock Text="Ngày này chưa có sự kiện huấn luyện nào." 
                                                               FontSize="13" FontWeight="SemiBold" Foreground="#3F3C36" 
                                                               HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                                    
                                                    <!-- Nút Đỏ Gradient Quân Kỳ Viền Vàng chuẩn Celandar.png -->
                                                    <Button Style="{StaticResource PrimaryButtonStyle}" 
                                                            Padding="20,9" HorizontalAlignment="Center"
                                                            Command="{Binding AddEventForSelectedDayCommand}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="➕  " FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Thêm Sự Kiện Cho Ngày Này" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- Nút đỏ lớn ở chân bảng: + Thêm Mốc Sự Kiện Mới -->
                            <Button Grid.Row="2" Style="{StaticResource PrimaryButtonStyle}" 
                                    Height="42" Margin="0,12,0,0" Padding="14,0" HorizontalAlignment="Stretch"
                                    Command="{Binding OpenAddFormCommand}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="➕  " FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Text="Thêm Mốc Sự Kiện Mới" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- ===================================================== -->
                        <!-- CHẾ ĐỘ 2: FORM BIÊN TẬP (IsFormVisible == True) -->
                        <!-- ===================================================== -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding IsFormVisible, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <!-- Tiêu đề Form -->
                                <TextBlock Text="{Binding FormHeader}" FontSize="15" FontWeight="ExtraBold" Foreground="#8F1515" Margin="0,0,0,14"/>

                                <!-- Tiêu đề sự kiện -->
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Tiêu đề mốc sự kiện / kiểm tra (*):" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" 
                                             Background="{DynamicResource TimelineCardBackgroundBrush}" BorderBrush="#C5BAA0" Foreground="#0F172A"
                                             Height="34" VerticalContentAlignment="Center" Padding="8,0"/>
                                </StackPanel>

                                <!-- Phân loại -->
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Loại sự kiện huấn luyện (*):" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                    <ComboBox SelectedItem="{Binding EditCategory}" Height="34" Background="{DynamicResource TimelineCardBackgroundBrush}" BorderBrush="#C5BAA0">
                                        <ComboBoxItem Content="Kiểm tra thể lực" IsSelected="True"/>
                                        <ComboBoxItem Content="Thi cử quân sự"/>
                                        <ComboBoxItem Content="Tập luyện / Rèn luyện"/>
                                        <ComboBoxItem Content="Hội thao / Sự kiện"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Đơn vị áp dụng -->
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Đơn vị / Đối tượng áp dụng:" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding UnitOptions}" SelectedItem="{Binding EditTargetUnit}" Height="34" Background="{DynamicResource TimelineCardBackgroundBrush}" BorderBrush="#C5BAA0"/>
                                </StackPanel>

                                <!-- Thời gian bắt đầu & kết thúc -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Ngày bắt đầu:" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                        <DatePicker SelectedDate="{Binding EditStartDate}" Height="34"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Ngày kết thúc:" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                        <DatePicker SelectedDate="{Binding EditEndDate}" Height="34"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Địa điểm / Thao trường -->
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Địa điểm / Thao trường:" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditLocation, UpdateSourceTrigger=PropertyChanged}" 
                                             Background="{DynamicResource TimelineCardBackgroundBrush}" BorderBrush="#C5BAA0" Foreground="#0F172A"
                                             Height="34" VerticalContentAlignment="Center" Padding="8,0"/>
                                </StackPanel>

                                <!-- Mức độ ưu tiên & Trạng thái -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Mức độ ưu tiên:" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding PriorityOptions}" SelectedItem="{Binding EditPriority}" Height="34" Background="{DynamicResource TimelineCardBackgroundBrush}" BorderBrush="#C5BAA0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Trạng thái:" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                        <ComboBox SelectedItem="{Binding EditStatus}" Height="34" Background="{DynamicResource TimelineCardBackgroundBrush}" BorderBrush="#C5BAA0">
                                            <ComboBoxItem Content="Đang chuẩn bị" IsSelected="True"/>
                                            <ComboBoxItem Content="Đang diễn ra"/>
                                            <ComboBoxItem Content="Đã hoàn thành"/>
                                            <ComboBoxItem Content="Tạm hoãn"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <!-- Nội dung / Kế hoạch chi tiết -->
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="Nội dung, chỉ thị chi tiết:" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" 
                                             Background="{DynamicResource TimelineCardBackgroundBrush}" BorderBrush="#C5BAA0" Foreground="#0F172A"
                                             Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="8"/>
                                </StackPanel>

                                <!-- Các nút Lưu và Hủy -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                    <Button Content="✕ Hủy" Style="{StaticResource SecondaryButtonStyle}" 
                                            Padding="16,8" Margin="0,0,8,0"
                                            Command="{Binding CloseFormCommand}"/>

                                    <Button Style="{StaticResource PrimaryButtonStyle}" 
                                            Padding="18,8"
                                            Command="{Binding SaveEventCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💾  " FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="Lưu Mốc Sự Kiện" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>