<UserControl x:Class="QL_HocVien.Views.UserControls.TrainingTimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:cv="clr-namespace:QL_HocVien.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100">

    <UserControl.Resources>
        <cv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <cv:InvertedBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
    </UserControl.Resources>

    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Tiêu đề & Nút thao tác -->
                <RowDefinition Height="Auto"/>
                <!-- Thẻ thống kê KPI -->
                <RowDefinition Height="Auto"/>
                <!-- Thanh lọc -->
                <RowDefinition Height="Auto"/>
                <!-- Vùng Timeline & Form chi tiết -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HÀNG 0: TIÊU ĐỀ & NÚT THAO TÁC -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,4">
                    <TextBlock Text="LỊCH TRÌNH HUẤN LUYỆN, THI CỬ &amp; SỰ KIỆN QUÂN SỰ" 
                               FontSize="19" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap"/>
                    <TextBlock Text="Theo dõi dòng thời gian (Timeline) các mốc kiểm tra thể lực, thi cử học phần, dã ngoại rèn luyện và hội thao" 
                               FontSize="12" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="🔄 Tải Lại Lịch" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,4"
                            Command="{Binding LoadEventsCommand}"/>
                    <Button Content="➕ Thêm Mốc Sự Kiện" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,4"
                            Command="{Binding OpenAddFormCommand}"/>
                </WrapPanel>
            </Grid>

            <!-- HÀNG 1: THẺ THỐNG KÊ KPI SỰ KIỆN -->
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- KPI 1: Tổng mốc sự kiện -->
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="14,10" Background="#FFFFFF">
                    <StackPanel>
                        <TextBlock Text="TỔNG SỐ MỐC SỰ KIỆN" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding TotalEventsCount}" FontSize="22" FontWeight="ExtraBold" Foreground="#0F172A" Margin="0,4,0,0"/>
                        <TextBlock Text="Lịch trình trong cơ sở dữ liệu" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- KPI 2: Đang diễn ra -->
                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="14,10" Background="#EFF6FF" BorderBrush="#BFDBFE">
                    <StackPanel>
                        <TextBlock Text="ĐANG DIỄN RA" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8"/>
                        <TextBlock Text="{Binding OngoingEventsCount}" FontSize="22" FontWeight="ExtraBold" Foreground="#2563EB" Margin="0,4,0,0"/>
                        <TextBlock Text="Sự kiện đang trong tiến trình" FontSize="11" Foreground="#3B82F6" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- KPI 3: Khẩn cấp / Ưu tiên cao -->
                <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}" Padding="14,10" Background="#FEF2F2" BorderBrush="#FECACA">
                    <StackPanel>
                        <TextBlock Text="KHẨN CẤP / TRỌNG ĐIỂM" FontSize="11" FontWeight="Bold" Foreground="#B91C1C"/>
                        <TextBlock Text="{Binding UrgentEventsCount}" FontSize="22" FontWeight="ExtraBold" Foreground="#DC2626" Margin="0,4,0,0"/>
                        <TextBlock Text="Ưu tiên cần tập trung chuẩn bị" FontSize="11" Foreground="#EF4444" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- KPI 4: Đã hoàn thành -->
                <Border Grid.Column="6" Style="{StaticResource CardBorderStyle}" Padding="14,10" Background="#F0FDF4" BorderBrush="#BBF7D0">
                    <StackPanel>
                        <TextBlock Text="ĐÃ HOÀN THÀNH" FontSize="11" FontWeight="Bold" Foreground="#15803D"/>
                        <TextBlock Text="{Binding CompletedEventsCount}" FontSize="22" FontWeight="ExtraBold" Foreground="#16A34A" Margin="0,4,0,0"/>
                        <TextBlock Text="Đã thực hiện xong kiểm tra / sự kiện" FontSize="11" Foreground="#22C55E" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- HÀNG 2: THANH LỌC LỊCH TRÌNH -->
            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Lọc Loại sự kiện -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Phân loại sự kiện huấn luyện:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding SelectedCategory}" Height="34"/>
                    </StackPanel>

                    <!-- Lọc Trạng thái -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Trạng thái thực hiện:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatus}" Height="34"/>
                    </StackPanel>

                    <!-- Nút Lọc -->
                    <Button Grid.Column="4" Content="Lọc Lịch Trình" Style="{StaticResource PrimaryButtonStyle}" 
                            VerticalAlignment="Bottom" Height="34" Padding="14,0"
                            Command="{Binding LoadEventsCommand}"/>

                    <!-- Nút Đặt lại -->
                    <Button Grid.Column="6" Content="Tất Cả" Style="{StaticResource SecondaryButtonStyle}" 
                            VerticalAlignment="Bottom" Height="34" Padding="14,0"
                            Command="{Binding ResetFilterCommand}"/>
                </Grid>
            </Border>

            <!-- HÀNG 3: VÙNG TIMELINE & FORM BIÊN TẬP -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <!-- Cột Danh sách Timeline -->
                    <ColumnDefinition Width="*"/>
                    <!-- Cột Form thêm / sửa (hoặc chi tiết) -->
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <!-- CỘT BÊN TRÁI: DÒNG THỜI GIAN (TIMELINE) -->
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,14,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Events}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <!-- Cột Trục thời gian mốc ngày tháng -->
                                            <ColumnDefinition Width="110"/>
                                            <!-- Cột Đường kẻ trục dọc -->
                                            <ColumnDefinition Width="28"/>
                                            <!-- Cột Thẻ chi tiết sự kiện -->
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Mốc ngày tháng bên trái -->
                                        <StackPanel Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0">
                                            <TextBlock Text="{Binding StartDate, StringFormat={}{0:dd/MM/yyyy}}" 
                                                       FontWeight="Bold" FontSize="13" Foreground="#0F172A" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding StartDate, StringFormat={}{0:dddd}}" 
                                                       FontSize="11" Foreground="#64748B" HorizontalAlignment="Right"/>
                                        </StackPanel>

                                        <!-- Điểm mốc & Trục nối dọc -->
                                        <Grid Grid.Column="1" HorizontalAlignment="Center">
                                            <Rectangle Width="2" Fill="#CBD5E1" VerticalAlignment="Stretch" Margin="0,18,0,0"/>
                                            <Ellipse Width="14" Height="14" Fill="#0F766E" Stroke="#FFFFFF" StrokeThickness="2" VerticalAlignment="Top" Margin="0,8,0,0"/>
                                        </Grid>

                                        <!-- Thẻ nội dung sự kiện bên phải -->
                                        <Border Grid.Column="2" CornerRadius="8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Hàng 1: Huy hiệu Category, Đơn vị, Ưu tiên, Trạng thái -->
                                                <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                                                    <!-- Category Badge -->
                                                    <Border CornerRadius="4" Padding="8,3" Background="#0F766E" Margin="0,0,6,4">
                                                        <TextBlock Text="{Binding Category}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                                    </Border>

                                                    <!-- Unit Badge -->
                                                    <Border CornerRadius="4" Padding="8,3" Background="#334155" Margin="0,0,6,4">
                                                        <TextBlock Text="{Binding TargetUnit}" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                                                    </Border>

                                                    <!-- Priority Badge -->
                                                    <Border CornerRadius="4" Padding="8,3" Background="#FEE2E2" Margin="0,0,6,4">
                                                        <TextBlock Text="{Binding Priority}" Foreground="#DC2626" FontWeight="Bold" FontSize="11"/>
                                                    </Border>

                                                    <!-- Status Badge -->
                                                    <Border CornerRadius="4" Padding="8,3" Background="#DCFCE7" Margin="0,0,6,4">
                                                        <TextBlock Text="{Binding Status}" Foreground="#16A34A" FontWeight="Bold" FontSize="11"/>
                                                    </Border>
                                                </WrapPanel>

                                                <!-- Hàng 2: Tiêu đề sự kiện -->
                                                <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap" Margin="0,0,0,6"/>

                                                <!-- Hàng 3: Thời gian, Địa điểm, Ghi chú -->
                                                <StackPanel Grid.Row="2" Margin="0,0,0,10">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <TextBlock Text="⏱️ Thời gian: " FontWeight="SemiBold" FontSize="12" Foreground="#475569"/>
                                                        <TextBlock Text="{Binding StartDate, StringFormat={}{0:dd/MM/yyyy}}" FontSize="12" Foreground="#1E293B"/>
                                                        <TextBlock Text=" ➔ " FontSize="12" Foreground="#64748B"/>
                                                        <TextBlock Text="{Binding EndDate, StringFormat={}{0:dd/MM/yyyy}}" FontSize="12" Foreground="#1E293B"/>
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <TextBlock Text="📍 Địa điểm: " FontWeight="SemiBold" FontSize="12" Foreground="#475569"/>
                                                        <TextBlock Text="{Binding Location}" FontSize="12" Foreground="#1E293B"/>
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <!-- Hàng 4: Các nút hành động -->
                                                <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
                                                    <Button Content="✓ Đổi Hoàn Thành" Style="{StaticResource SecondaryButtonStyle}" 
                                                            Padding="10,4" Margin="0,0,6,0" FontSize="11"
                                                            Command="{Binding DataContext.ToggleCompleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>

                                                    <Button Content="✏️ Sửa" Style="{StaticResource SecondaryButtonStyle}" 
                                                            Padding="10,4" Margin="0,0,6,0" FontSize="11"
                                                            Command="{Binding DataContext.OpenEditFormCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>

                                                    <Button Content="🗑️ Xóa" Style="{StaticResource DangerButtonStyle}" 
                                                            Padding="10,4" FontSize="11"
                                                            Command="{Binding DataContext.DeleteEventCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </WrapPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- CỘT BÊN PHẢI: FORM THÊM / SỬA MỐC SỰ KIỆN -->
                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="18">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Tiêu đề Form -->
                            <TextBlock Text="{Binding FormHeader}" FontSize="14" FontWeight="Bold" Foreground="#0F766E" Margin="0,0,0,12"/>

                            <!-- Tiêu đề sự kiện -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Tiêu đề mốc sự kiện / kiểm tra (*):" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="6,0"/>
                            </StackPanel>

                            <!-- Phân loại -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Loại sự kiện huấn luyện (*):" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <ComboBox SelectedItem="{Binding EditCategory}" Height="34">
                                    <ComboBoxItem Content="Kiểm tra thể lực" IsSelected="True"/>
                                    <ComboBoxItem Content="Thi cử quân sự"/>
                                    <ComboBoxItem Content="Tập luyện / Rèn luyện"/>
                                    <ComboBoxItem Content="Hội thao / Sự kiện"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Đơn vị áp dụng -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Đơn vị / Đối tượng áp dụng:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding UnitOptions}" SelectedItem="{Binding EditTargetUnit}" Height="34"/>
                            </StackPanel>

                            <!-- Thời gian bắt đầu & kết thúc -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Ngày bắt đầu:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                    <DatePicker SelectedDate="{Binding EditStartDate}" Height="34"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Ngày kết thúc:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                    <DatePicker SelectedDate="{Binding EditEndDate}" Height="34"/>
                                </StackPanel>
                            </Grid>

                            <!-- Địa điểm / Thao trường -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Địa điểm / Thao trường:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditLocation, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="6,0"/>
                            </StackPanel>

                            <!-- Mức độ ưu tiên & Trạng thái -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Mức độ ưu tiên:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding PriorityOptions}" SelectedItem="{Binding EditPriority}" Height="34"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Trạng thái:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                    <ComboBox SelectedItem="{Binding EditStatus}" Height="34">
                                        <ComboBoxItem Content="Đang chuẩn bị" IsSelected="True"/>
                                        <ComboBoxItem Content="Đang diễn ra"/>
                                        <ComboBoxItem Content="Đã hoàn thành"/>
                                        <ComboBoxItem Content="Tạm hoãn"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- Nội dung / Kế hoạch chi tiết -->
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Nội dung, chỉ thị chi tiết:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" 
                                         Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="6"/>
                            </StackPanel>

                            <!-- Các nút Lưu và Hủy -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="✕ Hủy" Style="{StaticResource SecondaryButtonStyle}" 
                                        Padding="14,8" Margin="0,0,8,0"
                                        Command="{Binding CloseFormCommand}"/>

                                <Button Content="💾 Lưu Mốc Sự Kiện" Style="{StaticResource PrimaryButtonStyle}" 
                                        Padding="16,8"
                                        Command="{Binding SaveEventCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
