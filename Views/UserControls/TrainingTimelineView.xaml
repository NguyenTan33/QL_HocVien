<UserControl x:Class="QL_HocVien.Views.UserControls.TrainingTimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:cv="clr-namespace:QL_HocVien.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1300">

    <UserControl.Resources>
        <cv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <cv:InvertedBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
        <cv:StringToBrushConverter x:Key="StringToBrush"/>

        <!-- Nút Outline Trắng ngà dã chiến cho Timeline -->
        <Style x:Key="ParchmentOutlineButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút Đỏ Xóa Dã Chiến cho Timeline -->
        <Style x:Key="ParchmentDangerButton" TargetType="Button">
            <Setter Property="Background" Value="#B91C1C"/>
            <Setter Property="BorderBrush" Value="#991B1B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DC2626"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#EF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <!-- 0. Header (Tiêu đề bên trái, 3 nút công cụ bên phải theo mẫu Celandar.png) -->
                <RowDefinition Height="Auto"/>
                <!-- 1. 4 Thẻ thống kê KPI với Icon tròn -->
                <RowDefinition Height="Auto"/>
                <!-- 2. Thanh lọc tác chiến -->
                <RowDefinition Height="Auto"/>
                <!-- 3. Không gian chính 2 cột (Dòng thời gian dã chiến & Sự kiện ngày) -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ========================================================================= -->
            <!-- HÀNG 0: HEADER CHUẨN CELANDAR.PNG (TIÊU ĐỀ TRÁI - 3 NÚT THAO TÁC PHẢI) -->
            <!-- ========================================================================= -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Tiêu đề & phụ đề bên trái -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="LỊCH TRÌNH HUẤN LUYỆN, THI CỬ &amp; SỰ KIỆN QUÂN SỰ" 
                               FontSize="22" FontWeight="ExtraBold" Foreground="{DynamicResource AccentLightBrush}" 
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="Theo dõi dòng thời gian (Timeline) các mốc kiểm tra thể lực, thi cử học phần, dã ngoại rèn luyện và hội thao" 
                               FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" 
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Cụm 3 nút thao tác góc trên bên phải chuẩn Celandar.png -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Nút chuyển đổi Cuộn Lịch Tháng / Dòng Thời Gian -->
                    <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Height="36" Padding="14,0"
                            Command="{Binding SwitchToCalendarViewCommand}"
                            Visibility="{Binding IsCalendarViewVisible, Converter={StaticResource InvBoolToVis}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📅 " FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="Xem Cuộn Lịch Tháng" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Height="36" Padding="14,0"
                            Command="{Binding SwitchToTimelineViewCommand}"
                            Visibility="{Binding IsCalendarViewVisible, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📜 " FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="Dòng Thời Gian Dọc" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Nút Tải lại lịch -->
                    <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Height="36" Padding="14,0"
                            Command="{Binding LoadEventsCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔄 " FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="Tải Lại Lịch" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Nút Thêm mốc sự kiện đỏ quân kỳ -->
                    <Button Style="{StaticResource PrimaryButtonStyle}" Height="36" Padding="16,0"
                            Command="{Binding OpenAddFormCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="➕ " FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="Thêm Mốc Sự Kiện" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ========================================================================= -->
            <!-- HÀNG 1: 4 THẺ THỐNG KÊ KPI VỚI ICON TRÒN CHUẨN CELANDAR.PNG -->
            <!-- ========================================================================= -->
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- KPI 1: TỔNG SỐ MỐC SỰ KIỆN -->
                <Border Grid.Column="0" Background="#16281B" BorderBrush="#2A4B2D" BorderThickness="1" CornerRadius="8" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Icon tròn xanh lá rêu -->
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#203D27" BorderBrush="#2E5E3A" BorderThickness="1" VerticalAlignment="Center">
                            <TextBlock Text="📅" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <!-- Số liệu & Tiêu đề -->
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="TỔNG SỐ MỐC SỰ KIỆN" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"/>
                            <TextBlock Text="{Binding TotalEventsCount}" FontSize="26" FontWeight="ExtraBold" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                            <TextBlock Text="Lịch trình trong cơ sở dữ liệu" FontSize="11" Foreground="#6B7280" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- KPI 2: ĐANG DIỄN RA -->
                <Border Grid.Column="2" Background="#152732" BorderBrush="#21495E" BorderThickness="1" CornerRadius="8" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Icon tròn xanh dương / thủy quân -->
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#1B384A" BorderBrush="#2C5874" BorderThickness="1" VerticalAlignment="Center">
                            <TextBlock Text="⌛" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <!-- Số liệu & Tiêu đề -->
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ĐANG DIỄN RA" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"/>
                            <TextBlock Text="{Binding OngoingEventsCount}" FontSize="26" FontWeight="ExtraBold" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                            <TextBlock Text="Sự kiện đang trong tiến trình" FontSize="11" Foreground="#6B7280" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- KPI 3: KHẨN CẤP / TRỌNG ĐIỂM -->
                <Border Grid.Column="4" Background="#321417" BorderBrush="#632027" BorderThickness="1" CornerRadius="8" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Icon tròn đỏ cảnh báo -->
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#4E1A20" BorderBrush="#7A2832" BorderThickness="1" VerticalAlignment="Center">
                            <TextBlock Text="⚠️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <!-- Số liệu & Tiêu đề -->
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="KHẨN CẤP / TRỌNG ĐIỂM" FontSize="11" FontWeight="Bold" Foreground="#EF4444"/>
                            <TextBlock Text="{Binding UrgentEventsCount}" FontSize="26" FontWeight="ExtraBold" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                            <TextBlock Text="Ưu tiên cần tập trung chuẩn bị" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- KPI 4: ĐÃ HOÀN THÀNH -->
                <Border Grid.Column="6" Background="#142B1F" BorderBrush="#21583B" BorderThickness="1" CornerRadius="8" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Icon tròn xanh lá hoàn thành -->
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#1D422F" BorderBrush="#2E6D49" BorderThickness="1" VerticalAlignment="Center">
                            <TextBlock Text="✅" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <!-- Số liệu & Tiêu đề -->
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ĐÃ HOÀN THÀNH" FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
                            <TextBlock Text="{Binding CompletedEventsCount}" FontSize="26" FontWeight="ExtraBold" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                            <TextBlock Text="Đã thực hiện xong kiểm tra / sự kiện" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================================================================= -->
            <!-- HÀNG 2: THANH LỌC LỊCH TRÌNH CHUẨN CELANDAR.PNG -->
            <!-- ========================================================================= -->
            <Border Grid.Row="2" Background="#18251A" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Lọc Loại sự kiện -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Phân loại sự kiện huấn luyện:" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding SelectedCategory}" Height="34"/>
                    </StackPanel>

                    <!-- Lọc Trạng thái -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Trạng thái thực hiện:" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatus}" Height="34"/>
                    </StackPanel>

                    <!-- Nút Lọc Lịch Trình -->
                    <Button Grid.Column="4" Style="{StaticResource PrimaryButtonStyle}" 
                            VerticalAlignment="Bottom" Height="34" Padding="18,0"
                            Command="{Binding LoadEventsCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎯 " FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="Lọc Lịch Trình" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Nút Tất Cả (Reset) -->
                    <Button Grid.Column="6" Content="Tất Cả" Style="{StaticResource SecondaryButtonStyle}" 
                            VerticalAlignment="Bottom" Height="34" Padding="16,0"
                            Command="{Binding ResetFilterCommand}"/>
                </Grid>
            </Border>

            <!-- ========================================================================= -->
            <!-- HÀNG 3: KHÔNG GIAN TÁC CHIẾN 2 CỘT (CHUẨN THIẾT KẾ CELANDAR.PNG) -->
            <!-- ========================================================================= -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <!-- Cột Trái: Dòng Thời Gian Dã Chiến (Hoặc Lịch Tháng) -->
                    <ColumnDefinition Width="*"/>
                    <!-- Cột Phải: Sự Kiện Ngày Đã Chọn & Form Biên Tập -->
                    <ColumnDefinition Width="390"/>
                </Grid.ColumnDefinitions>

                <!-- ================================================================= -->
                <!-- CỘT TRÁI - CHẾ ĐỘ 1: DÒNG THỜI GIAN DÃ CHIẾN (PARCHMENT TIMELINE) -->
                <!-- ================================================================= -->
                <Border Grid.Column="0" Background="#F5EFE4" BorderBrush="#8C7D5D" BorderThickness="1.5" CornerRadius="8" Padding="16" Margin="0,0,14,0"
                        Visibility="{Binding IsCalendarViewVisible, Converter={StaticResource InvBoolToVis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Events}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,16" Padding="0,0,0,16" BorderBrush="#E2D9C8" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <!-- Cột Ngày tháng bên trái -->
                                                <ColumnDefinition Width="120"/>
                                                <!-- Cột Vạch ngăn cách dọc -->
                                                <ColumnDefinition Width="20"/>
                                                <!-- Cột Nội dung sự kiện -->
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Khối ngày tháng bên trái (Ngày lớn + Thứ) -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding StartDate, StringFormat={}{0:dd/MM/yyyy}}" 
                                                           FontWeight="ExtraBold" FontSize="16" Foreground="#0F172A"/>
                                                <TextBlock Text="{Binding DayOfWeekVietnamese}" 
                                                           FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,3,0,0"/>
                                            </StackPanel>

                                            <!-- Vạch ngăn cách dọc -->
                                            <Rectangle Grid.Column="1" Width="1.5" Fill="#D6CBBA" VerticalAlignment="Stretch" Margin="8,4,8,4"/>

                                            <!-- Chi tiết sự kiện bên phải -->
                                            <Grid Grid.Column="2">
                                                <Grid.RowDefinitions>
                                                    <!-- Hàng 0: Huy hiệu (Badges) -->
                                                    <RowDefinition Height="Auto"/>
                                                    <!-- Hàng 1: Tiêu đề -->
                                                    <RowDefinition Height="Auto"/>
                                                    <!-- Hàng 2: Thời gian & Địa điểm & Mô tả -->
                                                    <RowDefinition Height="Auto"/>
                                                    <!-- Hàng 3: Các nút hành động góc phải -->
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Hàng 0: 4 Huy hiệu (Category, Unit, Priority, Status) -->
                                                <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                                                    <!-- Category Badge -->
                                                    <Border CornerRadius="4" Padding="8,3" Background="{Binding CategoryBg, Converter={StaticResource StringToBrush}}" Margin="0,0,6,4">
                                                        <TextBlock Text="{Binding Category}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"/>
                                                    </Border>

                                                    <!-- Unit Scope Badge -->
                                                    <Border CornerRadius="4" Padding="8,3" Background="#334155" Margin="0,0,6,4">
                                                        <TextBlock Text="{Binding TargetUnit}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11"/>
                                                    </Border>

                                                    <!-- Priority Badge -->
                                                    <Border CornerRadius="4" Padding="8,3" Background="{Binding PriorityBg, Converter={StaticResource StringToBrush}}" Margin="0,0,6,4">
                                                        <TextBlock Text="{Binding Priority}" Foreground="{Binding PriorityFg, Converter={StaticResource StringToBrush}}" FontWeight="Bold" FontSize="11"/>
                                                    </Border>

                                                    <!-- Status Badge -->
                                                    <Border CornerRadius="4" Padding="8,3" Background="{Binding StatusBg, Converter={StaticResource StringToBrush}}" Margin="0,0,6,4">
                                                        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusFg, Converter={StaticResource StringToBrush}}" FontWeight="Bold" FontSize="11"/>
                                                    </Border>
                                                </WrapPanel>

                                                <!-- Hàng 1: Tiêu đề sự kiện (Đen đậm sắc nét trên nền dã chiến) -->
                                                <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="15.5" FontWeight="ExtraBold" Foreground="#0F172A" TextWrapping="Wrap" Margin="0,0,0,6"/>

                                                <!-- Hàng 2: Thời gian, Địa điểm, Kế hoạch chi tiết -->
                                                <StackPanel Grid.Row="2" Margin="0,0,0,8">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                        <TextBlock Text="🕒 Thời gian: " FontWeight="SemiBold" FontSize="12" Foreground="#334155"/>
                                                        <TextBlock Text="{Binding StartDate, StringFormat={}{0:dd/MM/yyyy}}" FontSize="12" Foreground="#1E293B"/>
                                                        <TextBlock Text=" ➔ " FontSize="12" Foreground="#64748B"/>
                                                        <TextBlock Text="{Binding EndDate, StringFormat={}{0:dd/MM/yyyy}}" FontSize="12" Foreground="#1E293B"/>
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <TextBlock Text="📍 Địa điểm: " FontWeight="SemiBold" FontSize="12" Foreground="#334155"/>
                                                        <TextBlock Text="{Binding Location}" FontSize="12" Foreground="#1E293B" FontWeight="SemiBold"/>
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding Description}" FontSize="12.5" Foreground="#475569" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <!-- Hàng 3: Các nút hành động góc dưới bên phải chuẩn Celandar.png -->
                                                <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
                                                    <Button Content="✓ Đổi Hoàn Thành" Style="{StaticResource ParchmentOutlineButton}" 
                                                            Margin="0,0,6,0"
                                                            Command="{Binding DataContext.ToggleCompleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>

                                                    <Button Content="✏ Sửa" Style="{StaticResource ParchmentOutlineButton}" 
                                                            Margin="0,0,6,0"
                                                            Command="{Binding DataContext.OpenEditFormCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>

                                                    <Button Content="🗑 Xóa" Style="{StaticResource ParchmentDangerButton}" 
                                                            Command="{Binding DataContext.DeleteEventCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </WrapPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- ================================================================= -->
                <!-- CỘT TRÁI - CHẾ ĐỘ 2: CUỐN LỊCH THÁNG (PHONE-STYLE MONTHLY CALENDAR) -->
                <!-- ================================================================= -->
                <Border Grid.Column="0" Background="#F5EFE4" BorderBrush="#8C7D5D" BorderThickness="1.5" CornerRadius="8" Padding="14,12" Margin="0,0,14,0"
                        Visibility="{Binding IsCalendarViewVisible, Converter={StaticResource BoolToVis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- Header điều hướng Tháng / Năm -->
                                <RowDefinition Height="Auto"/>
                                <!-- Tiêu đề 7 thứ trong tuần -->
                                <RowDefinition Height="Auto"/>
                                <!-- Lưới 42 ô ngày (6 tuần x 7 ngày) -->
                                <RowDefinition Height="Auto"/>
                                <!-- Chú thích màu sắc sự kiện -->
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- HÀNG 0: HEADER ĐIỀU HƯỚNG THÁNG / NĂM -->
                            <Border Grid.Row="0" Background="#EFE7D8" BorderBrush="#D1C7B7" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Button Content="◀ Tháng Trước" Style="{StaticResource ParchmentOutlineButton}" 
                                                Margin="0,0,6,0" Command="{Binding PreviousMonthCommand}"/>
                                        <Button Content="Hôm Nay" Style="{StaticResource ParchmentOutlineButton}" 
                                                Command="{Binding TodayCommand}"/>
                                    </StackPanel>

                                    <!-- Tiêu đề Tháng Năm -->
                                    <TextBlock Grid.Column="1" Text="{Binding MonthYearTitle}" 
                                               FontSize="15" FontWeight="ExtraBold" Foreground="#0F172A"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    <Button Grid.Column="2" Content="Tháng Sau ▶" Style="{StaticResource ParchmentOutlineButton}" 
                                            Command="{Binding NextMonthCommand}"/>
                                </Grid>
                            </Border>

                            <!-- HÀNG 1: TIÊU ĐỀ 7 THỨ TRONG TUẦN -->
                            <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,6">
                                <Border Background="#E5DCCB" BorderBrush="#D1C7B7" BorderThickness="1" CornerRadius="4" Margin="2" Padding="0,6">
                                    <TextBlock Text="THỨ 2" FontSize="11" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center"/>
                                </Border>
                                <Border Background="#E5DCCB" BorderBrush="#D1C7B7" BorderThickness="1" CornerRadius="4" Margin="2" Padding="0,6">
                                    <TextBlock Text="THỨ 3" FontSize="11" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center"/>
                                </Border>
                                <Border Background="#E5DCCB" BorderBrush="#D1C7B7" BorderThickness="1" CornerRadius="4" Margin="2" Padding="0,6">
                                    <TextBlock Text="THỨ 4" FontSize="11" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center"/>
                                </Border>
                                <Border Background="#E5DCCB" BorderBrush="#D1C7B7" BorderThickness="1" CornerRadius="4" Margin="2" Padding="0,6">
                                    <TextBlock Text="THỨ 5" FontSize="11" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center"/>
                                </Border>
                                <Border Background="#E5DCCB" BorderBrush="#D1C7B7" BorderThickness="1" CornerRadius="4" Margin="2" Padding="0,6">
                                    <TextBlock Text="THỨ 6" FontSize="11" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center"/>
                                </Border>
                                <Border Background="#D6E0D2" BorderBrush="#C2D1BC" BorderThickness="1" CornerRadius="4" Margin="2" Padding="0,6">
                                    <TextBlock Text="THỨ 7" FontSize="11" FontWeight="Bold" Foreground="#166534" HorizontalAlignment="Center"/>
                                </Border>
                                <Border Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="4" Margin="2" Padding="0,6">
                                    <TextBlock Text="CHỦ NHẬT" FontSize="11" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Center"/>
                                </Border>
                            </UniformGrid>

                            <!-- HÀNG 2: LƯỚI 42 Ô NGÀY TRONG THÁNG -->
                            <ItemsControl Grid.Row="2" ItemsSource="{Binding CalendarDays}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7" Rows="6"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="2" Padding="0" MinHeight="62" Cursor="Hand"
                                                Command="{Binding DataContext.SelectCalendarDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="DayBorder" Background="#FFFFFF" BorderBrush="#D1C7B7" BorderThickness="1" CornerRadius="6" Padding="6,4">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="*"/>
                                                            </Grid.RowDefinitions>

                                                            <!-- Số ngày -->
                                                            <Grid Grid.Row="0">
                                                                <TextBlock x:Name="DayNumText" Text="{Binding DayNumber}" FontSize="12.5" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Left"/>
                                                                <Ellipse x:Name="EventDot" Width="7" Height="7" Fill="#DC2626" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                         Visibility="{Binding HasEvents, Converter={StaticResource BoolToVis}}"/>
                                                            </Grid>

                                                            <!-- Badge sự kiện -->
                                                            <Border Grid.Row="1" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="3" 
                                                                    Margin="0,3,0,0" Padding="3,1" VerticalAlignment="Center"
                                                                    Visibility="{Binding HasEvents, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="{Binding CategoryBadgeText}" FontSize="9.5" FontWeight="Bold" Foreground="#15803D" 
                                                                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <!-- Ngày ngoài tháng -->
                                                        <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                            <Setter TargetName="DayBorder" Property="Background" Value="#F1ECE1"/>
                                                            <Setter TargetName="DayNumText" Property="Foreground" Value="#94A3B8"/>
                                                            <Setter TargetName="DayNumText" Property="FontWeight" Value="Normal"/>
                                                        </DataTrigger>
                                                        <!-- Ngày Hôm nay -->
                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                            <Setter TargetName="DayBorder" Property="BorderBrush" Value="#DC2626"/>
                                                            <Setter TargetName="DayBorder" Property="BorderThickness" Value="2"/>
                                                            <Setter TargetName="DayBorder" Property="Background" Value="#FEF2F2"/>
                                                            <Setter TargetName="DayNumText" Property="Foreground" Value="#DC2626"/>
                                                        </DataTrigger>
                                                        <!-- Ngày được chọn -->
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="DayBorder" Property="BorderBrush" Value="#8F1515"/>
                                                            <Setter TargetName="DayBorder" Property="BorderThickness" Value="2"/>
                                                            <Setter TargetName="DayBorder" Property="Background" Value="#FEF08A"/>
                                                            <Setter TargetName="DayNumText" Property="Foreground" Value="#854D0E"/>
                                                        </DataTrigger>
                                                        <!-- Di chuột qua ô ngày -->
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="DayBorder" Property="Background" Value="#F8FAFC"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- HÀNG 3: CHÚ THÍCH PHÂN LOẠI MÀU SẮC -->
                            <Border Grid.Row="3" Background="#EFE7D8" BorderBrush="#D1C7B7" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,10,0,0">
                                <WrapPanel HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                        <Ellipse Width="8" Height="8" Fill="#065F46" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Kiểm tra thể lực" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                        <Ellipse Width="8" Height="8" Fill="#0E7490" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Thi cử quân sự" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                        <Ellipse Width="8" Height="8" Fill="#15803D" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Tập luyện / Rèn luyện" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="#1D4ED8" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Hội thao / Sự kiện" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </WrapPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Border>

                <!-- ========================================================================= -->
                <!-- CỘT PHẢI: BẢNG SỰ KIỆN THEO NGÀY & FORM BIÊN TẬP CHUẨN CELANDAR.PNG -->
                <!-- ========================================================================= -->
                <Border Grid.Column="1" Background="#F5EFE4" BorderBrush="#8C7D5D" BorderThickness="1.5" CornerRadius="8" Padding="16">
                    <Grid>
                        <!-- ===================================================== -->
                        <!-- CHẾ ĐỘ 1: XEM SỰ KIỆN THEO NGÀY (IsFormVisible == False) -->
                        <!-- ===================================================== -->
                        <Grid Visibility="{Binding IsFormVisible, Converter={StaticResource InvBoolToVis}}">
                            <Grid.RowDefinitions>
                                <!-- Header ngày đã chọn -->
                                <RowDefinition Height="Auto"/>
                                <!-- Danh sách sự kiện của ngày (hoặc Empty State có Watermark) -->
                                <RowDefinition Height="*"/>
                                <!-- Nút đỏ lớn Thêm Mốc Sự Kiện Mới ở chân bảng -->
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Tiêu đề ngày chọn -->
                            <Border Grid.Row="0" Padding="0,0,0,12" BorderBrush="#DDD4C4" BorderThickness="0,0,0,1" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="📅" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedDayTitle}" FontSize="14.5" FontWeight="ExtraBold" Foreground="#0F172A" TextWrapping="Wrap"/>
                                        <TextBlock Text="Danh sách các mốc sự kiện &amp; rèn luyện" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Vùng nội dung sự kiện / Empty State -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- Danh sách các sự kiện trong ngày nếu có -->
                                    <ItemsControl ItemsSource="{Binding SelectedDayEvents}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="6" Background="#FFFFFF" BorderBrush="#D1C7B7" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Category, Priority, Status -->
                                                        <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                                                            <Border CornerRadius="3" Padding="6,2" Background="{Binding CategoryBg, Converter={StaticResource StringToBrush}}" Margin="0,0,4,2">
                                                                <TextBlock Text="{Binding Category}" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold"/>
                                                            </Border>
                                                            <Border CornerRadius="3" Padding="6,2" Background="{Binding StatusBg, Converter={StaticResource StringToBrush}}" Margin="0,0,4,2">
                                                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusFg, Converter={StaticResource StringToBrush}}" FontSize="10" FontWeight="Bold"/>
                                                            </Border>
                                                            <Border CornerRadius="3" Padding="6,2" Background="{Binding PriorityBg, Converter={StaticResource StringToBrush}}" Margin="0,0,4,2">
                                                                <TextBlock Text="{Binding Priority}" Foreground="{Binding PriorityFg, Converter={StaticResource StringToBrush}}" FontSize="10" FontWeight="Bold"/>
                                                            </Border>
                                                        </WrapPanel>

                                                        <!-- Tiêu đề -->
                                                        <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="13.5" FontWeight="ExtraBold" Foreground="#0F172A" TextWrapping="Wrap" Margin="0,0,0,4"/>

                                                        <!-- Chi tiết -->
                                                        <StackPanel Grid.Row="2" Margin="0,0,0,6">
                                                            <TextBlock Text="{Binding TargetUnit, StringFormat='Đơn vị: {0}'}" FontSize="11.5" Foreground="#334155" Margin="0,0,0,2"/>
                                                            <TextBlock Text="{Binding Location, StringFormat='Địa điểm: {0}'}" FontSize="11.5" Foreground="#334155" Margin="0,0,0,2"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                        </StackPanel>

                                                        <!-- Nút thao tác -->
                                                        <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,4,0,0">
                                                            <Button Content="✓ Hoàn Thành" Style="{StaticResource ParchmentOutlineButton}" 
                                                                    Padding="8,3" Margin="0,0,4,0" FontSize="10.5"
                                                                    Command="{Binding DataContext.ToggleCompleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                            <Button Content="✏ Sửa" Style="{StaticResource ParchmentOutlineButton}" 
                                                                    Padding="8,3" Margin="0,0,4,0" FontSize="10.5"
                                                                    Command="{Binding DataContext.OpenEditFormCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                            <Button Content="🗑" Style="{StaticResource ParchmentDangerButton}" 
                                                                    Padding="8,3" FontSize="10.5"
                                                                    Command="{Binding DataContext.DeleteEventCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </WrapPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- EMPTY STATE VỚI WATERMARK VÀ NÚT BẤM CHUẨN CELANDAR.PNG -->
                                    <Border Background="Transparent" Padding="0,30,0,30">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedDayEvents.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <!-- Watermark nền dã chiến mờ ảo -->
                                            <StackPanel Opacity="0.07" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="★" FontSize="80" Foreground="#1E293B" HorizontalAlignment="Center"/>
                                                <TextBlock Text="VÌ TỔ QUỐC" FontSize="20" FontWeight="ExtraBold" Foreground="#1E293B" HorizontalAlignment="Center"/>
                                                <TextBlock Text="VÌ NHÂN DÂN" FontSize="18" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Nội dung chính Empty State -->
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="📅" FontSize="44" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                                <TextBlock Text="Ngày này chưa có sự kiện huấn luyện nào." FontSize="13" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                                                <Button Content="➕ Thêm Sự Kiện Cho Ngày Này" Style="{StaticResource PrimaryButtonStyle}" 
                                                        FontSize="12" Padding="14,8" HorizontalAlignment="Center"
                                                        Command="{Binding AddEventForSelectedDayCommand}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Nút đỏ lớn ở chân bảng: ➕ Thêm Mốc Sự Kiện Mới -->
                            <Button Grid.Row="2" Style="{StaticResource PrimaryButtonStyle}" 
                                    Height="42" Margin="0,12,0,0" Padding="14,0" HorizontalAlignment="Stretch"
                                    Command="{Binding OpenAddFormCommand}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="➕ " FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Text="Thêm Mốc Sự Kiện Mới" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- ===================================================== -->
                        <!-- CHẾ ĐỘ 2: FORM BIÊN TẬP (IsFormVisible == True) -->
                        <!-- ===================================================== -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding IsFormVisible, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <!-- Tiêu đề Form -->
                                <TextBlock Text="{Binding FormHeader}" FontSize="14.5" FontWeight="ExtraBold" Foreground="#8F1515" Margin="0,0,0,12"/>

                                <!-- Tiêu đề sự kiện -->
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Tiêu đề mốc sự kiện / kiểm tra (*):" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" 
                                             Background="#FFFFFF" BorderBrush="#CBD5E1" Foreground="#0F172A"
                                             Height="34" VerticalContentAlignment="Center" Padding="8,0"/>
                                </StackPanel>

                                <!-- Phân loại -->
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Loại sự kiện huấn luyện (*):" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                    <ComboBox SelectedItem="{Binding EditCategory}" Height="34">
                                        <ComboBoxItem Content="Kiểm tra thể lực" IsSelected="True"/>
                                        <ComboBoxItem Content="Thi cử quân sự"/>
                                        <ComboBoxItem Content="Tập luyện / Rèn luyện"/>
                                        <ComboBoxItem Content="Hội thao / Sự kiện"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Đơn vị áp dụng -->
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Đơn vị / Đối tượng áp dụng:" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding UnitOptions}" SelectedItem="{Binding EditTargetUnit}" Height="34"/>
                                </StackPanel>

                                <!-- Thời gian bắt đầu & kết thúc -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Ngày bắt đầu:" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                        <DatePicker SelectedDate="{Binding EditStartDate}" Height="34"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Ngày kết thúc:" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                        <DatePicker SelectedDate="{Binding EditEndDate}" Height="34"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Địa điểm / Thao trường -->
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Địa điểm / Thao trường:" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditLocation, UpdateSourceTrigger=PropertyChanged}" 
                                             Background="#FFFFFF" BorderBrush="#CBD5E1" Foreground="#0F172A"
                                             Height="34" VerticalContentAlignment="Center" Padding="8,0"/>
                                </StackPanel>

                                <!-- Mức độ ưu tiên & Trạng thái -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Mức độ ưu tiên:" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding PriorityOptions}" SelectedItem="{Binding EditPriority}" Height="34"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Trạng thái:" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                        <ComboBox SelectedItem="{Binding EditStatus}" Height="34">
                                            <ComboBoxItem Content="Đang chuẩn bị" IsSelected="True"/>
                                            <ComboBoxItem Content="Đang diễn ra"/>
                                            <ComboBoxItem Content="Đã hoàn thành"/>
                                            <ComboBoxItem Content="Tạm hoãn"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <!-- Nội dung / Kế hoạch chi tiết -->
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="Nội dung, chỉ thị chi tiết:" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" 
                                             Background="#FFFFFF" BorderBrush="#CBD5E1" Foreground="#0F172A"
                                             Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="8"/>
                                </StackPanel>

                                <!-- Các nút Lưu và Hủy -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                    <Button Content="✕ Hủy" Style="{StaticResource ParchmentOutlineButton}" 
                                            Padding="14,8" Margin="0,0,8,0"
                                            Command="{Binding CloseFormCommand}"/>

                                    <Button Content="💾 Lưu Mốc Sự Kiện" Style="{StaticResource PrimaryButtonStyle}" 
                                            Padding="16,8"
                                            Command="{Binding SaveEventCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
