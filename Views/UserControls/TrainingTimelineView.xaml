<UserControl x:Class="QL_HocVien.Views.UserControls.TrainingTimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:cv="clr-namespace:QL_HocVien.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100">

    <UserControl.Resources>
        <cv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <cv:InvertedBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
    </UserControl.Resources>

    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Tiêu đề & Nút thao tác -->
                <RowDefinition Height="Auto"/>
                <!-- Thẻ thống kê KPI -->
                <RowDefinition Height="Auto"/>
                <!-- Thanh lọc -->
                <RowDefinition Height="Auto"/>
                <!-- Vùng Timeline & Form chi tiết -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HÀNG 0: TIÊU ĐỀ & NÚT THAO TÁC -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,4">
                    <TextBlock Text="LỊCH TRÌNH HUẤN LUYỆN, THI CỬ &amp; SỰ KIỆN QUÂN SỰ" 
                               FontSize="19" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap"/>
                    <TextBlock Text="Theo dõi dòng thời gian (Timeline) các mốc kiểm tra thể lực, thi cử học phần, dã ngoại rèn luyện và hội thao" 
                               FontSize="12" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Nút chuyển đổi Cuốn Lịch Tháng vs Dòng Thời Gian -->
                    <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,4"
                            Command="{Binding SwitchToCalendarViewCommand}"
                            Visibility="{Binding IsCalendarViewVisible, Converter={StaticResource InvBoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📅 " FontSize="13"/>
                            <TextBlock Text="Xem Cuốn Lịch Tháng" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,4"
                            Command="{Binding SwitchToTimelineViewCommand}"
                            Visibility="{Binding IsCalendarViewVisible, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📜 " FontSize="13"/>
                            <TextBlock Text="Dòng Thời Gian Dọc" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Content="🔄 Tải Lại Lịch" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,4"
                            Command="{Binding LoadEventsCommand}"/>
                    <Button Content="➕ Thêm Mốc Sự Kiện" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,4"
                            Command="{Binding OpenAddFormCommand}"/>
                </WrapPanel>
            </Grid>

            <!-- HÀNG 1: THẺ THỐNG KÊ KPI SỰ KIỆN -->
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- KPI 1: Tổng mốc sự kiện -->
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="14,10" Background="#FFFFFF">
                    <StackPanel>
                        <TextBlock Text="TỔNG SỐ MỐC SỰ KIỆN" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding TotalEventsCount}" FontSize="22" FontWeight="ExtraBold" Foreground="#0F172A" Margin="0,4,0,0"/>
                        <TextBlock Text="Lịch trình trong cơ sở dữ liệu" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- KPI 2: Đang diễn ra -->
                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="14,10" Background="#EFF6FF" BorderBrush="#BFDBFE">
                    <StackPanel>
                        <TextBlock Text="ĐANG DIỄN RA" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8"/>
                        <TextBlock Text="{Binding OngoingEventsCount}" FontSize="22" FontWeight="ExtraBold" Foreground="#2563EB" Margin="0,4,0,0"/>
                        <TextBlock Text="Sự kiện đang trong tiến trình" FontSize="11" Foreground="#3B82F6" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- KPI 3: Khẩn cấp / Ưu tiên cao -->
                <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}" Padding="14,10" Background="#FEF2F2" BorderBrush="#FECACA">
                    <StackPanel>
                        <TextBlock Text="KHẨN CẤP / TRỌNG ĐIỂM" FontSize="11" FontWeight="Bold" Foreground="#B91C1C"/>
                        <TextBlock Text="{Binding UrgentEventsCount}" FontSize="22" FontWeight="ExtraBold" Foreground="#DC2626" Margin="0,4,0,0"/>
                        <TextBlock Text="Ưu tiên cần tập trung chuẩn bị" FontSize="11" Foreground="#EF4444" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- KPI 4: Đã hoàn thành -->
                <Border Grid.Column="6" Style="{StaticResource CardBorderStyle}" Padding="14,10" Background="#F0FDF4" BorderBrush="#BBF7D0">
                    <StackPanel>
                        <TextBlock Text="ĐÃ HOÀN THÀNH" FontSize="11" FontWeight="Bold" Foreground="#15803D"/>
                        <TextBlock Text="{Binding CompletedEventsCount}" FontSize="22" FontWeight="ExtraBold" Foreground="#16A34A" Margin="0,4,0,0"/>
                        <TextBlock Text="Đã thực hiện xong kiểm tra / sự kiện" FontSize="11" Foreground="#22C55E" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- HÀNG 2: THANH LỌC LỊCH TRÌNH -->
            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Lọc Loại sự kiện -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Phân loại sự kiện huấn luyện:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding SelectedCategory}" Height="34"/>
                    </StackPanel>

                    <!-- Lọc Trạng thái -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Trạng thái thực hiện:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatus}" Height="34"/>
                    </StackPanel>

                    <!-- Nút Lọc -->
                    <Button Grid.Column="4" Content="Lọc Lịch Trình" Style="{StaticResource PrimaryButtonStyle}" 
                            VerticalAlignment="Bottom" Height="34" Padding="14,0"
                            Command="{Binding LoadEventsCommand}"/>

                    <!-- Nút Đặt lại -->
                    <Button Grid.Column="6" Content="Tất Cả" Style="{StaticResource SecondaryButtonStyle}" 
                            VerticalAlignment="Bottom" Height="34" Padding="14,0"
                            Command="{Binding ResetFilterCommand}"/>
                </Grid>
            </Border>

            <!-- HÀNG 3: VÙNG TIMELINE & FORM BIÊN TẬP -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <!-- Cột Danh sách Timeline -->
                    <ColumnDefinition Width="*"/>
                    <!-- Cột Form thêm / sửa (hoặc chi tiết) -->
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <!-- CỘT BÊN TRÁI 1: DÒNG THỜI GIAN DỌC (TIMELINE) -->
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,14,0"
                        Visibility="{Binding IsCalendarViewVisible, Converter={StaticResource InvBoolToVis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Events}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <!-- Cột Trục thời gian mốc ngày tháng -->
                                            <ColumnDefinition Width="110"/>
                                            <!-- Cột Đường kẻ trục dọc -->
                                            <ColumnDefinition Width="28"/>
                                            <!-- Cột Thẻ chi tiết sự kiện -->
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Mốc ngày tháng bên trái -->
                                        <StackPanel Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0">
                                            <TextBlock Text="{Binding StartDate, StringFormat={}{0:dd/MM/yyyy}}" 
                                                       FontWeight="Bold" FontSize="13" Foreground="#0F172A" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding StartDate, StringFormat={}{0:dddd}}" 
                                                       FontSize="11" Foreground="#64748B" HorizontalAlignment="Right"/>
                                        </StackPanel>

                                        <!-- Điểm mốc & Trục nối dọc -->
                                        <Grid Grid.Column="1" HorizontalAlignment="Center">
                                            <Rectangle Width="2" Fill="#CBD5E1" VerticalAlignment="Stretch" Margin="0,18,0,0"/>
                                            <Ellipse Width="14" Height="14" Fill="#0F766E" Stroke="#FFFFFF" StrokeThickness="2" VerticalAlignment="Top" Margin="0,8,0,0"/>
                                        </Grid>

                                        <!-- Thẻ nội dung sự kiện bên phải -->
                                        <Border Grid.Column="2" CornerRadius="8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Hàng 1: Huy hiệu Category, Đơn vị, Ưu tiên, Trạng thái -->
                                                <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                                                    <!-- Category Badge -->
                                                    <Border CornerRadius="4" Padding="8,3" Background="#0F766E" Margin="0,0,6,4">
                                                        <TextBlock Text="{Binding Category}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                                    </Border>

                                                    <!-- Unit Badge -->
                                                    <Border CornerRadius="4" Padding="8,3" Background="#334155" Margin="0,0,6,4">
                                                        <TextBlock Text="{Binding TargetUnit}" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                                                    </Border>

                                                    <!-- Priority Badge -->
                                                    <Border CornerRadius="4" Padding="8,3" Background="#FEE2E2" Margin="0,0,6,4">
                                                        <TextBlock Text="{Binding Priority}" Foreground="#DC2626" FontWeight="Bold" FontSize="11"/>
                                                    </Border>

                                                    <!-- Status Badge -->
                                                    <Border CornerRadius="4" Padding="8,3" Background="#DCFCE7" Margin="0,0,6,4">
                                                        <TextBlock Text="{Binding Status}" Foreground="#16A34A" FontWeight="Bold" FontSize="11"/>
                                                    </Border>
                                                </WrapPanel>

                                                <!-- Hàng 2: Tiêu đề sự kiện -->
                                                <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap" Margin="0,0,0,6"/>

                                                <!-- Hàng 3: Thời gian, Địa điểm, Ghi chú -->
                                                <StackPanel Grid.Row="2" Margin="0,0,0,10">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <TextBlock Text="⏱️ Thời gian: " FontWeight="SemiBold" FontSize="12" Foreground="#475569"/>
                                                        <TextBlock Text="{Binding StartDate, StringFormat={}{0:dd/MM/yyyy}}" FontSize="12" Foreground="#1E293B"/>
                                                        <TextBlock Text=" ➔ " FontSize="12" Foreground="#64748B"/>
                                                        <TextBlock Text="{Binding EndDate, StringFormat={}{0:dd/MM/yyyy}}" FontSize="12" Foreground="#1E293B"/>
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <TextBlock Text="📍 Địa điểm: " FontWeight="SemiBold" FontSize="12" Foreground="#475569"/>
                                                        <TextBlock Text="{Binding Location}" FontSize="12" Foreground="#1E293B"/>
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <!-- Hàng 4: Các nút hành động -->
                                                <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
                                                    <Button Content="✓ Đổi Hoàn Thành" Style="{StaticResource SecondaryButtonStyle}" 
                                                            Padding="10,4" Margin="0,0,6,0" FontSize="11"
                                                            Command="{Binding DataContext.ToggleCompleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>

                                                    <Button Content="✏️ Sửa" Style="{StaticResource SecondaryButtonStyle}" 
                                                            Padding="10,4" Margin="0,0,6,0" FontSize="11"
                                                            Command="{Binding DataContext.OpenEditFormCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>

                                                    <Button Content="🗑️ Xóa" Style="{StaticResource DangerButtonStyle}" 
                                                            Padding="10,4" FontSize="11"
                                                            Command="{Binding DataContext.DeleteEventCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </WrapPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- CỘT BÊN TRÁI 2: CUỐN LỊCH THÁNG KIỂU ĐIỆN THOẠI (PHONE-STYLE MONTHLY CALENDAR) -->
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,14,0"
                        Visibility="{Binding IsCalendarViewVisible, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Header điều hướng Tháng / Năm -->
                            <RowDefinition Height="Auto"/>
                            <!-- Tiêu đề 7 thứ trong tuần -->
                            <RowDefinition Height="Auto"/>
                            <!-- Lưới 42 ô ngày (6 tuần x 7 ngày) -->
                            <RowDefinition Height="*"/>
                            <!-- Chú thích màu sắc sự kiện -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- HÀNG 0: HEADER ĐIỀU HƯỚNG THÁNG / NĂM -->
                        <Border Grid.Row="0" Background="#F1F5F9" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Content="◀ Tháng Trước" Style="{StaticResource SecondaryButtonStyle}" 
                                            Padding="10,4" Margin="0,0,6,0"
                                            Command="{Binding PreviousMonthCommand}"/>
                                    <Button Content="Hôm Nay" Style="{StaticResource SecondaryButtonStyle}" 
                                            Padding="10,4"
                                            Command="{Binding TodayCommand}"/>
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{Binding MonthYearTitle}" 
                                           FontSize="16" FontWeight="ExtraBold" Foreground="#0F766E" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                <Button Grid.Column="2" Content="Tháng Sau ▶" Style="{StaticResource SecondaryButtonStyle}" 
                                        Padding="10,4"
                                        Command="{Binding NextMonthCommand}"/>
                            </Grid>
                        </Border>

                        <!-- HÀNG 1: TIÊU ĐỀ 7 THỨ TRONG TUẦN -->
                        <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,6">
                            <Border Background="#0F766E" CornerRadius="4" Margin="2" Padding="0,6">
                                <TextBlock Text="THỨ HAI" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                            </Border>
                            <Border Background="#0F766E" CornerRadius="4" Margin="2" Padding="0,6">
                                <TextBlock Text="THỨ BA" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                            </Border>
                            <Border Background="#0F766E" CornerRadius="4" Margin="2" Padding="0,6">
                                <TextBlock Text="THỨ TƯ" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                            </Border>
                            <Border Background="#0F766E" CornerRadius="4" Margin="2" Padding="0,6">
                                <TextBlock Text="THỨ NĂM" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                            </Border>
                            <Border Background="#0F766E" CornerRadius="4" Margin="2" Padding="0,6">
                                <TextBlock Text="THỨ SÁU" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                            </Border>
                            <Border Background="#0D5E56" CornerRadius="4" Margin="2" Padding="0,6">
                                <TextBlock Text="THỨ BẢY" FontSize="11" FontWeight="Bold" Foreground="#FEF08A" HorizontalAlignment="Center"/>
                            </Border>
                            <Border Background="#B91C1C" CornerRadius="4" Margin="2" Padding="0,6">
                                <TextBlock Text="CHỦ NHẬT" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                            </Border>
                        </UniformGrid>

                        <!-- HÀNG 2: LƯỚI 42 Ô NGÀY TRÊN CUỐN LỊCH -->
                        <ItemsControl Grid.Row="2" ItemsSource="{Binding CalendarDays}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="6" Columns="7"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Từng ô ngày trên cuốn lịch -->
                                    <Border Margin="2" CornerRadius="6" Cursor="Hand" ToolTip="{Binding FullTooltip}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FFFFFF"/>
                                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <!-- Ngày không thuộc tháng này -->
                                                    <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                        <Setter Property="Background" Value="#F8FAFC"/>
                                                        <Setter Property="Opacity" Value="0.4"/>
                                                    </DataTrigger>
                                                    <!-- Ngày được chọn -->
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#0F766E"/>
                                                        <Setter Property="BorderThickness" Value="2.5"/>
                                                        <Setter Property="Background" Value="#F0FDFA"/>
                                                    </DataTrigger>
                                                    <!-- Ngày hôm nay -->
                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" 
                                                          Command="{Binding DataContext.SelectCalendarDayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>

                                        <Grid Margin="4,3">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- Hàng số ngày & Huy hiệu Hôm nay -->
                                            <DockPanel Grid.Row="0" LastChildFill="False">
                                                <TextBlock Text="{Binding DayNumber}" DockPanel.Dock="Left"
                                                           FontSize="13" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#0F172A"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Foreground" Value="#0F766E"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <Border DockPanel.Dock="Right" CornerRadius="3" Background="#D97706" Padding="4,1" Margin="2,0,0,0"
                                                        Visibility="{Binding IsToday, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="Nay" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                            </DockPanel>

                                            <!-- Hàng ĐÁNH DẤU SỰ KIỆN TRÊN CUỐN LỊCH -->
                                            <StackPanel Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,2,0,0">
                                                <!-- Chấm tròn màu chỉ thị (Indicator dots) -->
                                                <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,2">
                                                    <Ellipse Width="7" Height="7" Fill="#DC2626" Margin="1"
                                                             Visibility="{Binding HasExamEvent, Converter={StaticResource BoolToVis}}"
                                                             ToolTip="Thi cử quân sự"/>
                                                    <Ellipse Width="7" Height="7" Fill="#0F766E" Margin="1"
                                                             Visibility="{Binding HasFitnessEvent, Converter={StaticResource BoolToVis}}"
                                                             ToolTip="Kiểm tra thể lực"/>
                                                    <Ellipse Width="7" Height="7" Fill="#16A34A" Margin="1"
                                                             Visibility="{Binding HasPracticeEvent, Converter={StaticResource BoolToVis}}"
                                                             ToolTip="Tập luyện / Rèn luyện"/>
                                                    <Ellipse Width="7" Height="7" Fill="#2563EB" Margin="1"
                                                             Visibility="{Binding HasSportsEvent, Converter={StaticResource BoolToVis}}"
                                                             ToolTip="Hội thao / Sự kiện"/>
                                                </WrapPanel>

                                                <!-- Tên sự kiện vắn tắt -->
                                                <Border CornerRadius="3" Padding="4,1" Margin="0,1,0,0"
                                                        Background="#0F766E"
                                                        Visibility="{Binding HasEvents, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding EventSummaryText}" FontSize="9" FontWeight="SemiBold" Foreground="White"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="80" HorizontalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- HÀNG 3: CHÚ THÍCH MÀU SẮC ĐÁNH DẤU SỰ KIỆN -->
                        <Border Grid.Row="3" Background="#F8FAFC" CornerRadius="6" Padding="8,6" Margin="0,8,0,0">
                            <WrapPanel HorizontalAlignment="Center">
                                <TextBlock Text="Đánh dấu ngày có sự kiện: " FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,8,0"/>

                                <Ellipse Width="8" Height="8" Fill="#DC2626" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Thi cử quân sự" FontSize="11" Foreground="#1E293B" Margin="0,0,12,0" VerticalAlignment="Center"/>

                                <Ellipse Width="8" Height="8" Fill="#0F766E" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Kiểm tra thể lực" FontSize="11" Foreground="#1E293B" Margin="0,0,12,0" VerticalAlignment="Center"/>

                                <Ellipse Width="8" Height="8" Fill="#16A34A" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Tập luyện / Rèn luyện" FontSize="11" Foreground="#1E293B" Margin="0,0,12,0" VerticalAlignment="Center"/>

                                <Ellipse Width="8" Height="8" Fill="#2563EB" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Hội thao / Sự kiện" FontSize="11" Foreground="#1E293B" VerticalAlignment="Center"/>
                            </WrapPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- CỘT BÊN PHẢI: FORM BIÊN TẬP HOẶC CHI TIẾT NGÀY ĐƯỢC CHỌN -->
                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="18">
                    <Grid>
                        <!-- 1. FORM THÊM / SỬA MỐC SỰ KIỆN (Hiển thị khi IsFormVisible == True) -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding IsFormVisible, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <!-- Tiêu đề Form -->
                                <TextBlock Text="{Binding FormHeader}" FontSize="14" FontWeight="Bold" Foreground="#0F766E" Margin="0,0,0,12"/>

                                <!-- Tiêu đề sự kiện -->
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Tiêu đề mốc sự kiện / kiểm tra (*):" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="6,0"/>
                                </StackPanel>

                                <!-- Phân loại -->
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Loại sự kiện huấn luyện (*):" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                    <ComboBox SelectedItem="{Binding EditCategory}" Height="34">
                                        <ComboBoxItem Content="Kiểm tra thể lực" IsSelected="True"/>
                                        <ComboBoxItem Content="Thi cử quân sự"/>
                                        <ComboBoxItem Content="Tập luyện / Rèn luyện"/>
                                        <ComboBoxItem Content="Hội thao / Sự kiện"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Đơn vị áp dụng -->
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Đơn vị / Đối tượng áp dụng:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding UnitOptions}" SelectedItem="{Binding EditTargetUnit}" Height="34"/>
                                </StackPanel>

                                <!-- Thời gian bắt đầu & kết thúc -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Ngày bắt đầu:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                        <DatePicker SelectedDate="{Binding EditStartDate}" Height="34"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Ngày kết thúc:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                        <DatePicker SelectedDate="{Binding EditEndDate}" Height="34"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Địa điểm / Thao trường -->
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Địa điểm / Thao trường:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditLocation, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="6,0"/>
                                </StackPanel>

                                <!-- Mức độ ưu tiên & Trạng thái -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Mức độ ưu tiên:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding PriorityOptions}" SelectedItem="{Binding EditPriority}" Height="34"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Trạng thái:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                        <ComboBox SelectedItem="{Binding EditStatus}" Height="34">
                                            <ComboBoxItem Content="Đang chuẩn bị" IsSelected="True"/>
                                            <ComboBoxItem Content="Đang diễn ra"/>
                                            <ComboBoxItem Content="Đã hoàn thành"/>
                                            <ComboBoxItem Content="Tạm hoãn"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <!-- Nội dung / Kế hoạch chi tiết -->
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="Nội dung, chỉ thị chi tiết:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" 
                                             Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="6"/>
                                </StackPanel>

                                <!-- Các nút Lưu và Hủy -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="✕ Hủy" Style="{StaticResource SecondaryButtonStyle}" 
                                            Padding="14,8" Margin="0,0,8,0"
                                            Command="{Binding CloseFormCommand}"/>

                                    <Button Content="💾 Lưu Mốc Sự Kiện" Style="{StaticResource PrimaryButtonStyle}" 
                                            Padding="16,8"
                                            Command="{Binding SaveEventCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 2. CHI TIẾT SỰ KIỆN THEO NGÀY ĐÃ CHỌN (Hiển thị khi IsFormVisible == False) -->
                        <Grid Visibility="{Binding IsFormVisible, Converter={StaticResource InvBoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Tiêu đề ngày chọn -->
                            <Border Grid.Row="0" Background="#F1F5F9" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedDayTitle}" FontSize="13" FontWeight="Bold" Foreground="#0F766E" TextWrapping="Wrap"/>
                                    <TextBlock Text="Danh sách các mốc sự kiện &amp; rèn luyện" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Danh sách sự kiện ngày chọn -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- Danh sách các sự kiện -->
                                    <ItemsControl ItemsSource="{Binding SelectedDayEvents}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="6" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Category & Trạng thái -->
                                                        <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                                                            <Border CornerRadius="3" Padding="6,2" Background="#0F766E" Margin="0,0,4,2">
                                                                <TextBlock Text="{Binding Category}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                            </Border>
                                                            <Border CornerRadius="3" Padding="6,2" Background="#DCFCE7" Margin="0,0,4,2">
                                                                <TextBlock Text="{Binding Status}" Foreground="#16A34A" FontSize="10" FontWeight="Bold"/>
                                                            </Border>
                                                            <Border CornerRadius="3" Padding="6,2" Background="#FEE2E2" Margin="0,0,4,2">
                                                                <TextBlock Text="{Binding Priority}" Foreground="#DC2626" FontSize="10" FontWeight="Bold"/>
                                                            </Border>
                                                        </WrapPanel>

                                                        <!-- Tiêu đề -->
                                                        <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap" Margin="0,0,0,4"/>

                                                        <!-- Chi tiết -->
                                                        <StackPanel Grid.Row="2" Margin="0,0,0,6">
                                                            <TextBlock Text="{Binding TargetUnit, StringFormat='Đơn vị: {0}'}" FontSize="11" Foreground="#475569"/>
                                                            <TextBlock Text="{Binding Location, StringFormat='Địa điểm: {0}'}" FontSize="11" Foreground="#475569"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                        </StackPanel>

                                                        <!-- Nút thao tác -->
                                                        <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
                                                            <Button Content="✓ Đổi Hoàn Thành" Style="{StaticResource SecondaryButtonStyle}" 
                                                                    Padding="8,2" Margin="0,0,4,0" FontSize="10"
                                                                    Command="{Binding DataContext.ToggleCompleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                            <Button Content="✏️ Sửa" Style="{StaticResource SecondaryButtonStyle}" 
                                                                    Padding="8,2" Margin="0,0,4,0" FontSize="10"
                                                                    Command="{Binding DataContext.OpenEditFormCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                            <Button Content="🗑️" Style="{StaticResource DangerButtonStyle}" 
                                                                    Padding="8,2" FontSize="10"
                                                                    Command="{Binding DataContext.DeleteEventCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </WrapPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Nếu ngày này không có sự kiện nào -->
                                    <Border Background="#F8FAFC" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14" Margin="0,4,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedDayEvents.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="☕ Ngày này chưa có sự kiện huấn luyện nào." FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                            <Button Content="➕ Thêm Sự Kiện Cho Ngày Này" Style="{StaticResource PrimaryButtonStyle}" 
                                                    FontSize="11" Padding="12,6" HorizontalAlignment="Center"
                                                    Command="{Binding AddEventForSelectedDayCommand}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Nút tạo sự kiện mới ở dưới cùng -->
                            <Button Grid.Row="2" Content="➕ Thêm Mốc Sự Kiện Mới" Style="{StaticResource PrimaryButtonStyle}" 
                                    Margin="0,10,0,0" Padding="12,6" HorizontalAlignment="Stretch"
                                    Command="{Binding OpenAddFormCommand}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
