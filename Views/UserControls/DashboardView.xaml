<UserControl x:Class="QL_HocVien.Views.UserControls.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:cv="clr-namespace:QL_HocVien.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="1200" d:DesignWidth="1200">

    <UserControl.Resources>
        <cv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <cv:StringToBrushConverter x:Key="StringToBrush"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16,20,30">
        <StackPanel>
            <!-- ==================== PHẦN 1: HEADER TRUNG TÂM CHỈ HUY ==================== -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,4">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Background="#1E3A8A" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                            <TextBlock Text="🇻🇳 TRUNG TÂM CHỈ HUY TÁC CHIẾN HUẤN LUYỆN" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Border>
                        <Border Background="#EEF2FF" CornerRadius="4" Padding="8,3" BorderBrush="#C7D2FE" BorderThickness="1">
                            <TextBlock Text="THÔNG TƯ 32/2009/TTLT-BQP-BVHTTDL" FontSize="11" FontWeight="SemiBold" Foreground="#3730A3"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="BẢNG TỔNG QUAN RÈN LUYỆN THỂ LỰC QUÂN ĐỘI" FontSize="22" FontWeight="ExtraBold" Foreground="#0F172A"/>
                    <TextBlock Text="Phân tích số liệu kiểm tra thể lực đa chiều, đánh giá chỉ tiêu thi đua và tự động kích hoạt Trợ lý Trí tuệ Nhân tạo đề xuất giáo án" 
                               FontSize="12.5" Foreground="#64748B" Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="📤 Xuất Báo Cáo &amp; Đề Xuất Excel" Style="{StaticResource SuccessButtonStyle}" Margin="0,0,8,4"
                            Command="{Binding ExportExecutiveReportCommand}" ToolTip="Xuất toàn bộ chỉ số, phân tích và phác đồ AI ra file Excel 4 sheets"/>
                    <Button Content="🔄 Làm Mới" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,4"
                            Command="{Binding LoadDashboardDataCommand}"/>
                    <Button Content="💾 Sao Lưu Toàn Viện" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,4"
                            Command="{Binding ExportAllDataCommand}"/>
                </WrapPanel>
            </Grid>

            <!-- ==================== PHẦN 2: BỘ LỌC NÂNG CAO ĐA CHIỀU ==================== -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="14" BorderBrush="#CBD5E1">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="🔍 BỘ LỌC NÂNG CAO ĐA TIÊU CHÍ" FontSize="12.5" FontWeight="Bold" Foreground="#1E3A8A"/>
                            <TextBlock Text="(Lọc tức thời theo đơn vị, lớp, đợt thi, môn rèn luyện, xếp loại và thời gian)" 
                                       FontSize="11.5" Foreground="#64748B" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Grid.Column="1" Content="🔍 Mở Rộng / Thu Gọn" Style="{StaticResource SecondaryButtonStyle}" 
                                Padding="10,4" FontSize="11" Command="{Binding ToggleFilterExpansionCommand}"/>
                    </Grid>

                    <StackPanel Visibility="{Binding IsAdvancedFilterExpanded, Converter={StaticResource BoolToVis}}">
                        <!-- Hàng lọc 1: Đơn vị, Lớp, Đợt thi, Môn học, Xếp loại -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Đơn vị -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Đơn vị / Đại đội:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding UnitOptions}" SelectedItem="{Binding SelectedUnit}" Height="32"/>
                            </StackPanel>

                            <!-- Lớp -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Cấp Lớp / Phân đội:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding ClassOptions}" SelectedItem="{Binding SelectedClass}" Height="32"/>
                            </StackPanel>

                            <!-- Đợt kiểm tra -->
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Đợt kiểm tra:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding SessionOptions}" SelectedItem="{Binding SelectedSession}" Height="32"/>
                            </StackPanel>

                            <!-- Môn kiểm tra -->
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="Nội dung môn kiểm tra:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding SubjectOptions}" SelectedItem="{Binding SelectedSubject}" 
                                          DisplayMemberPath="SubjectName" Height="32"/>
                            </StackPanel>

                            <!-- Xếp loại -->
                            <StackPanel Grid.Column="8">
                                <TextBlock Text="Xếp loại:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding GradeOptions}" SelectedItem="{Binding SelectedGrade}" Height="32"/>
                            </StackPanel>
                        </Grid>

                        <!-- Hàng lọc 2: Khung thời gian & Tìm kiếm từ khóa & Nút áp dụng -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Từ ngày -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Từ ngày kiểm tra:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <DatePicker SelectedDate="{Binding FromDate}" Height="32"/>
                            </StackPanel>

                            <!-- Đến ngày -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Đến ngày kiểm tra:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <DatePicker SelectedDate="{Binding ToDate}" Height="32"/>
                            </StackPanel>

                            <!-- Từ khóa -->
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Tìm kiếm học viên:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBoxStyle}" Height="32" 
                                         Tag="Nhập mã hoặc họ tên học viên..."/>
                            </StackPanel>

                            <!-- Nút Áp dụng -->
                            <Button Grid.Column="6" Content="🔍 Áp Dụng Lọc" Style="{StaticResource PrimaryButtonStyle}" 
                                    Height="32" Padding="16,0" VerticalAlignment="Bottom"
                                    Command="{Binding ApplyFilterCommand}"/>

                            <!-- Nút Đặt lại -->
                            <Button Grid.Column="8" Content="🔄 Đặt Lại" Style="{StaticResource SecondaryButtonStyle}" 
                                    Height="32" Padding="14,0" VerticalAlignment="Bottom"
                                    Command="{Binding ResetFilterCommand}"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ==================== PHẦN 3: 6 THẺ KPI CHỈ HUY CHIẾN LƯỢC ==================== -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <!-- KPI 1: Quân số -->
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Background="#EFF6FF" BorderBrush="#BFDBFE" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="🎖️ TỔNG QUÂN SỐ" FontSize="11" FontWeight="Bold" Foreground="#1E40AF"/>
                        <TextBlock Text="{Binding TotalCadets}" FontSize="24" FontWeight="ExtraBold" Foreground="#1E3A8A" Margin="0,4,0,0"/>
                        <TextBlock FontSize="11" Foreground="#3B82F6" Margin="0,2,0,0">
                            <Run Text="{Binding TotalUnitsCount}"/> <Run Text="đơn vị • "/>
                            <Run Text="{Binding TotalClassesCount}"/> <Run Text="lớp"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- KPI 2: Tổng số môn đã thi, kiểm tra -->
                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Background="#F0FDF4" BorderBrush="#BBF7D0" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="📚 TỔNG SỐ MÔN ĐÃ THI, KT" FontSize="11" FontWeight="Bold" Foreground="#166534"/>
                        <TextBlock Text="{Binding TotalTestedSubjects}" FontSize="24" FontWeight="ExtraBold" Foreground="#15803D" Margin="0,4,0,0"/>
                        <TextBlock FontSize="11" Foreground="#22C55E" Margin="0,2,0,0">
                            <Run Text="{Binding TotalExamRecords}"/> <Run Text="lượt bài thi / KT"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- KPI 3: Tỷ lệ đạt chuẩn TT32 -->
                <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}" Background="#F0FDFA" BorderBrush="#99F6E4" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="🎯 TỶ LỆ ĐẠT CHUẨN" FontSize="11" FontWeight="Bold" Foreground="#0F766E"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding PassRate, StringFormat={}{0:F1}}" FontSize="24" FontWeight="ExtraBold" Foreground="#0F766E"/>
                            <TextBlock Text="%" FontSize="15" FontWeight="Bold" Foreground="#0F766E" VerticalAlignment="Bottom" Margin="1,0,0,2"/>
                        </StackPanel>
                        <TextBlock Text="{Binding OverallRatingLabel}" FontSize="10.5" FontWeight="Bold" 
                                   Foreground="{Binding OverallRatingColor, Converter={StaticResource StringToBrush}}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- KPI 4: Tỷ lệ Giỏi & Xuất sắc -->
                <Border Grid.Column="6" Style="{StaticResource CardBorderStyle}" Background="#FEFCE8" BorderBrush="#FEF08A" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="⭐ GIỎI &amp; XUẤT SẮC" FontSize="11" FontWeight="Bold" Foreground="#854D0E"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding EliteRate, StringFormat={}{0:F1}}" FontSize="24" FontWeight="ExtraBold" Foreground="#A16207"/>
                            <TextBlock Text="%" FontSize="15" FontWeight="Bold" Foreground="#A16207" VerticalAlignment="Bottom" Margin="1,0,0,2"/>
                        </StackPanel>
                        <TextBlock FontSize="11" Foreground="#CA8A04" Margin="0,2,0,0">
                            <Run Text="{Binding ExcellentCount}"/> <Run Text="XS • "/>
                            <Run Text="{Binding GoodCount}"/> <Run Text="Giỏi"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- KPI 5: Chưa đạt chuẩn -->
                <Border Grid.Column="8" Style="{StaticResource CardBorderStyle}" Background="#FEF2F2" BorderBrush="#FECACA" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="⚠️ CHƯA ĐẠT CHUẨN" FontSize="11" FontWeight="Bold" Foreground="#991B1B"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding FailCount}" FontSize="24" FontWeight="ExtraBold" Foreground="#DC2626"/>
                            <TextBlock Text=" lượt" FontSize="13" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Bottom" Margin="2,0,0,3"/>
                        </StackPanel>
                        <TextBlock FontSize="11" Foreground="#EF4444" Margin="0,2,0,0">
                            <Run Text="{Binding FailRate, StringFormat={}{0:F1}% tổng số}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- KPI 6: Sự kiện huấn luyện gần nhất -->
                <Border Grid.Column="10" Style="{StaticResource CardBorderStyle}" Background="#F5F3FF" BorderBrush="#DDD6FE" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="📅 SỰ KIỆN GẦN NHẤT" FontSize="11" FontWeight="Bold" Foreground="#6D28D9"/>
                        <TextBlock Text="{Binding UpcomingEventTitle}" FontSize="13" FontWeight="Bold" Foreground="#5B21B6" 
                                   Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding UpcomingEventTitle}"/>
                        <TextBlock Text="{Binding UpcomingEventTime}" FontSize="11" Foreground="#7C3AED" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ==================== PHẦN 4: HỆ THỐNG BIỂU ĐỒ TRỰC QUAN HÓA ==================== -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="0.85*"/>
                </Grid.ColumnDefinitions>

                <!-- CỘT TRÁI: BIỂU ĐỒ PHÂN BỐ XẾP LOẠI & THI ĐUA ĐƠN VỊ -->
                <StackPanel Grid.Column="0">
                    <!-- Biểu đồ 1: Thanh Phân Bố Xếp Loại Đa Đoạn -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14" Padding="16">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="📊 Phân Bố Xếp Loại Thể Lực Chuẩn TT 32/2009" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="{Binding TotalExamRecords, StringFormat='Tổng số: {0} lượt'}" 
                                           HorizontalAlignment="Right" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                            </Grid>

                            <!-- Thanh trực quan tỷ lệ đạt chuẩn -->
                            <Border Height="22" CornerRadius="11" Background="#FEE2E2" SnapsToDevicePixels="True" Margin="0,0,0,12" ClipToBounds="True">
                                <Grid>
                                    <ProgressBar Value="{Binding PassRate, Mode=OneWay}" Maximum="100" Height="22" 
                                                 Background="Transparent" Foreground="#16A34A" BorderThickness="0"/>
                                    <TextBlock Text="{Binding PassRate, StringFormat='TỔNG TỶ LỆ ĐẠT CHUẨN: {0:F1}%'}" 
                                               FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Chú giải phân bổ kèm số lượng và tỷ lệ % -->
                            <UniformGrid Columns="4" Margin="0,0,0,4">
                                <Border Background="#F5F3FF" CornerRadius="6" Padding="8,6" Margin="0,0,6,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="#7C3AED" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Xuất sắc" FontSize="11" FontWeight="Bold" Foreground="#5B21B6"/>
                                        </StackPanel>
                                        <TextBlock FontSize="12" FontWeight="ExtraBold" Foreground="#7C3AED" Margin="0,2,0,0">
                                            <Run Text="{Binding ExcellentCount}"/> <Run Text="lượt" FontSize="10" FontWeight="Normal"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Border Background="#EFF6FF" CornerRadius="6" Padding="8,6" Margin="0,0,6,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="#2563EB" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Giỏi" FontSize="11" FontWeight="Bold" Foreground="#1E40AF"/>
                                        </StackPanel>
                                        <TextBlock FontSize="12" FontWeight="ExtraBold" Foreground="#2563EB" Margin="0,2,0,0">
                                            <Run Text="{Binding GoodCount}"/> <Run Text="lượt" FontSize="10" FontWeight="Normal"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Border Background="#F0FDF4" CornerRadius="6" Padding="8,6" Margin="0,0,6,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="#16A34A" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Khá / Đạt" FontSize="11" FontWeight="Bold" Foreground="#166534"/>
                                        </StackPanel>
                                        <TextBlock FontSize="12" FontWeight="ExtraBold" Foreground="#16A34A" Margin="0,2,0,0">
                                            <Run Text="{Binding PassCount}"/> <Run Text="lượt" FontSize="10" FontWeight="Normal"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Border Background="#FEF2F2" CornerRadius="6" Padding="8,6">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="#DC2626" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Chưa đạt" FontSize="11" FontWeight="Bold" Foreground="#991B1B"/>
                                        </StackPanel>
                                        <TextBlock FontSize="12" FontWeight="ExtraBold" Foreground="#DC2626" Margin="0,2,0,0">
                                            <Run Text="{Binding FailCount}"/> <Run Text="lượt" FontSize="10" FontWeight="Normal"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Biểu đồ 2: Bảng Xếp Hạng Thi Đua Các Đại Đội -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="🏆 Xếp Hạng Thi Đua Giữa Các Đơn Vị" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Đo lường theo Tỷ lệ Đạt &amp; Tỷ lệ Giỏi/XS môn tín chỉ" HorizontalAlignment="Right" FontSize="11.5" Foreground="#64748B"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding UnitLeaderboard}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Huy hiệu xếp hạng -->
                                            <TextBlock Grid.Column="0" Text="{Binding RankMedal}" FontSize="14" FontWeight="Bold" 
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                            <!-- Tên đơn vị -->
                                            <TextBlock Grid.Column="1" Text="{Binding UnitName}" FontSize="12.5" FontWeight="Bold" 
                                                       Foreground="#1E293B" VerticalAlignment="Center"/>

                                            <!-- Thanh ngang biểu thị tỷ lệ Đạt -->
                                            <Grid Grid.Column="2" VerticalAlignment="Center" Margin="6,0,10,0">
                                                <ProgressBar Value="{Binding PassRate, Mode=OneWay}" Maximum="100" Height="10" 
                                                             Foreground="{Binding StatusColor, Converter={StaticResource StringToBrush}}" Background="#E2E8F0" BorderThickness="0"/>
                                            </Grid>

                                            <!-- Tỷ lệ Đạt % -->
                                            <TextBlock Grid.Column="3" Text="{Binding PassRate, StringFormat='{}{0:F1}% đạt'}" 
                                                       FontSize="12" FontWeight="Bold" Foreground="{Binding StatusColor, Converter={StaticResource StringToBrush}}" 
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                            <!-- Nhãn xếp loại -->
                                            <Border Grid.Column="4" Background="{Binding StatusBackground, Converter={StaticResource StringToBrush}}" CornerRadius="4" 
                                                    Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding EvaluationStatus}" FontSize="10.5" FontWeight="Bold" 
                                                           Foreground="{Binding StatusColor, Converter={StaticResource StringToBrush}}"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- CỘT PHẢI: TRỌNG TÂM TRONG THÁNG (SỰ KIỆN XẾP TỪ GẦN ĐẾN XA) -->
                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="📌 Trọng Tâm Trong Tháng" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="{Binding MonthlyFocusEvents.Count, StringFormat='{}{0} sự kiện'}" 
                                       HorizontalAlignment="Right" FontSize="11.5" FontWeight="Bold" Foreground="#1E40AF"/>
                        </Grid>

                        <TextBlock Text="Các mốc sự kiện kiểm tra, thi cử, rèn luyện trong tháng xếp từ ngày gần nhất đến xa nhất:" 
                                   FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="330">
                            <ItemsControl ItemsSource="{Binding MonthlyFocusEvents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC" CornerRadius="8" Padding="10,8" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="54"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Badge Ngày tháng -->
                                                <Border Grid.Column="0" Background="#EFF6FF" CornerRadius="6" Padding="2,4" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding StartDate, StringFormat='{}{0:dd/MM}'}" FontWeight="ExtraBold" FontSize="12.5" Foreground="#1E40AF" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="{Binding StartDate, StringFormat='{}{0:yyyy}'}" FontSize="9.5" Foreground="#3B82F6" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Thông tin sự kiện -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold" Foreground="#0F172A" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                                    <TextBlock FontSize="10.5" Foreground="#64748B" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Category}"/> <Run Text=" • "/>
                                                        <Run Text="{Binding TargetUnit}"/> <Run Text=" • "/>
                                                        <Run Text="{Binding Location}"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <!-- Badge Trạng thái -->
                                                <Border Grid.Column="2" Background="#F1F5F9" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding Status}" FontSize="9.5" FontWeight="Bold" Foreground="#475569"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ==================== PHẦN 5: BẢNG PHÂN TÍCH CHUYÊN SÂU 4 TABS ==================== -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="0" BorderBrush="#CBD5E1">
                <TabControl BorderThickness="0" Background="Transparent" SelectedIndex="{Binding SelectedTabIndex}">

                    <!-- ==================== TAB 1: HỌC VIÊN CHƯA THI, KIỂM TRA ==================== -->
                    <TabItem Header="⚠️  Học Viên Chưa Thi, Kiểm Tra" FontSize="13" FontWeight="Bold" Padding="18,10">
                        <Border Padding="14">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Danh Sách Học Viên Chưa Thi, Chưa Kiểm Tra Môn Học / Thể Lực" 
                                                   FontSize="14" FontWeight="Bold" Foreground="#D97706"/>
                                        <TextBlock Text="Thống kê tự động các học viên chưa hoàn thành môn học tín chỉ hoặc các bài kiểm tra thể lực theo quy định:" 
                                                   FontSize="11.5" Foreground="#64748B"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding UntestedCadets.Count, StringFormat='{}{0} học viên cần kiểm tra bù'}" 
                                               HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Foreground="#D97706"/>
                                </Grid>

                                <DataGrid ItemsSource="{Binding UntestedCadets}" Style="{StaticResource MilitaryDataGridStyle}" 
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MaxHeight="500">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Mã HV" Binding="{Binding CadetCode}" FontWeight="Bold" Width="100"/>
                                        <DataGridTextColumn Header="Họ và Tên" Binding="{Binding FullName}" Width="160"/>
                                        <DataGridTextColumn Header="Cấp Bậc" Binding="{Binding Rank}" Width="90"/>
                                        <DataGridTextColumn Header="Đơn Vị" Binding="{Binding Unit}" Width="100"/>
                                        <DataGridTextColumn Header="Lớp" Binding="{Binding ClassName}" Width="120"/>
                                        <DataGridTextColumn Header="Phân Loại" Binding="{Binding ExamType}" Width="130"/>
                                        <DataGridTextColumn Header="Nội Dung / Môn Còn Thiếu" Binding="{Binding MissingSubjects}" FontWeight="Bold" Foreground="#DC2626" Width="220"/>
                                        <DataGridTextColumn Header="Số Lượng Còn Thiếu" Binding="{Binding MissingCount, StringFormat='{}{0} môn/bài'}" Width="130"/>
                                        <DataGridTextColumn Header="Trạng Thái" Binding="{Binding Status}" FontWeight="Bold" Foreground="#D97706" Width="130"/>
                                        <DataGridTextColumn Header="Biện Pháp / Ghi Chú" Binding="{Binding Note}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </TabItem>

                    <!-- ==================== TAB 2: HỌC VIÊN CẦN BỒI DƯỠNG BỔ SUNG ==================== -->
                    <TabItem Header="⚠️  Học Viên Chưa Đạt Chuẩn" FontSize="13" FontWeight="Bold" Padding="18,10">
                        <Border Padding="14">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Danh Sách Học Viên Chưa Đạt - Đưa Vào Diện Rèn Luyện Phụ Đạo" 
                                                   FontSize="14" FontWeight="Bold" Foreground="#DC2626"/>
                                        <TextBlock Text="Trích xuất tự động các trường hợp trượt chuẩn Thông tư 32 theo bộ lọc đang chọn:" 
                                                   FontSize="11.5" Foreground="#64748B"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding FailedRecords.Count, StringFormat='{}{0} trường hợp cần bồi dưỡng'}" 
                                               HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Foreground="#DC2626"/>
                                </Grid>

                                <DataGrid ItemsSource="{Binding FailedRecords}" Style="{StaticResource MilitaryDataGridStyle}" 
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MaxHeight="500">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Mã HV" Binding="{Binding Cadet.CadetCode}" FontWeight="Bold" Width="110"/>
                                        <DataGridTextColumn Header="Họ và Tên" Binding="{Binding Cadet.FullName}" Width="170"/>
                                        <DataGridTextColumn Header="Đơn Vị" Binding="{Binding Cadet.Unit}" Width="110"/>
                                        <DataGridTextColumn Header="Lớp" Binding="{Binding Cadet.ClassName}" Width="150"/>
                                        <DataGridTextColumn Header="Nội Dung Chưa Đạt" Binding="{Binding Subject.SubjectName}" FontWeight="Bold" Foreground="#DC2626" Width="170"/>
                                        <DataGridTextColumn Header="Thành Tích" Binding="{Binding ScoreValue}" FontWeight="Bold" Width="100"/>
                                        <DataGridTextColumn Header="Xếp Loại" Binding="{Binding Grade}" Foreground="#DC2626" FontWeight="Bold" Width="100"/>
                                        <DataGridTextColumn Header="Đợt Thi" Binding="{Binding ExamSession}" Width="120"/>
                                        <DataGridTextColumn Header="Ngày Kiểm Tra" Binding="{Binding ExamDate, StringFormat='dd/MM/yyyy'}" Width="110"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </TabItem>

                    <!-- ==================== TAB 3: BẢNG VÀNG VINH DANH HỌC VIÊN ==================== -->
                    <TabItem Header="🏆  Bảng Vàng Biểu Dương" FontSize="13" FontWeight="Bold" Padding="18,10">
                        <Border Padding="14">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Bảng Vàng Biểu Dương Học Viên Rèn Luyện Thể Lực Xuất Sắc &amp; Kiện Tướng" 
                                                   FontSize="14" FontWeight="Bold" Foreground="#15803D"/>
                                        <TextBlock Text="Tôn vinh các tấm gương rèn luyện thể lực tiêu biểu, làm nòng cốt tham gia hội thao quân sự:" 
                                                   FontSize="11.5" Foreground="#64748B"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding HonoredCadets.Count, StringFormat='{}{0} gương mặt tiêu biểu'}" 
                                               HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Foreground="#15803D"/>
                                </Grid>

                                <DataGrid ItemsSource="{Binding HonoredCadets}" Style="{StaticResource MilitaryDataGridStyle}" 
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MaxHeight="500">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Mã HV" Binding="{Binding CadetCode}" FontWeight="Bold" Width="110"/>
                                        <DataGridTextColumn Header="Họ và Tên" Binding="{Binding FullName}" FontWeight="Bold" Width="170"/>
                                        <DataGridTextColumn Header="Cấp Bậc" Binding="{Binding Rank}" Width="100"/>
                                        <DataGridTextColumn Header="Đơn Vị" Binding="{Binding Unit}" Width="110"/>
                                        <DataGridTextColumn Header="Lớp" Binding="{Binding ClassName}" Width="150"/>
                                        <DataGridTextColumn Header="Danh Hiệu Vinh Danh" Binding="{Binding HonorTitle}" FontWeight="Bold" Foreground="#15803D" Width="180"/>
                                        <DataGridTextColumn Header="Lượt Đạt XS" Binding="{Binding ExcellentExams}" FontWeight="Bold" Foreground="#7C3AED" Width="100"/>
                                        <DataGridTextColumn Header="Môn Thế Mạnh" Binding="{Binding BestSubject}" Width="160"/>
                                        <DataGridTextColumn Header="Kỷ Lục Điểm" Binding="{Binding BestScore}" FontWeight="Bold" Width="110"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </TabItem>

                    <!-- ==================== TAB 4: CHỈ TIÊU & THI ĐUA ĐƠN VỊ ==================== -->
                    <TabItem Header="📊  Chỉ Tiêu &amp; Thi Đua Đơn Vị" FontSize="13" FontWeight="Bold" Padding="18,10">
                        <Border Padding="14">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Bảng Tổng Hợp Chỉ Tiêu Rèn Luyện Thể Lực Theo Đại Đội" 
                                                   FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                                        <TextBlock Text="Đánh giá kết quả hoàn thành nhiệm vụ huấn luyện thể lực quân sự năm học:" 
                                                   FontSize="11.5" Foreground="#64748B"/>
                                    </StackPanel>
                                </Grid>

                                <DataGrid ItemsSource="{Binding UnitLeaderboard}" Style="{StaticResource MilitaryDataGridStyle}" 
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MaxHeight="500">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Thứ Hạng" Binding="{Binding RankMedal}" FontWeight="Bold" Width="90"/>
                                        <DataGridTextColumn Header="Đơn Vị / Đại Đội" Binding="{Binding UnitName}" FontWeight="Bold" Width="170"/>
                                        <DataGridTextColumn Header="Quân Số" Binding="{Binding TotalCadets}" Width="100"/>
                                        <DataGridTextColumn Header="Lượt Kiểm Tra" Binding="{Binding TotalExamRecords}" Width="120"/>
                                        <DataGridTextColumn Header="Số Lượt Đạt" Binding="{Binding PassedCount}" Foreground="#16A34A" FontWeight="Bold" Width="110"/>
                                        <DataGridTextColumn Header="Tỷ Lệ Đạt (%)" Binding="{Binding PassRate, StringFormat={}{0:F1}%}" FontWeight="Bold" Foreground="{Binding StatusColor}" Width="120"/>
                                        <DataGridTextColumn Header="Tỷ Lệ Giỏi (%)" Binding="{Binding EliteRate, StringFormat={}{0:F1}%}" FontWeight="Bold" Foreground="#2563EB" Width="120"/>
                                        <DataGridTextColumn Header="Xếp Loại Thi Đua" Binding="{Binding EvaluationStatus}" FontWeight="Bold" Foreground="{Binding StatusColor}" Width="150"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </TabItem>
                </TabControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
