<UserControl x:Class="QL_HocVien.Views.UserControls.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:cv="clr-namespace:QL_HocVien.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="1100" d:DesignWidth="1280">

    <UserControl.Resources>
        <cv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <cv:StringToBrushConverter x:Key="StringToBrush"/>

        <!-- Style cho Button Hành Động Header Đỏ Viền Vàng -->
        <Style x:Key="HeaderPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#9B1818" Offset="0"/>
                        <GradientStop Color="#750E0E" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#E5A93C"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B91C1C"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FDE047"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#5C0A0A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style cho Button Hành Động Header Xanh Ô-liu Viền Đồng -->
        <Style x:Key="HeaderSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1B2B1B"/>
            <Setter Property="BorderBrush" Value="#8C7D46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A3D2A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFE17A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#121F12"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,12,18,24">
        <StackPanel>
            <!-- ==================== PHẦN 1: HEADER TRUNG TÂM CHỈ HUY TÁC CHIẾN ==================== -->
            <Grid Margin="0,0,0,14" MinHeight="115">
                <!-- Dải tranh nghệ thuật cờ sao vàng, chiến sĩ, tháp canh, "QUYẾT THẮNG" ở góc phải chuẩn DemoUI -->
                <Image Source="/Assets/Images/flag_soldier_banner.png" 
                       HorizontalAlignment="Right" VerticalAlignment="Top" 
                       Height="78" Stretch="Uniform" Opacity="0.88" 
                       Visibility="{Binding IsCombatMode, Converter={StaticResource BoolToVis}}" 
                       IsHitTestVisible="False" Margin="0,-4,-10,0"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Khối thông tin chỉ huy bên trái -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <!-- 2 Huy hiệu danh hiệu quân sự & học thuật -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="11,3" Margin="0,0,8,0">
                                <TextBlock Text="TRUNG TÂM QUẢN TRỊ &amp; PHÂN TÍCH HỌC THUẬT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="11,3">
                                <TextBlock Text="HỆ THỐNG ĐÀO TẠO TÍN CHỈ QUÂN SỰ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </StackPanel>

                        <!-- Tiêu đề lớn Vàng Ánh Kim chuẩn DemoUI -->
                        <TextBlock Text="BẢNG TỔNG QUAN HỌC VỤ TOÀN VIỆN" 
                                   FontSize="18.5" FontWeight="ExtraBold" Foreground="{DynamicResource TextPrimaryBrush}" 
                                   TextWrapping="NoWrap">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="5" ShadowDepth="1" Opacity="0.8"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="Phân tích điểm trung bình GPA toàn diện, tiến độ tích lũy tín chỉ, theo dõi cảnh báo học vụ và xếp hạng thi đua đào tạo" 
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- 3 Nút tác chiến bên phải căn chuẩn theo DemoUI -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,4">
                        <Button Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,0" Height="32" Padding="10,0"
                                Command="{Binding ExportExecutiveReportCommand}" ToolTip="Xuất toàn bộ chỉ số học vụ, xếp hạng thi đua, phân tích học phần và cảnh báo ra file Excel 6 sheets">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄 " Foreground="#FFE17A" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="XUẤT BÁO CÁO HỌC VỤ (6 SHEETS)" FontWeight="Bold" FontSize="10.5" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Height="32" Padding="8,0"
                                Command="{Binding LoadDashboardDataCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄 " Foreground="#FFE17A" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="LÀM MỚI" FontWeight="Bold" FontSize="10.5" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Height="32" Padding="8,0"
                                Command="{Binding ExportAllDataCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋 " Foreground="#FFE17A" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="SAO LƯU TOÀN VIỆN" FontWeight="Bold" FontSize="10.5" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ==================== PHẦN 2: BỘ LỌC NÂNG CAO ĐA CHIỀU ==================== -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,14" Padding="14,12">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="🔍 BỘ LỌC NÂNG CAO HỌC VỤ &amp; TÍN CHỈ" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="(Lọc tức thời theo đơn vị, lớp, học kỳ, học phần tín chỉ, xếp loại và tình trạng môn)" 
                                       FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Grid.Column="1" Content="^ Mở Rộng / Thu Gọn" Style="{StaticResource SecondaryButtonStyle}" 
                                Padding="10,4" FontSize="11" Height="28" Command="{Binding ToggleFilterExpansionCommand}"/>
                    </Grid>

                    <StackPanel Visibility="{Binding IsAdvancedFilterExpanded, Converter={StaticResource BoolToVis}}">
                        <!-- Hàng lọc 1: Đơn vị, Lớp, Học kỳ, Học phần, Xếp loại -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1.15*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1.15*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Đơn vị -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Đơn vị / Đại đội:" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding UnitOptions}" SelectedItem="{Binding SelectedUnit}" Height="32"/>
                            </StackPanel>

                            <!-- Lớp -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Cấp Lớp / Phân đội:" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding ClassOptions}" SelectedItem="{Binding SelectedClass}" Height="32"/>
                            </StackPanel>

                            <!-- Học kỳ -->
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Học kỳ / Đợt thi:" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding SessionOptions}" SelectedItem="{Binding SelectedSession}" Height="32"/>
                            </StackPanel>

                            <!-- Môn tín chỉ -->
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="Học phần tín chỉ:" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding CreditSubjectOptions}" SelectedItem="{Binding SelectedCreditSubject}" 
                                          DisplayMemberPath="SubjectName" Height="32"/>
                            </StackPanel>

                            <!-- Xếp loại -->
                            <StackPanel Grid.Column="8">
                                <TextBlock Text="Xếp loại học lực:" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding GradeOptions}" SelectedItem="{Binding SelectedGrade}" Height="32"/>
                            </StackPanel>
                        </Grid>

                        <!-- Hàng lọc 2: Tình trạng môn, Tìm kiếm học viên & Nút tác chiến -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="2.2*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Tình trạng môn -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tình trạng môn / tín chỉ:" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" Height="32"/>
                            </StackPanel>

                            <!-- Tìm kiếm từ khóa -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Tìm kiếm học viên:" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <Grid>
                                    <TextBox x:Name="TxtSearch" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             Height="32" Padding="8,0" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="Nhập họ tên, mã học viên..." Foreground="#7C8D76" FontStyle="Italic" FontSize="11.5"
                                               VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>

                            <!-- Nút Áp dụng -->
                            <Button Grid.Column="4" Content="🔍 ÁP DỤNG LỌC" Style="{StaticResource PrimaryButtonStyle}" 
                                    Height="32" Padding="18,0" VerticalAlignment="Bottom"
                                    Command="{Binding ApplyFilterCommand}"/>

                            <!-- Nút Đặt lại -->
                            <Button Grid.Column="6" Content="🔄 ĐẶT LẠI" Style="{StaticResource SecondaryButtonStyle}" 
                                    Height="32" Padding="14,0" VerticalAlignment="Bottom"
                                    Command="{Binding ResetFilterCommand}"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ==================== PHẦN 3: 6 THẺ KPI CHỈ HUY CHIẾN LƯỢC CÓ WATERMARK ==================== -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="1.15*"/>
                </Grid.ColumnDefinitions>

                <!-- KPI 1: Quân số (Watermark Chiến sĩ) -->
                <Border Grid.Column="0" Background="{DynamicResource KpiCardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="11,8">
                    <Grid>
                        <!-- Hình mờ Chiến sĩ đứng nghiêm -->
                        <Image Source="/Assets/Images/card_watermark_cadets.png" 
                               HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                               Width="65" Height="50" Opacity="0.4" IsHitTestVisible="False" Margin="0,0,2,2"/>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👤 " Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text="TỔNG QUÂN SỐ" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding TotalCadets}" FontSize="28" FontWeight="ExtraBold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
                            <TextBlock FontSize="10.5" Foreground="#A3A899" Margin="0,2,0,0">
                                <Run Text="{Binding TotalUnitsCount}"/> <Run Text="đơn vị • "/>
                                <Run Text="{Binding TotalClassesCount}"/> <Run Text="lớp"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- KPI 2: Học phần tín chỉ (Watermark Nguyệt quế) -->
                <Border Grid.Column="2" Background="{DynamicResource SuccessCardBackgroundBrush}" BorderBrush="{DynamicResource SuccessCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="11,8">
                    <Grid>
                        <Image Source="/Assets/Images/card_watermark_wreath.png" 
                               HorizontalAlignment="Right" VerticalAlignment="Center" 
                               Width="55" Height="50" Opacity="0.35" IsHitTestVisible="False" Margin="0,0,4,0"/>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📚 " Foreground="{DynamicResource SuccessCardForegroundBrush}" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text="HỌC PHẦN TÍN CHỈ" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource SuccessCardForegroundBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding TotalCreditSubjects}" FontSize="28" FontWeight="ExtraBold" Foreground="{DynamicResource SuccessCardForegroundBrush}" Margin="0,2,0,0"/>
                            <TextBlock FontSize="10.5" Foreground="{DynamicResource SuccessCardForegroundBrush}" Margin="0,2,0,0">
                                <Run Text="{Binding TotalCreditScores}"/> <Run Text="lượt điểm tích lũy"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- KPI 3: Điểm trung bình toàn viện (GPA) (Watermark Sao & Nguyệt quế) -->
                <Border Grid.Column="4" Background="{DynamicResource SuccessCardBackgroundBrush}" BorderBrush="{DynamicResource SuccessCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="11,8">
                    <Grid>
                        <Image Source="/Assets/Images/card_watermark_wreath.png" 
                               HorizontalAlignment="Right" VerticalAlignment="Center" 
                               Width="55" Height="50" Opacity="0.45" IsHitTestVisible="False" Margin="0,0,4,0"/>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎓 " Foreground="{DynamicResource SuccessCardForegroundBrush}" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text="ĐIỂM TRUNG BÌNH (GPA)" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource SuccessCardForegroundBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding AverageGpa, StringFormat={}{0:F2}}" FontSize="28" FontWeight="ExtraBold" Foreground="{DynamicResource SuccessCardForegroundBrush}"/>
                                <TextBlock Text=" / 10" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource SuccessCardForegroundBrush}" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                            </StackPanel>
                            <TextBlock Text="{Binding OverallRatingLabel}" FontSize="10.5" FontWeight="Bold" 
                                       Foreground="{DynamicResource SuccessCardForegroundBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- KPI 4: Tỷ lệ đạt chuẩn tốt nghiệp / tích lũy -->
                <Border Grid.Column="6" Background="{DynamicResource SuccessCardBackgroundBrush}" BorderBrush="{DynamicResource SuccessCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="11,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎯 " Foreground="{DynamicResource SuccessCardForegroundBrush}" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="ĐẠT CHUẨN TÍCH LŨY" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource SuccessCardForegroundBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding GraduationReadinessRate, StringFormat={}{0:F1}}" FontSize="28" FontWeight="ExtraBold" Foreground="{DynamicResource SuccessCardForegroundBrush}"/>
                            <TextBlock Text="%" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource SuccessCardForegroundBrush}" VerticalAlignment="Bottom" Margin="1,0,0,4"/>
                        </StackPanel>
                        <TextBlock FontSize="10.5" Foreground="{DynamicResource SuccessCardForegroundBrush}" Margin="0,2,0,0">
                            <Run Text="{Binding CompletedCadetsCount}"/> <Run Text="/"/> <Run Text="{Binding TotalCadets}"/> <Run Text="đ/c hoàn thành"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- KPI 5: Tỷ lệ Giỏi & Khá -->
                <Border Grid.Column="8" Background="{DynamicResource WarningCardBackgroundBrush}" BorderBrush="{DynamicResource WarningCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="11,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="★ " Foreground="{DynamicResource WarningCardForegroundBrush}" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="HỌC LỰC KHÁ &amp; GIỎI" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource WarningCardForegroundBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding EliteRate, StringFormat={}{0:F1}}" FontSize="28" FontWeight="ExtraBold" Foreground="{DynamicResource WarningCardForegroundBrush}"/>
                            <TextBlock Text="%" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource WarningCardForegroundBrush}" VerticalAlignment="Bottom" Margin="1,0,0,4"/>
                        </StackPanel>
                        <TextBlock FontSize="10.5" Foreground="{DynamicResource WarningCardForegroundBrush}" Margin="0,2,0,0">
                            <Run Text="{Binding ExcellentCount}"/> <Run Text="XS • "/>
                            <Run Text="{Binding GoodCount}"/> <Run Text="Khá"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- KPI 6: Cảnh báo học vụ & Nợ môn (Watermark Cành nguyệt quế đỏ) -->
                <Border Grid.Column="10" Background="{DynamicResource DangerCardBackgroundBrush}" BorderBrush="{DynamicResource DangerCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="11,8">
                    <Grid>
                        <!-- Hình mờ Cành nguyệt quế đỏ -->
                        <Image Source="/Assets/Images/card_watermark_laurel.png" 
                               HorizontalAlignment="Right" VerticalAlignment="Center" 
                               Width="50" Height="50" Opacity="0.32" IsHitTestVisible="False" Margin="0,0,4,0"/>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠️ " Foreground="{DynamicResource DangerCardForegroundBrush}" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text="CẢNH BÁO NỢ MÔN" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource DangerCardForegroundBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding WarningCount}" FontSize="28" FontWeight="ExtraBold" Foreground="{DynamicResource DangerCardForegroundBrush}"/>
                                <TextBlock Text=" đ/c" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource DangerCardForegroundBrush}" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                            </StackPanel>
                            <TextBlock FontSize="10.5" Foreground="{DynamicResource DangerCardForegroundBrush}" Margin="0,2,0,0">
                                <Run Text="{Binding FailCount}"/> <Run Text="học viên điểm Yếu"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== PHẦN 4: HỆ THỐNG BIỂU ĐỒ TRỰC QUAN HÓA & TRỌNG TÂM ==================== -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="0.85*"/>
                </Grid.ColumnDefinitions>

                <!-- CỘT TRÁI: BIỂU ĐỒ PHÂN BỐ XẾP LOẠI & THI ĐUA ĐƠN VỊ -->
                <StackPanel Grid.Column="0">
                    <!-- Biểu đồ 1: Thanh Phân Bố Xếp Loại Học Lực & Tích Lũy Tín Chỉ -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,12" Padding="16,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📊 " Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="Bold"/>
                                    <TextBlock Text="PHÂN BỐ XẾP LOẠI HỌC LỰC &amp; TÍCH LŨY TÍN CHỈ" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding TotalCreditScores, StringFormat='Tổng số: {0} lượt điểm'}" 
                                           HorizontalAlignment="Right" FontSize="11.5" Foreground="#CBD5E1" FontWeight="SemiBold"/>
                            </Grid>

                            <!-- Thanh trực quan tỷ lệ đạt chuẩn: Xanh đặc & Khaki vàng chuẩn DemoUI -->
                            <Border Height="24" CornerRadius="4" Background="#F5E5A4" SnapsToDevicePixels="True" Margin="0,2,0,12" ClipToBounds="True">
                                <Grid>
                                    <ProgressBar Value="{Binding PassRate, Mode=OneWay}" Maximum="100" Height="24" 
                                                 Background="Transparent" Foreground="#139D4B" BorderThickness="0"/>
                                    <TextBlock Text="{Binding PassRate, StringFormat='TỔNG TỶ LỆ QUA MÔN TÍCH LŨY: {0:F1}%'}" 
                                               FontSize="11.5" FontWeight="ExtraBold" Foreground="#FFFFFF" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.7"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <!-- 4 Thẻ Phân Bổ: Xuất Sắc (Tím), Giỏi (Lam), Khá / TB (Lục), Yếu / Nợ (Đỏ) -->
                            <UniformGrid Columns="4" Margin="0,0,0,2">
                                <!-- Xuất sắc -->
                                <Border Background="#ECE0FD" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,8,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="★ " Foreground="#7C3AED" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Text="Xuất sắc (≥ 9.0)" FontSize="11.5" FontWeight="Bold" Foreground="#5B21B6"/>
                                        </StackPanel>
                                        <TextBlock FontSize="13" FontWeight="ExtraBold" Foreground="#7C3AED" Margin="0,4,0,0">
                                            <Run Text="{Binding ExcellentCount}"/> <Run Text="lượt" FontSize="10" FontWeight="Normal" Foreground="#6B7280"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Giỏi -->
                                <Border Background="#DBEAFE" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,8,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🏅 " Foreground="#2563EB" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Text="Giỏi (8.0 - 8.9)" FontSize="11.5" FontWeight="Bold" Foreground="#1E40AF"/>
                                        </StackPanel>
                                        <TextBlock FontSize="13" FontWeight="ExtraBold" Foreground="#2563EB" Margin="0,4,0,0">
                                            <Run Text="{Binding GoodCount}"/> <Run Text="lượt" FontSize="10" FontWeight="Normal" Foreground="#6B7280"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Khá / Đạt -->
                                <Border Background="#DCFCE7" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,8,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="✔ " Foreground="#16A34A" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Text="Khá &amp; TB (≥ 5.0)" FontSize="11.5" FontWeight="Bold" Foreground="#166534"/>
                                        </StackPanel>
                                        <TextBlock FontSize="13" FontWeight="ExtraBold" Foreground="#16A34A" Margin="0,4,0,0">
                                            <Run Text="{Binding PassCount}"/> <Run Text="lượt" FontSize="10" FontWeight="Normal" Foreground="#6B7280"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Yếu / Trượt -->
                                <Border Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="✖ " Foreground="#DC2626" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Text="Yếu / Nợ môn" FontSize="11.5" FontWeight="Bold" Foreground="#991B1B"/>
                                        </StackPanel>
                                        <TextBlock FontSize="13" FontWeight="ExtraBold" Foreground="#DC2626" Margin="0,4,0,0">
                                            <Run Text="{Binding FailCount}"/> <Run Text="lượt" FontSize="10" FontWeight="Normal" Foreground="#6B7280"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Biểu đồ 2: Bảng Xếp Hạng Thi Đua Giữa Các Đơn Vị Chuẩn DemoUI -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🏆 " Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="Bold"/>
                                    <TextBlock Text="XẾP HẠNG THI ĐUA HỌC VỤ ĐƠN VỊ" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="Đo lường theo Điểm TB (GPA) &amp; Tỷ lệ Đạt chuẩn học phần" HorizontalAlignment="Right" FontSize="11" Foreground="#94A3B8"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding UnitLeaderboard}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="75"/>
                                                <ColumnDefinition Width="105"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Huy hiệu thi đua: 🥇 cho Top 1, 🥈 cho Top 2 -->
                                            <TextBlock Grid.Column="0" Text="{Binding RankMedal}" FontFamily="Segoe UI Emoji" FontSize="15" Foreground="#FFE17A" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                            <!-- Tên đơn vị -->
                                            <TextBlock Grid.Column="1" Text="{Binding UnitName}" FontSize="12.5" FontWeight="Bold" 
                                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                                            <!-- Thanh ngang biểu thị tỷ lệ Đạt -->
                                            <Grid Grid.Column="2" VerticalAlignment="Center" Margin="6,0,10,0">
                                                <ProgressBar Value="{Binding PassRate, Mode=OneWay}" Maximum="100" Height="12" 
                                                             Foreground="{Binding StatusColor, Converter={StaticResource StringToBrush}}" 
                                                             Background="#1C2D1E" BorderThickness="0"/>
                                            </Grid>

                                            <!-- Điểm trung bình GPA -->
                                            <TextBlock Grid.Column="3" Text="{Binding AverageGpa, StringFormat='GPA: {0:F2}'}" 
                                                       FontSize="11.5" FontWeight="Bold" 
                                                       Foreground="{DynamicResource AccentBrush}" 
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                            <!-- Tỷ lệ Đạt % -->
                                            <TextBlock Grid.Column="4" Text="{Binding PassRate, StringFormat='{}{0:F1}% đạt'}" 
                                                       FontSize="11.5" FontWeight="Bold" 
                                                       Foreground="{Binding StatusColor, Converter={StaticResource StringToBrush}}" 
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                            <!-- Nhãn xếp loại chuẩn DemoUI -->
                                            <Border Grid.Column="5" Background="{Binding StatusBackground, Converter={StaticResource StringToBrush}}" 
                                                    BorderBrush="{Binding StatusColor, Converter={StaticResource StringToBrush}}"
                                                    BorderThickness="1" CornerRadius="4" 
                                                    Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding EvaluationStatus}" FontSize="10" FontWeight="Bold" 
                                                           Foreground="{Binding StatusColor, Converter={StaticResource StringToBrush}}"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- CỘT PHẢI: TRỌNG TÂM TRONG THÁNG (NỀN GIẤY KAKI KHÍ CHẤT QUÂN SỰ) -->
                <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🎯 " Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="Bold"/>
                                <TextBlock Text="TRỌNG TÂM TRONG THÁNG" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding MonthlyFocusEvents.Count, StringFormat='{}{0} sự kiện'}" 
                                       HorizontalAlignment="Right" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                        </Grid>

                        <TextBlock Text="Các mốc sự kiện kiểm tra, thi cử, rèn luyện trong tháng xếp từ ngày gần nhất đến xa nhất:" 
                                   FontSize="11" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="340">
                            <ItemsControl ItemsSource="{Binding MonthlyFocusEvents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Thẻ sự kiện nền giấy kaki, chữ mực tối chuẩn DemoUI -->
                                        <Border Background="{DynamicResource TimelineCardBackgroundBrush}" CornerRadius="5" Padding="7,5" Margin="0,0,0,6" BorderBrush="{DynamicResource TimelineCardBorderBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="54"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Badge Ngày tháng khối tối viền vàng -->
                                                <Border Grid.Column="0" Background="{DynamicResource TimelineFilterBackgroundBrush}" BorderBrush="{DynamicResource TimelineFilterBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="2,3" VerticalAlignment="Center" Margin="0,0,7,0">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding StartDate, StringFormat='{}{0:dd/MM}'}" FontWeight="ExtraBold" FontSize="11.5" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="{Binding StartDate, StringFormat='{}{0:yyyy}'}" FontSize="9" Foreground="#A3A899" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Thông tin sự kiện chữ mực tối -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,5,0">
                                                    <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                                    <TextBlock FontSize="10" Foreground="#4B5842" Margin="0,1,0,0" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Category}"/> <Run Text=" • "/>
                                                        <Run Text="{Binding TargetUnit}"/> <Run Text=" • "/>
                                                        <Run Text="{Binding Location}"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <!-- Badge Trạng thái thẻ kaki tối -->
                                                <Border Grid.Column="2" Background="#C2B488" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding Status}" FontSize="9.5" FontWeight="Bold" Foreground="#182012"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ==================== PHẦN 5: BẢNG PHÂN TÍCH CHUYÊN SÂU 4 TABS HỌC THUẬT ==================== -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="0">
                <TabControl BorderThickness="0" Background="Transparent" SelectedIndex="{Binding SelectedTabIndex}">

                    <!-- ==================== TAB 1: BẢNG VÀNG VINH DANH TOP GPA ==================== -->
                    <TabItem Header="🏆  Bảng Vàng Danh Dự (Top GPA)" Style="{StaticResource TabHeaderStyle}">
                        <Border Padding="14">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Bảng Vàng Biểu Dương Học Viên Có Điểm GPA &amp; Tích Lũy Tín Chỉ Dẫn Đầu" 
                                                   FontSize="14" FontWeight="Bold" Foreground="#22C55E"/>
                                        <TextBlock Text="Tôn vinh các học viên có thành tích học tập xuất sắc, tích lũy vượt chuẩn và xếp loại học lực Giỏi/Xuất sắc:" 
                                                   FontSize="11.5" Foreground="#CBD5E1"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding HonoredCadets.Count, StringFormat='{}{0} gương mặt tiêu biểu'}" 
                                               HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Foreground="#22C55E"/>
                                </Grid>

                                <DataGrid ItemsSource="{Binding HonoredCadets}" Style="{StaticResource MilitaryDataGridStyle}" 
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MaxHeight="500">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Mã HV" Binding="{Binding CadetCode}" FontWeight="Bold" Width="100"/>
                                        <DataGridTextColumn Header="Họ và Tên" Binding="{Binding FullName}" FontWeight="Bold" Width="170"/>
                                        <DataGridTextColumn Header="Cấp Bậc" Binding="{Binding Rank}" Width="90"/>
                                        <DataGridTextColumn Header="Đơn Vị" Binding="{Binding Unit}" Width="100"/>
                                        <DataGridTextColumn Header="Lớp" Binding="{Binding ClassName}" Width="120"/>
                                        <DataGridTextColumn Header="Điểm GPA" Binding="{Binding Gpa, StringFormat='{}{0:F2}'}" FontWeight="ExtraBold" Foreground="#10B981" Width="100"/>
                                        <DataGridTextColumn Header="Tín Chỉ Đạt" Binding="{Binding TotalCreditsEarned, StringFormat='{}{0:F1} TC'}" FontWeight="Bold" Width="105"/>
                                        <DataGridTextColumn Header="Danh Hiệu Vinh Danh" Binding="{Binding HonorTitle}" FontWeight="Bold" Foreground="#22C55E" Width="180"/>
                                        <DataGridTextColumn Header="Môn Đạt XS" Binding="{Binding ExcellentExams, StringFormat='{}{0} môn'}" FontWeight="Bold" Foreground="#A855F7" Width="100"/>
                                        <DataGridTextColumn Header="Học Phần Tiêu Biểu" Binding="{Binding BestSubject}" Width="180"/>
                                        <DataGridTextColumn Header="Điểm Cao Nhất" Binding="{Binding BestScore}" FontWeight="Bold" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </TabItem>

                    <!-- ==================== TAB 2: CẢNH BÁO HỌC VỤ & NỢ TÍN CHỈ ==================== -->
                    <TabItem Header="⚠️  Cảnh Báo Học Vụ &amp; Nợ Môn" Style="{StaticResource TabHeaderStyle}">
                        <Border Padding="14">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Danh Sách Cảnh Báo Học Vụ, Nợ Học Phần &amp; Điểm GPA Thấp Cần Phụ Đạo" 
                                                   FontSize="14" FontWeight="Bold" Foreground="#EF4444"/>
                                        <TextBlock Text="Hệ thống tự động phát hiện học viên có GPA dưới chuẩn hoặc còn nợ môn tín chỉ để chỉ huy đơn vị kịp thời xử lý:" 
                                                   FontSize="11.5" Foreground="#CBD5E1"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding AcademicWarnings.Count, StringFormat='{}{0} đồng chí cần theo dõi'}" 
                                               HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Foreground="#EF4444"/>
                                </Grid>

                                <DataGrid ItemsSource="{Binding AcademicWarnings}" Style="{StaticResource MilitaryDataGridStyle}" 
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MaxHeight="500">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Mã HV" Binding="{Binding CadetCode}" FontWeight="Bold" Width="95"/>
                                        <DataGridTextColumn Header="Họ và Tên" Binding="{Binding FullName}" Width="160"/>
                                        <DataGridTextColumn Header="Cấp Bậc" Binding="{Binding Rank}" Width="85"/>
                                        <DataGridTextColumn Header="Đơn Vị" Binding="{Binding Unit}" Width="95"/>
                                        <DataGridTextColumn Header="Lớp" Binding="{Binding ClassName}" Width="110"/>
                                        <DataGridTextColumn Header="Điểm GPA" Binding="{Binding Gpa, StringFormat='{}{0:F2}'}" FontWeight="ExtraBold" Foreground="#EF4444" Width="85"/>
                                        <DataGridTextColumn Header="Nợ/Thiếu Môn" Binding="{Binding FailedSubjectsCount, StringFormat='{}{0} môn'}" FontWeight="Bold" Foreground="#EF4444" Width="105"/>
                                        <DataGridTextColumn Header="Chi Tiết Môn Nợ / Thiếu" Binding="{Binding FailedSubjectsDisplay}" Foreground="#EF4444" Width="200"/>
                                        <DataGridTextColumn Header="Lý Do Cảnh Báo" Binding="{Binding WarningReason}" FontWeight="SemiBold" Width="170"/>
                                        <DataGridTextColumn Header="Mức Độ Cảnh Báo" Binding="{Binding WarningSeverity}" FontWeight="Bold" Foreground="#F59E0B" Width="190"/>
                                        <DataGridTextColumn Header="Biện Pháp Khắc Phục" Binding="{Binding ActionPlan}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </TabItem>

                    <!-- ==================== TAB 3: HIỆU SUẤT TỪNG HỌC PHẦN TÍN CHỈ ==================== -->
                    <TabItem Header="📊  Phân Tích Môn Học Tín Chỉ" Style="{StaticResource TabHeaderStyle}">
                        <Border Padding="14">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Bảng Phân Tích Chất Lượng &amp; Hiệu Suất Từng Học Phần Đào Tạo Tín Chỉ" 
                                                   FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="Đo lường phổ điểm, tỷ lệ qua môn, tỷ lệ giỏi xuất sắc và mức độ khó của từng bộ môn tín chỉ:" 
                                                   FontSize="11.5" Foreground="#CBD5E1"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SubjectPerformances.Count, StringFormat='{}{0} môn học'}" 
                                               HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                </Grid>

                                <DataGrid ItemsSource="{Binding SubjectPerformances}" Style="{StaticResource MilitaryDataGridStyle}" 
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MaxHeight="500">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Mã Môn" Binding="{Binding SubjectCode}" FontWeight="Bold" Width="95"/>
                                        <DataGridTextColumn Header="Tên Học Phần" Binding="{Binding SubjectName}" FontWeight="Bold" Width="210"/>
                                        <DataGridTextColumn Header="Số TC" Binding="{Binding Credits, StringFormat='{}{0:F1}'}" Width="70"/>
                                        <DataGridTextColumn Header="Hình Thức Đánh Giá" Binding="{Binding AssessmentType}" Width="150"/>
                                        <DataGridTextColumn Header="Điểm TB Môn" Binding="{Binding AverageScore, StringFormat='{}{0:F2}'}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Width="105"/>
                                        <DataGridTextColumn Header="Lượt Học Viên" Binding="{Binding TotalTested}" Width="105"/>
                                        <DataGridTextColumn Header="Lượt Đạt" Binding="{Binding PassedCount}" Foreground="#22C55E" FontWeight="Bold" Width="90"/>
                                        <DataGridTextColumn Header="Tỷ Lệ Đạt (%)" Binding="{Binding PassRate, StringFormat='{}{0:F1}%'}" FontWeight="Bold" Foreground="#10B981" Width="110"/>
                                        <DataGridTextColumn Header="Tỷ Lệ Giỏi (%)" Binding="{Binding EliteRate, StringFormat='{}{0:F1}%'}" FontWeight="Bold" Foreground="#3B82F6" Width="110"/>
                                        <DataGridTextColumn Header="Đánh Giá Phổ Điểm" Binding="{Binding DifficultyLevel}" FontWeight="SemiBold" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </TabItem>

                    <!-- ==================== TAB 4: THI ĐUA ĐƠN VỊ & CẤP LỚP ==================== -->
                    <TabItem Header="🎖️  Thi Đua Đơn Vị &amp; Cấp Lớp" Style="{StaticResource TabHeaderStyle}">
                        <Border Padding="14">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Bảng Tổng Hợp Chỉ Tiêu Thi Đua Học Thuật Toàn Viện Theo Đơn Vị &amp; Cấp Lớp" 
                                                   FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Xếp hạng học vụ dựa trên Điểm GPA trung bình, tỷ lệ hoàn thành tín chỉ và tỷ lệ sinh viên Giỏi/Xuất sắc:" 
                                                   FontSize="11.5" Foreground="#CBD5E1"/>
                                    </StackPanel>
                                </Grid>

                                <DataGrid ItemsSource="{Binding UnitLeaderboard}" Style="{StaticResource MilitaryDataGridStyle}" 
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MaxHeight="500">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Thứ Hạng" Binding="{Binding RankMedal}" FontWeight="Bold" Width="85"/>
                                        <DataGridTextColumn Header="Đơn Vị / Đại Đội" Binding="{Binding UnitName}" FontWeight="Bold" Width="170"/>
                                        <DataGridTextColumn Header="Quân Số" Binding="{Binding TotalCadets}" Width="95"/>
                                        <DataGridTextColumn Header="Lượt Điểm" Binding="{Binding TotalExamRecords}" Width="100"/>
                                        <DataGridTextColumn Header="Điểm TB (GPA)" Binding="{Binding AverageGpa, StringFormat='{}{0:F2}'}" FontWeight="ExtraBold" Foreground="{DynamicResource AccentBrush}" Width="120"/>
                                        <DataGridTextColumn Header="Lượt Đạt" Binding="{Binding PassedCount}" Foreground="#22C55E" FontWeight="Bold" Width="95"/>
                                        <DataGridTextColumn Header="Tỷ Lệ Đạt (%)" Binding="{Binding PassRate, StringFormat='{}{0:F1}%'}" FontWeight="Bold" Foreground="{Binding StatusColor}" Width="115"/>
                                        <DataGridTextColumn Header="Tỷ Lệ Giỏi (%)" Binding="{Binding EliteRate, StringFormat='{}{0:F1}%'}" FontWeight="Bold" Foreground="#3B82F6" Width="115"/>
                                        <DataGridTextColumn Header="Xếp Loại Thi Đua" Binding="{Binding EvaluationStatus}" FontWeight="Bold" Foreground="{Binding StatusColor}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </TabItem>
                </TabControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
