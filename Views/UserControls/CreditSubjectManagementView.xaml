<UserControl x:Class="QL_HocVien.Views.UserControls.CreditSubjectManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local_cv="clr-namespace:QL_HocVien.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100">

    <UserControl.Resources>
        <local_cv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local_cv:StringToBrushConverter x:Key="StringToBrush"/>
    </UserControl.Resources>

    <Border Padding="20">
        <Grid>
            <!-- NỘI DUNG CHÍNH -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- HEADER & ACTION BUTTONS -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="QUẢN LÝ MÔN HỌC &amp; ĐIỂM HỌC PHẦN TÍN CHỈ" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Hệ thống tính điểm trung bình tích lũy (GPA) theo trọng số tín chỉ và hình thức kiểm tra/thi" 
                                   FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="➕ Thêm Môn Tín Chỉ" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                                Command="{Binding OpenAddSubjectFormCommand}"/>
                        <Button Content="✏️ Nhập Điểm Học Viên" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                                Command="{Binding OpenAddScoreFormCommand}"/>
                        <Button Content="📥 Xuất Báo Cáo Excel" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ExportToExcelCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- 4 THẺ CHỈ SỐ NHANH (SUMMARY KPI CARDS) -->
                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Thẻ 1: Tổng số học viên -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Background="#EFF6FF" BorderBrush="#BFDBFE" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="👨‍✈️ QUÂN SỐ THEO DÕI" FontSize="11" FontWeight="Bold" Foreground="#1E40AF"/>
                            <TextBlock Text="{Binding TotalStudentsCount}" FontSize="22" FontWeight="ExtraBold" Foreground="#1E3A8A" Margin="0,4,0,0"/>
                            <TextBlock Text="Học viên có dữ liệu" FontSize="11" Foreground="#3B82F6" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Thẻ 2: Tổng môn học tín chỉ -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Background="#F0FDF4" BorderBrush="#BBF7D0" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="📚 MÔN HỌC TÍN CHỈ" FontSize="11" FontWeight="Bold" Foreground="#166534"/>
                            <TextBlock Text="{Binding TotalSubjectsCount}" FontSize="22" FontWeight="ExtraBold" Foreground="#15803D" Margin="0,4,0,0"/>
                            <TextBlock Text="Môn đang giảng dạy" FontSize="11" Foreground="#22C55E" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Thẻ 3: Điểm TB chung toàn đơn vị -->
                    <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}" Background="#FEFCE8" BorderBrush="#FEF08A" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="🎯 ĐIỂM TB TOÀN ĐƠN VỊ" FontSize="11" FontWeight="Bold" Foreground="#854D0E"/>
                            <TextBlock Text="{Binding AverageOverallGpa, StringFormat='{}{0:F2}'}" FontSize="22" FontWeight="ExtraBold" Foreground="#A16207" Margin="0,4,0,0"/>
                            <TextBlock Text="Thang điểm 10 tích lũy" FontSize="11" Foreground="#CA8A04" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Thẻ 4: Số học viên Xuất sắc -->
                    <Border Grid.Column="6" Style="{StaticResource CardBorderStyle}" Background="#F5F3FF" BorderBrush="#DDD6FE" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="⭐ HỌC LỰC XUẤT SẮC" FontSize="11" FontWeight="Bold" Foreground="#6D28D9"/>
                            <TextBlock Text="{Binding ExcellentStudentsCount}" FontSize="22" FontWeight="ExtraBold" Foreground="#5B21B6" Margin="0,4,0,0"/>
                            <TextBlock Text="GPA &gt;= 8.5 điểm" FontSize="11" Foreground="#7C3AED" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- NỘI DUNG 2 TABS -->
                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="0" BorderBrush="#CBD5E1">
                    <TabControl BorderThickness="0" Background="Transparent" SelectedIndex="{Binding SelectedTabIndex}">

                        <!-- ==================== TAB 1: BẢNG ĐIỂM TÍN CHỈ & ĐIỂM TB HỌC VIÊN ==================== -->
                        <TabItem Header="📊  Bảng Điểm Tín Chỉ &amp; Điểm TB (GPA)" FontSize="13" FontWeight="Bold" Padding="16,10">
                            <Grid Margin="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- THANH TÌM KIẾM & BỘ LỌC -->
                                <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,0,0,14" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Lọc Đơn vị -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Đơn vị / Đại đội:" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding UnitOptions}" SelectedItem="{Binding SelectedUnit}" Height="34"/>
                                        </StackPanel>

                                        <!-- Lọc Lớp -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Lớp học viên:" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding ClassOptions}" SelectedItem="{Binding SelectedClass}" Height="34"/>
                                        </StackPanel>

                                        <!-- Tìm kiếm -->
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Tìm kiếm học viên:" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" Height="34" 
                                                     VerticalContentAlignment="Center" Style="{StaticResource ModernTextBoxStyle}"
                                                     Tag="Nhập họ tên hoặc mã học viên..."/>
                                        </StackPanel>

                                        <!-- Nút Áp dụng Lọc -->
                                        <Button Grid.Column="6" Content="🔍 Lọc" Style="{StaticResource PrimaryButtonStyle}" 
                                                Height="34" VerticalAlignment="Bottom" Padding="14,0"
                                                Command="{Binding FilterCommand}"/>

                                        <!-- Nút Đặt lại -->
                                        <Button Grid.Column="8" Content="🔄 Đặt Lại" Style="{StaticResource SecondaryButtonStyle}" 
                                                Height="34" VerticalAlignment="Bottom" Padding="12,0"
                                                Command="{Binding ResetFilterCommand}"/>
                                    </Grid>
                                </Border>

                                <!-- DATAGRID HIỂN THỊ HỌC VIÊN & ĐIỂM TB -->
                                <DataGrid Grid.Row="1" ItemsSource="{Binding CadetSummaries}"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          CanUserAddRows="False" SelectionMode="Single"
                                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                          Background="White" RowHeight="40">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Mã HV" Binding="{Binding CadetCode}" Width="90">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Foreground" Value="#1E3A8A"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="Họ Và Tên" Binding="{Binding FullName}" Width="160">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Foreground" Value="#0F172A"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="Cấp Bậc" Binding="{Binding Rank}" Width="80">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="Đơn Vị" Binding="{Binding Unit}" Width="100">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="Lớp" Binding="{Binding ClassName}" Width="100">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="Môn Đã Học" Binding="{Binding TotalSubjectsCompleted, StringFormat='{}{0} môn'}" Width="110">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="Tổng Tín Chỉ" Binding="{Binding TotalCreditsEarned, StringFormat='{}{0} TC'}" Width="100">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Foreground" Value="#475569"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- CỘT ĐIỂM TB (GPA) NỔI BẬT THEO CÔNG THỨC TRỌNG SỐ TÍN CHỈ -->
                                        <DataGridTemplateColumn Header="ĐIỂM TB (GPA)" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding RatingBackground, Converter={StaticResource StringToBrush}}" 
                                                            CornerRadius="6" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Gpa, StringFormat='{}{0:F2}'}" 
                                                                   FontWeight="ExtraBold" FontSize="13.5" 
                                                                   Foreground="{Binding RatingColor, Converter={StaticResource StringToBrush}}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- XẾP LOẠI HỌC LỰC -->
                                        <DataGridTemplateColumn Header="XẾP LOẠI" Width="110">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding RatingBackground, Converter={StaticResource StringToBrush}}" 
                                                            CornerRadius="4" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding AcademicRating}" FontSize="11.5" FontWeight="Bold" 
                                                                   Foreground="{Binding RatingColor, Converter={StaticResource StringToBrush}}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- THAO TÁC -->
                                        <DataGridTemplateColumn Header="Thao Tác" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="✏️ Nhập điểm" Style="{StaticResource SecondaryButtonStyle}" 
                                                            Padding="6,2" FontSize="11"
                                                            Command="{Binding DataContext.OpenAddScoreFormCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <!-- ==================== TAB 2: QUẢN LÝ DANH MỤC MÔN HỌC TÍN CHỈ ==================== -->
                        <TabItem Header="📚  Danh Mục Môn Học Tín Chỉ" FontSize="13" FontWeight="Bold" Padding="16,10">
                            <Grid Margin="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock Text="Danh sách các môn học phân bổ tín chỉ và hình thức kiểm tra/thi:" 
                                               FontSize="13" Foreground="#475569" VerticalAlignment="Center"/>
                                    <Button Content="➕ Thêm Môn Mới" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right"
                                            Command="{Binding OpenAddSubjectFormCommand}"/>
                                </Grid>

                                <DataGrid Grid.Row="1" ItemsSource="{Binding Subjects}"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          CanUserAddRows="False" SelectionMode="Single"
                                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                          Background="White" RowHeight="42">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Mã Môn" Binding="{Binding SubjectCode}" Width="100">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Foreground" Value="#1E3A8A"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="Tên Môn Học" Binding="{Binding SubjectName}" Width="200">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Foreground" Value="#0F172A"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTemplateColumn Header="Số Tín Chỉ" Width="110">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="#EFF6FF" CornerRadius="4" Padding="8,3" HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding Credits, StringFormat='{}{0} Tín chỉ'}" FontWeight="Bold" Foreground="#1E40AF"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Dạng Đánh Giá" Width="170">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="#F0FDF4" CornerRadius="4" Padding="8,3" HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding AssessmentType}" FontWeight="SemiBold" Foreground="#166534"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="Mô Tả / Ghi Chú" Binding="{Binding Description}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#64748B"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTemplateColumn Header="Hành Động" Width="130">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Button Content="✏️ Sửa" Style="{StaticResource SecondaryButtonStyle}" 
                                                                Padding="6,2" Margin="0,0,6,0" FontSize="11"
                                                                Command="{Binding DataContext.OpenEditSubjectFormCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Content="🗑️" Style="{StaticResource DangerButtonStyle}" 
                                                                Padding="6,2" FontSize="11" ToolTip="Xóa môn học"
                                                                Command="{Binding DataContext.DeleteSubjectCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>

            <!-- ==================== MODAL FORM: THÊM / SỬA MÔN HỌC TÍN CHỈ ==================== -->
            <Grid Background="#80000000" Visibility="{Binding IsSubjectFormVisible, Converter={StaticResource BoolToVis}}">
                <Border Background="White" CornerRadius="10" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Padding="24" Effect="{StaticResource ShadowEffect}">
                    <StackPanel>
                        <TextBlock Text="THÔNG TIN MÔN HỌC TÍN CHỈ" 
                                   FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,16"/>

                        <!-- Mã môn -->
                        <TextBlock Text="Mã môn học:*" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SubjectCode, UpdateSourceTrigger=PropertyChanged}" Height="34" 
                                 Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>

                        <!-- Tên môn -->
                        <TextBlock Text="Tên môn học:*" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SubjectName, UpdateSourceTrigger=PropertyChanged}" Height="34" 
                                 Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>

                        <!-- Số tín chỉ & Dạng đánh giá -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Số tín chỉ:*" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Credits, UpdateSourceTrigger=PropertyChanged}" Height="34" 
                                         Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Dạng kiểm tra/thi:*" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding AssessmentTypes}" SelectedItem="{Binding AssessmentType}" Height="34"/>
                            </StackPanel>
                        </Grid>

                        <!-- Mô tả -->
                        <TextBlock Text="Mô tả / Ghi chú:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SubjectDescription, UpdateSourceTrigger=PropertyChanged}" Height="60" 
                                 TextWrapping="Wrap" AcceptsReturn="True" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,16"/>

                        <!-- Nút Lưu & Hủy -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="Hủy Bỏ" Style="{StaticResource SecondaryButtonStyle}" Height="36"
                                    Command="{Binding CloseSubjectFormCommand}"/>
                            <Button Grid.Column="2" Content="Lưu Môn Học" Style="{StaticResource PrimaryButtonStyle}" Height="36"
                                    Command="{Binding SaveSubjectFormCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ==================== MODAL FORM: NHẬP / SỬA ĐIỂM HỌC VIÊN ==================== -->
            <Grid Background="#80000000" Visibility="{Binding IsScoreFormVisible, Converter={StaticResource BoolToVis}}">
                <Border Background="White" CornerRadius="10" Width="520" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Padding="24" Effect="{StaticResource ShadowEffect}">
                    <StackPanel>
                        <TextBlock Text="NHẬP ĐIỂM HỌC PHẦN TÍN CHỈ" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,16"/>

                        <!-- Chọn học viên -->
                        <TextBlock Text="Học viên:*" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding AllCadets}" SelectedItem="{Binding SelectedCadetForScore}" 
                                  DisplayMemberPath="FullName" Height="34" Margin="0,0,0,12"/>

                        <!-- Chọn môn học -->
                        <TextBlock Text="Môn học tín chỉ:*" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Subjects}" SelectedItem="{Binding SelectedSubjectForScore}" 
                                  DisplayMemberPath="SubjectName" Height="34" Margin="0,0,0,12"/>

                        <!-- Điểm KTTX & Điểm Thi & Điểm Tổng Kết -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Điểm KTTX:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding InputRegularScore, UpdateSourceTrigger=PropertyChanged}" Height="34" 
                                         Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Điểm Thi:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding InputExamScore, UpdateSourceTrigger=PropertyChanged}" Height="34" 
                                         Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Điểm Tổng Kết:*" FontSize="12" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding InputFinalScore, UpdateSourceTrigger=PropertyChanged}" Height="34" 
                                         FontWeight="Bold" Foreground="#1E3A8A" Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Đợt thi & Ngày thi -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Học kỳ / Đợt thi:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding InputExamSession, UpdateSourceTrigger=PropertyChanged}" Height="34" 
                                         Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Ngày kiểm tra/thi:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <DatePicker SelectedDate="{Binding InputExamDate}" Height="34"/>
                            </StackPanel>
                        </Grid>

                        <!-- Ghi chú -->
                        <TextBlock Text="Ghi chú:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding InputScoreNotes, UpdateSourceTrigger=PropertyChanged}" Height="46" 
                                 Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,16"/>

                        <!-- Nút Lưu & Hủy -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="Đóng" Style="{StaticResource SecondaryButtonStyle}" Height="36"
                                    Command="{Binding CloseScoreFormCommand}"/>
                            <Button Grid.Column="2" Content="Lưu Điểm" Style="{StaticResource PrimaryButtonStyle}" Height="36"
                                    Command="{Binding SaveScoreFormCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>