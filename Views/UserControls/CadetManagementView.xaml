<UserControl x:Class="QL_HocVien.Views.UserControls.CadetManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local_cv="clr-namespace:QL_HocVien.Converters"
             xmlns:components="clr-namespace:QL_HocVien.Views.Components"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="950">
    <Border Padding="24">
        <Grid>
            <!-- Vùng nội dung chính -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. Tiêu đề trang (Page Header) -->
            <StackPanel Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,10">
                <TextBlock Text="QUẢN LÝ DANH SÁCH HỌC VIÊN" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="Tra cứu, cập nhật thông tin học viên, đặt lại mật khẩu và phân loại quân số" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- 2. Thanh công cụ thao tác (Page Toolbar) -->
            <WrapPanel Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,12">
                <Button Content="{Binding SelectAllButtonText}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
                        Command="{Binding ToggleSelectAllCommand}" ToolTip="Chọn hoặc bỏ chọn tất cả học viên"/>
                <Button Content="🏛️ QL Đơn Vị" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
                        Command="{Binding NavigateToUnitsCommand}" ToolTip="Mở trang Quản lý Đơn vị, Đại đội, Cấp bậc, Chức vụ"/>
                <Button Content="📥 Nhập Excel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
                        Command="{Binding ImportExcelCommand}"/>
                <Button Content="📤 Xuất Excel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
                        Command="{Binding ExportExcelCommand}"/>
                <Button Content="➕ Thêm HV" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8"
                        Command="{Binding RequestAddNewCommand}"/>
                <Button Content="✏️ Sửa" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
                        Command="{Binding StartEditCommand}"/>
                <Button Content="🔑 Đổi MK" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
                        Command="{Binding OpenResetPasswordCommand}"/>
                <Button Content="🗑️ Xóa" Style="{StaticResource DangerButtonStyle}" Margin="0,0,0,8"
                        Command="{Binding DeleteCadetCommand}" ToolTip="Xóa các học viên đã chọn"/>
            </WrapPanel>

            <!-- 3. Thanh Tìm Kiếm & Bộ Lọc Nâng Cao Đa Chiều -->
            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="14">
                <StackPanel>
                    <!-- Hàng lọc cơ bản -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="160"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1*" MinWidth="100"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1*" MinWidth="100"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1.2*" MinWidth="110"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tìm kiếm -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tìm kiếm theo Tên, Mã HV, SĐT, Email:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernTextBoxStyle}" Height="36"/>
                        </StackPanel>

                        <!-- Lọc Cấp bậc -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Cấp bậc quân hàm:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding RankList}" SelectedItem="{Binding SelectedRank}" 
                                      Style="{StaticResource ModernComboBoxStyle}" Height="36"/>
                        </StackPanel>

                        <!-- Lọc Đơn vị -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Đơn vị trực thuộc:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <components:UnitTreeComboBox SelectedUnit="{Binding SelectedUnit, Mode=TwoWay}" IsFilterMode="True" Height="36" Placeholder="[ Tất cả đơn vị ]"/>
                        </StackPanel>

                        <!-- Lọc Lớp học -->
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Lớp học:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding ClassList}" SelectedItem="{Binding SelectedClass}" 
                                      Style="{StaticResource ModernComboBoxStyle}" Height="36"/>
                        </StackPanel>

                        <!-- Nút Lọc Nâng Cao -->
                        <Button Grid.Column="8" Content="⚙️ Lọc Nâng Cao" VerticalAlignment="Bottom" Height="36" 
                                Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ToggleAdvancedFilterCommand}"/>

                        <!-- Nút Xóa Lọc -->
                        <Button Grid.Column="10" Content="✕ Xóa Lọc" VerticalAlignment="Bottom" Height="36" 
                                Style="{StaticResource DangerButtonStyle}" Command="{Binding ResetFiltersCommand}"/>
                    </Grid>

                    <!-- Khung mở rộng: Bộ Lọc Nâng Cao Đa Tiêu Chí -->
                    <Border Visibility="{Binding IsAdvancedFilterVisible, Converter={x:Static local_cv:BooleanToVisibilityConverter.Instance}}"
                            Background="{DynamicResource PageBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="🎯 BỘ LỌC NÂNG CAO ĐA TIÊU CHÍ (Chức vụ, Giới tính, Độ tuổi, Tài khoản &amp; Thể lực)" 
                                       FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="1.2*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Lọc Chức vụ -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Chức vụ quân sự:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                    <ComboBox ItemsSource="{Binding PositionList}" SelectedItem="{Binding SelectedPosition}" 
                                              Style="{StaticResource ModernComboBoxStyle}" Height="34"/>
                                </StackPanel>

                                <!-- Lọc Giới tính -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Giới tính:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                    <ComboBox ItemsSource="{Binding GenderList}" SelectedItem="{Binding SelectedGender}" 
                                              Style="{StaticResource ModernComboBoxStyle}" Height="34"/>
                                </StackPanel>

                                <!-- Lọc Khoảng độ tuổi -->
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Khoảng độ tuổi (Từ - Đến):" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding FilterMinAge, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource ModernTextBoxStyle}" Height="34" Tag="Từ"/>
                                        <TextBlock Grid.Column="1" Text="-" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox Grid.Column="2" Text="{Binding FilterMaxAge, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource ModernTextBoxStyle}" Height="34" Tag="Đến"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Lọc Trạng thái tài khoản -->
                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="Tài khoản đăng nhập:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                    <ComboBox ItemsSource="{Binding HasAccountList}" SelectedItem="{Binding SelectedHasAccount}" 
                                              Style="{StaticResource ModernComboBoxStyle}" Height="34"/>
                                </StackPanel>

                                <!-- Lọc Xếp loại thể lực -->
                                <StackPanel Grid.Column="8">
                                    <TextBlock Text="Xếp loại thể lực:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                    <ComboBox ItemsSource="{Binding FitnessGradeList}" SelectedItem="{Binding SelectedFitnessGrade}" 
                                              Style="{StaticResource ModernComboBoxStyle}" Height="34"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Bảng Dữ Liệu Học Viên -->
            <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="0">
                <DataGrid ItemsSource="{Binding Cadets}" SelectedItem="{Binding SelectedCadet}"
                          Style="{StaticResource MilitaryDataGridStyle}"
                          HeadersVisibility="Column" RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <!-- Cột Chọn checkbox -->
                        <DataGridTemplateColumn Width="48" CanUserResize="False">
                            <DataGridTemplateColumn.Header>
                                <CheckBox IsChecked="{Binding DataContext.IsAllSelected, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                          HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Chọn tất cả / Bỏ chọn tất cả"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Mã Học Viên" Binding="{Binding CadetCode}" Width="110" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Họ và Tên" Binding="{Binding FullName}" Width="170" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Cấp Bậc" Binding="{Binding Rank}" Width="110" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Chức Vụ" Binding="{Binding Position}" Width="130" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Đơn Vị" Binding="{Binding Unit}" Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Lớp" Binding="{Binding ClassName}" MinWidth="150" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Số Điện Thoại" Binding="{Binding PhoneNumber}" Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Tuổi" Binding="{Binding Age}" Width="70" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Giới Tính" Binding="{Binding Gender}" Width="90" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- ==================== MODAL SỬA THÔNG TIN ==================== -->
        <Grid Background="#7F000000" Visibility="{Binding IsEditing, Converter={x:Static local_cv:BooleanToVisibilityConverter.Instance}}">
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Width="550" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" Color="#000000" Opacity="0.3" ShadowDepth="5"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="CẬP NHẬT THÔNG TIN HỌC VIÊN" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,18"/>

                    <!-- Hàng 1: Mã học viên & Họ tên -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Mã học viên (ID): *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditCadetCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="36"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Họ và tên: *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditFullName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="36"/>
                        </StackPanel>
                    </Grid>

                    <!-- Hàng 2: Cấp bậc & Chức vụ -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Cấp bậc (*):" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailableRanks}" SelectedItem="{Binding EditRank}" Style="{StaticResource ModernComboBoxStyle}" Height="36"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Chức vụ (*):" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailablePositions}" SelectedItem="{Binding EditPosition}" Style="{StaticResource ModernComboBoxStyle}" Height="36"/>
                        </StackPanel>
                    </Grid>

                    <!-- Hàng 3: Đơn vị & Lớp -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Đơn vị (*):" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <components:UnitTreeComboBox SelectedUnit="{Binding EditUnit, Mode=TwoWay}" Height="36" Placeholder="Chọn đơn vị học viên..."/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Lớp (*):" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailableClasses}" SelectedItem="{Binding EditClassName}" Style="{StaticResource ModernComboBoxStyle}" Height="36"/>
                        </StackPanel>
                    </Grid>

                    <!-- Hàng 4: SĐT & Email -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Số điện thoại:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="36"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Email liên hệ:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="36"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Hủy Bỏ" Style="{StaticResource SecondaryButtonStyle}" Width="90" Height="36" Margin="0,0,10,0"
                                Command="{Binding CancelEditCommand}"/>
                        <Button Content="Lưu Thay Đổi" Style="{StaticResource PrimaryButtonStyle}" Width="120" Height="36"
                                Command="{Binding SaveEditCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== MODAL ĐẶT LẠI MẬT KHẨU HỌC VIÊN ==================== -->
        <Grid Background="#7F000000" Visibility="{Binding IsResetPasswordDialogVisible, Converter={x:Static local_cv:BooleanToVisibilityConverter.Instance}}">
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Width="440" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" Color="#000000" Opacity="0.3" ShadowDepth="5"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="🔑 ĐẶT LẠI MẬT KHẨU HỌC VIÊN" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding SelectedCadet.FullName, StringFormat='Đồng chí: {0}'}" FontWeight="SemiBold" Foreground="#FFE17A" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding SelectedCadet.CadetCode, StringFormat='Mã học viên: {0}'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16"/>

                    <TextBlock Text="Nhập mật khẩu mới cho tài khoản:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewCadetPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="38" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Hủy Bỏ" Style="{StaticResource SecondaryButtonStyle}" Width="90" Height="36" Margin="0,0,10,0"
                                Command="{Binding CloseResetPasswordCommand}"/>
                        <Button Content="Xác Nhận Đổi" Style="{StaticResource PrimaryButtonStyle}" Width="120" Height="36"
                                Command="{Binding ConfirmResetPasswordCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        </Grid>
    </Border>
</UserControl>
