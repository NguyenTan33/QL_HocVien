<UserControl x:Class="QL_HocVien.Views.UserControls.CadetManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local_cv="clr-namespace:QL_HocVien.Converters"
             xmlns:components="clr-namespace:QL_HocVien.Views.Components"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="950">
    <Border Padding="24">
        <Grid>
            <!-- Vùng nội dung chính -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. Tiêu đề trang (Page Header) -->
            <Grid Grid.Row="0" Margin="0,0,0,10" MinHeight="65">
                <Image Source="/Assets/Images/flag_soldier_banner.png" 
                       HorizontalAlignment="Right" VerticalAlignment="Top" 
                       Height="72" Stretch="Uniform" Opacity="0.88" 
                       Visibility="{DynamicResource CardWatermarkVisibility}" 
                       IsHitTestVisible="False" Margin="0,-6,-10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="QUẢN LÝ DANH SÁCH HỌC VIÊN" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="Tra cứu, cập nhật thông tin học viên, đặt lại mật khẩu và phân loại quân số" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>

            <!-- 2. Thanh công cụ thao tác (Page Toolbar) -->
            <WrapPanel Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,12">
                <Button Content="🏛️ QL Đơn Vị" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
                        Command="{Binding NavigateToUnitsCommand}" ToolTip="Mở trang Quản lý Đơn vị, Đại đội, Cấp bậc, Chức vụ"/>
                <Button Content="📥 Nhập Excel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
                        Command="{Binding ImportExcelCommand}"/>
                <Button Content="📤 Xuất Excel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
                        Command="{Binding ExportExcelCommand}"/>
                <Button Content="➕ Thêm HV" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8"
                        Command="{Binding RequestAddNewCommand}"/>
                <Button Content="🔄 Chuyển Đơn Vị" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
                        Command="{Binding OpenTransferModalCommand}" ToolTip="Điều chuyển học viên sang bộ phận / đơn vị khác theo năm học"/>
                <Button Content="📜 Dòng Thời Gian" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
                        Command="{Binding OpenTimelineModalCommand}" ToolTip="Xem dòng thời gian đào tạo (các khóa, đơn vị, TBM từng năm, hoàn thành)"/>
                <Button Content="✏️ Sửa" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
                        Command="{Binding StartEditCommand}"/>
                <Button Content="🗑️ Xóa" Style="{StaticResource DangerButtonStyle}" Margin="0,0,0,8"
                        Command="{Binding DeleteCadetCommand}" ToolTip="Xóa các học viên đã chọn"/>
            </WrapPanel>

            <!-- 3. Thanh Tìm Kiếm & Bộ Lọc Nâng Cao Đa Chiều -->
            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="14">
                <StackPanel>
                    <!-- Hàng lọc cơ bản -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="150"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1*" MinWidth="90"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1*" MinWidth="90"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1.3*" MinWidth="120"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tìm kiếm -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tìm kiếm Tên, Mã, SĐT:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernTextBoxStyle}" Height="36"/>
                        </StackPanel>

                        <!-- Lọc Khóa học -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Khóa đào tạo:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding CohortList}" SelectedItem="{Binding SelectedCohort}" 
                                      Style="{StaticResource ModernComboBoxStyle}" Height="36"/>
                        </StackPanel>

                        <!-- Lọc Cấp bậc -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Cấp bậc:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding RankList}" SelectedItem="{Binding SelectedRank}" 
                                      Style="{StaticResource ModernComboBoxStyle}" Height="36"/>
                        </StackPanel>

                        <!-- Lọc Đơn vị -->
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Đơn vị:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <components:UnitTreeComboBox SelectedUnit="{Binding SelectedUnit, Mode=TwoWay}" IsFilterMode="True" Height="36" Placeholder="[ Tất cả ]"/>
                        </StackPanel>

                        <!-- Nút Lọc Nâng Cao -->
                        <Button Grid.Column="8" Content="⚙️ Lọc Nâng Cao" VerticalAlignment="Bottom" Height="36" 
                                Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ToggleAdvancedFilterCommand}"/>

                        <!-- Nút Xóa Lọc -->
                        <Button Grid.Column="10" Content="✕ Xóa Lọc" VerticalAlignment="Bottom" Height="36" 
                                Style="{StaticResource DangerButtonStyle}" Command="{Binding ResetFiltersCommand}"/>
                    </Grid>

                    <!-- Khung mở rộng: Bộ Lọc Nâng Cao Đa Tiêu Chí -->
                    <Border Visibility="{Binding IsAdvancedFilterVisible, Converter={x:Static local_cv:BooleanToVisibilityConverter.Instance}}"
                            Background="{DynamicResource PageBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="🎯 BỘ LỌC NÂNG CAO ĐA TIÊU CHÍ (Chức vụ, Giới tính, Độ tuổi, Tài khoản &amp; Thể lực)" 
                                       FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="1.2*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Lọc Chức vụ -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Chức vụ quân sự:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                    <ComboBox ItemsSource="{Binding PositionList}" SelectedItem="{Binding SelectedPosition}" 
                                              Style="{StaticResource ModernComboBoxStyle}" Height="34"/>
                                </StackPanel>

                                <!-- Lọc Giới tính -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Giới tính:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                    <ComboBox ItemsSource="{Binding GenderList}" SelectedItem="{Binding SelectedGender}" 
                                              Style="{StaticResource ModernComboBoxStyle}" Height="34"/>
                                </StackPanel>

                                <!-- Lọc Khoảng độ tuổi -->
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Khoảng độ tuổi (Từ - Đến):" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding FilterMinAge, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource ModernTextBoxStyle}" Height="34" Tag="Từ"/>
                                        <TextBlock Grid.Column="1" Text="-" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox Grid.Column="2" Text="{Binding FilterMaxAge, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource ModernTextBoxStyle}" Height="34" Tag="Đến"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Lọc Trạng thái tài khoản -->
                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="Tài khoản đăng nhập:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                    <ComboBox ItemsSource="{Binding HasAccountList}" SelectedItem="{Binding SelectedHasAccount}" 
                                              Style="{StaticResource ModernComboBoxStyle}" Height="34"/>
                                </StackPanel>

                                <!-- Lọc Xếp loại thể lực -->
                                <StackPanel Grid.Column="8">
                                    <TextBlock Text="Xếp loại thể lực:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                    <ComboBox ItemsSource="{Binding FitnessGradeList}" SelectedItem="{Binding SelectedFitnessGrade}" 
                                              Style="{StaticResource ModernComboBoxStyle}" Height="34"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Bảng Dữ Liệu Học Viên -->
            <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="0">
                <DataGrid ItemsSource="{Binding Cadets}" SelectedItem="{Binding SelectedCadet}"
                          Style="{StaticResource MilitaryDataGridStyle}"
                          HeadersVisibility="Column" RowHeaderWidth="0">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="🔄 Điều Chuyển Đơn Vị Mới..." 
                                      Command="{Binding OpenTransferModalCommand}" 
                                      CommandParameter="{Binding SelectedCadet}"/>
                            <MenuItem Header="📜 Dòng Thời Gian Đào Tạo (Timeline)..." 
                                      Command="{Binding OpenTimelineModalCommand}" 
                                      CommandParameter="{Binding SelectedCadet}"/>
                            <Separator/>
                            <MenuItem Header="✏️ Sửa Thông Tin Học Viên" 
                                      Command="{Binding StartEditCommand}"/>
                            <MenuItem Header="🔑 Đặt Lại Mật Khẩu" 
                                      Command="{Binding ResetPasswordCommand}"/>
                            <Separator/>
                            <MenuItem Header="🗑️ Xóa Học Viên" 
                                      Command="{Binding DeleteCadetCommand}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <!-- Cột Chọn checkbox -->
                        <DataGridTemplateColumn Width="48" CanUserResize="False">
                            <DataGridTemplateColumn.Header>
                                <CheckBox IsChecked="{Binding DataContext.IsAllSelected, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                          HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Chọn tất cả / Bỏ chọn tất cả"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Mã Học Viên" Binding="{Binding CadetCode}" Width="110" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Họ và Tên" Binding="{Binding FullName}" Width="180" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Khóa" Binding="{Binding Cohort}" Width="85" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Cấp Bậc" Binding="{Binding Rank}" Width="105" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Chức Vụ" Binding="{Binding Position}" Width="130" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Đơn Vị" Binding="{Binding Unit}" MinWidth="160" Width="*" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Trạng Thái" Width="120" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource PageBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Status, TargetNullValue='Đang học', FallbackValue='Đang học'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Số Điện Thoại" Binding="{Binding PhoneNumber}" Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Tuổi" Binding="{Binding Age}" Width="70" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Giới Tính" Binding="{Binding Gender}" Width="90" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- ==================== MODAL SỬA THÔNG TIN ==================== -->
        <Grid Background="#7F000000" Visibility="{Binding IsEditing, Converter={x:Static local_cv:BooleanToVisibilityConverter.Instance}}">
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Width="550" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" Color="#000000" Opacity="0.3" ShadowDepth="5"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="CẬP NHẬT THÔNG TIN HỌC VIÊN" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,18"/>

                    <!-- Hàng 1: Mã học viên & Họ tên -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Mã học viên (ID): *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditCadetCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="36"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Họ và tên: *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditFullName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="36"/>
                        </StackPanel>
                    </Grid>

                    <!-- Hàng 2: Cấp bậc & Chức vụ -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Cấp bậc (*):" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailableRanks}" SelectedItem="{Binding EditRank}" Style="{StaticResource ModernComboBoxStyle}" Height="36"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Chức vụ (*):" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailablePositions}" SelectedItem="{Binding EditPosition}" Style="{StaticResource ModernComboBoxStyle}" Height="36"/>
                        </StackPanel>
                    </Grid>

                    <!-- Hàng 3: Đơn vị -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Đơn vị (*):" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <components:UnitTreeComboBox SelectedUnit="{Binding EditUnit, Mode=TwoWay}" Height="36" Placeholder="Chọn đơn vị học viên..."/>
                    </StackPanel>

                    <!-- Hàng 4: Khóa học & Ngày sinh -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Khóa đào tạo (*) [CSDL SQL]:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailableCohorts}" 
                                      SelectedItem="{Binding SelectedEditCohort, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayLabel"
                                      Style="{StaticResource ModernComboBoxStyle}" Height="36"/>
                            <TextBlock Text="⚠️ Chưa có khóa học trong CSDL. Vào 'Quản Lý Khóa Học' để tạo trước!"
                                       FontSize="11" Foreground="#EF4444" FontStyle="Italic" Margin="0,2,0,0"
                                       Visibility="{Binding AvailableCohorts.Count, Converter={x:Static local_cv:IntEqualsToVisibilityConverter.Instance}, ConverterParameter=0}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Ngày sinh:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding EditAgeText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentLightBrush}"/>
                            </Grid>
                            <DatePicker SelectedDate="{Binding EditDateOfBirth, Mode=TwoWay}" Height="36" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Hàng 5: SĐT & Email & Giới tính -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Số điện thoại:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="36"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Email liên hệ:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="36"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Giới tính:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailableGenders}" SelectedItem="{Binding EditGender}" Style="{StaticResource ModernComboBoxStyle}" Height="36"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Hủy Bỏ" Style="{StaticResource SecondaryButtonStyle}" Width="90" Height="36" Margin="0,0,10,0"
                                Command="{Binding CancelEditCommand}"/>
                        <Button Content="Lưu Thay Đổi" Style="{StaticResource PrimaryButtonStyle}" Width="120" Height="36"
                                Command="{Binding SaveEditCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== MODAL ĐẶT LẠI MẬT KHẨU HỌC VIÊN ==================== -->
        <Grid Background="#7F000000" Visibility="{Binding IsResetPasswordDialogVisible, Converter={x:Static local_cv:BooleanToVisibilityConverter.Instance}}">
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Width="440" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" Color="#000000" Opacity="0.3" ShadowDepth="5"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="🔑 ĐẶT LẠI MẬT KHẨU HỌC VIÊN" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding SelectedCadet.FullName, StringFormat='Đồng chí: {0}'}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding SelectedCadet.CadetCode, StringFormat='Mã học viên: {0}'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16"/>

                    <TextBlock Text="Nhập mật khẩu mới cho tài khoản:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewCadetPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="38" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Hủy Bỏ" Style="{StaticResource SecondaryButtonStyle}" Width="90" Height="36" Margin="0,0,10,0"
                                Command="{Binding CloseResetPasswordCommand}"/>
                        <Button Content="Xác Nhận Đổi" Style="{StaticResource PrimaryButtonStyle}" Width="120" Height="36"
                                Command="{Binding ConfirmResetPasswordCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== MODAL ĐIỀU CHUYỂN ĐƠN VỊ ==================== -->
        <Grid Background="#7F000000" Visibility="{Binding IsTransferModalOpen, Converter={x:Static local_cv:BooleanToVisibilityConverter.Instance}}">
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" 
                    BorderThickness="1" CornerRadius="10" Width="560" MaxHeight="680" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" Color="#000000" Opacity="0.35" ShadowDepth="6"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Tiêu đề Modal -->
                        <TextBlock Text="🔄 ĐIỀU CHUYỂN HỌC VIÊN SANG ĐƠN VỊ MỚI" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="Cập nhật bộ phận / đơn vị đào tạo theo từng năm học. Dữ liệu các năm trước vẫn được bảo toàn nguyên vẹn trong lịch sử tra cứu." 
                                   FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <!-- Thông tin học viên hiện tại -->
                        <Border Background="{DynamicResource PageBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding TransferCadet.FullName, StringFormat='Đồng chí: {0}'}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding TransferCadet.CadetCode, StringFormat='Mã học viên: {0}'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding TransferCadet.Unit, StringFormat='Đơn vị hiện tại: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="{Binding TransferCadet.Cohort, StringFormat='Khóa: {0}'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Năm học & Năm thứ -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Năm học áp dụng (*):" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding TransferSchoolYear, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBoxStyle}" Height="36" Tag="Ví dụ: 2024 - 2025"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Năm thứ đào tạo (*):" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox SelectedValue="{Binding TransferYearOrder, Mode=TwoWay}"
                                          SelectedValuePath="Tag" Height="36" Style="{StaticResource ModernComboBoxStyle}">
                                    <ComboBoxItem Content="Năm thứ 1 (Năm 1)" Tag="1"/>
                                    <ComboBoxItem Content="Năm thứ 2 (Năm 2)" Tag="2" IsSelected="True"/>
                                    <ComboBoxItem Content="Năm thứ 3 (Năm 3)" Tag="3"/>
                                    <ComboBoxItem Content="Năm thứ 4 (Năm 4)" Tag="4"/>
                                    <ComboBoxItem Content="Năm thứ 5 (Năm 5)" Tag="5"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Đơn vị mới cần chuyển đến -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Đơn vị mới điều chuyển đến (*):" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <components:UnitTreeComboBox SelectedUnit="{Binding TransferUnit, Mode=TwoWay}" Height="36" Placeholder="Chọn hoặc gõ đơn vị mới (Tiểu đội / Đại đội / Tiểu đoàn)..."/>
                        </StackPanel>

                        <!-- Trạng thái đào tạo & Ngày hiệu lực -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Trạng thái đào tạo:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding TransferStatusList}" SelectedItem="{Binding TransferStatus}" 
                                          Style="{StaticResource ModernComboBoxStyle}" Height="36"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Ngày có hiệu lực:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <DatePicker SelectedDate="{Binding TransferEffectiveDate, Mode=TwoWay}" Height="36" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Lý do / Quyết định điều chuyển -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Lý do / Quyết định điều chuyển:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding TransferReason, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernTextBoxStyle}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Tag="Ghi rõ số quyết định hoặc lý do điều chuyển..."/>
                        </StackPanel>

                        <!-- Nút thao tác -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Hủy Bỏ" Style="{StaticResource SecondaryButtonStyle}" Width="90" Height="36" Margin="0,0,10,0"
                                    Command="{Binding CloseTransferModalCommand}"/>
                            <Button Content="Xác Nhận Điều Chuyển" Style="{StaticResource PrimaryButtonStyle}" Height="36" Padding="14,0"
                                    Command="{Binding ExecuteTransferCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ==================== MODAL DÒNG THỜI GIAN ĐÀO TẠO (TIMELINE) ==================== -->
        <Grid Background="#7F000000" Visibility="{Binding IsTimelineModalOpen, Converter={x:Static local_cv:BooleanToVisibilityConverter.Instance}}">
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" 
                    BorderThickness="1" CornerRadius="12" Width="680" MaxHeight="720" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" Color="#000000" Opacity="0.35" ShadowDepth="6"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header Modal -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="📜 DÒNG THỜI GIAN QUÁ TRÌNH ĐÀO TẠO" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="Lịch sử luân chuyển đơn vị, kết quả học tập (TBM) và tiến trình đào tạo qua từng năm học." 
                                       FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Thông tin tổng quan học viên -->
                    <Border Grid.Row="1" Background="{DynamicResource PageBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Avatar quân sự -->
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="{DynamicResource PrimaryBrush}" VerticalAlignment="Center">
                                <TextBlock Text="🎖️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <!-- Chi tiết -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TimelineCadet.FullName}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <WrapPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Text="{Binding TimelineCadet.CadetCode, StringFormat='Mã: {0}  •  '}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding TimelineCadet.Rank, StringFormat='Cấp bậc: {0}  •  '}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding TimelineCadet.Position, StringFormat='Chức vụ: {0}'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </WrapPanel>
                            </StackPanel>
                            <!-- Badge Trạng thái hiện tại -->
                            <Border Grid.Column="3" Background="{DynamicResource PageBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TimelineCadet.Status, TargetNullValue='Đang học', FallbackValue='Đang học'}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Vùng danh sách mốc thời gian (Vertical Timeline) -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                        <ItemsControl ItemsSource="{Binding TimelineNodes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Cột mốc Timeline (Vạch dọc + Icon chấm tròn) -->
                                        <Grid Grid.Column="0">
                                            <!-- Đường vạch kẻ đứng -->
                                            <Rectangle Width="2" Fill="{DynamicResource CardBorderBrush}" HorizontalAlignment="Center"/>
                                            <!-- Chấm tròn mốc -->
                                            <Ellipse Width="16" Height="16" Fill="{DynamicResource AccentBrush}" Stroke="{DynamicResource PageBackgroundBrush}" StrokeThickness="3" VerticalAlignment="Top" Margin="0,8,0,0"/>
                                        </Grid>

                                        <!-- Thẻ nội dung mốc thời gian -->
                                        <Border Grid.Column="1" Background="{DynamicResource PageBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="6,0,0,0">
                                            <StackPanel>
                                                <!-- Hàng 1: Năm học + Huy hiệu Đơn vị / Trạng thái -->
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding YearLabel}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                        <!-- Huy hiệu Node hiện hành -->
                                                        <Border Background="#10B981" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                Visibility="{Binding IsCurrent, Converter={x:Static local_cv:BooleanToVisibilityConverter.Instance}}">
                                                            <TextBlock Text="Đang theo học" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="7,2">
                                                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </Border>
                                                </Grid>

                                                <!-- Hàng 2: Cơ cấu Đơn vị & Khóa học -->
                                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="🚩 Đơn vị: " FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding UnitDisplay}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,14,0"/>
                                                    <TextBlock Text="{Binding CohortDisplay}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding ClassName, StringFormat='{}Lớp: {0}'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                                               Visibility="{Binding ClassName, Converter={x:Static local_cv:StringToVisibilityConverter.Instance}}"/>
                                                </WrapPanel>

                                                <!-- Hàng 3: Điểm trung bình môn (TBM / GPA) & Xếp loại -->
                                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,2,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="📊 Điểm Trung Bình Môn (TBM): " FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            <TextBlock Text="{Binding AnnualGpaDisplay}" FontSize="13" FontWeight="ExtraBold" Foreground="{DynamicResource AccentBrush}"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Background="{DynamicResource PageBackgroundBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2"
                                                                BorderBrush="{Binding RatingBadgeColor}">
                                                            <TextBlock Text="{Binding AcademicRating}" FontSize="11" FontWeight="Bold" Foreground="{Binding RatingBadgeColor}"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <!-- Hàng 4: Quyết định / Lý do điều chuyển (nếu có) -->
                                                <TextBlock Text="{Binding TransferReason, StringFormat='{}• Ghi chú: {0}'}" FontSize="11.5" FontStyle="Italic" Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Visibility="{Binding TransferReason, Converter={x:Static local_cv:StringToVisibilityConverter.Instance}}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Nút Đóng -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Đóng" Style="{StaticResource SecondaryButtonStyle}" Width="100" Height="36"
                                Command="{Binding CloseTimelineModalCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        </Grid>
    </Border>
</UserControl>
