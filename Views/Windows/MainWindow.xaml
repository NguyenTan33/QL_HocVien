<Window x:Class="QL_HocVien.Views.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:QL_HocVien.ViewModels"
        xmlns:views="clr-namespace:QL_HocVien.Views.UserControls"
        xmlns:local_cv="clr-namespace:QL_HocVien.Converters"
        mc:Ignorable="d"
        Title="Hệ Thống Quản Lý Học Viên Quân Đội - Tiêu Chuẩn Thể Lực TT32"
        Icon="pack://application:,,,/QL_HocVien;component/Resources/app_icon.ico"
        Height="800" Width="1280"
        MinHeight="680" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#F1F5F9">

    <Window.Resources>
        <!-- DataTemplates liên kết từng ViewModel với UserControl tương ứng (MVVM) -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CadetManagementViewModel}">
            <views:CadetManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ClassManagementViewModel}">
            <views:ClassManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AddCadetViewModel}">
            <views:AddCadetView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SubjectManagementViewModel}">
            <views:SubjectManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PhysicalExamViewModel}">
            <views:PhysicalExamView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OfficerManagementViewModel}">
            <views:OfficerManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CatalogManagementViewModel}">
            <views:CatalogManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CreditSubjectManagementViewModel}">
            <views:CreditSubjectManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AcademicAnalyticsViewModel}">
            <views:AcademicAnalyticsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExamAnalyticsViewModel}">
            <views:ExamAnalyticsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TrainingTimelineViewModel}">
            <views:TrainingTimelineView/>
        </DataTemplate>

        <!-- Style cho các nút điều hướng Sidebar (Tự động Active Đỏ Gradient Viền Vàng theo ActiveMenu) -->
        <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="33"/>
            <Setter Property="Margin" Value="8,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="navBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Trạng thái Rê chuột (Hover) -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E2E20"/>
                    <Setter Property="BorderBrush" Value="#35452C"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <!-- Trạng thái Đang được chọn (Active Menu - Đỏ Quân Kỳ Gradient Viền Vàng Kim) -->
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{x:Static local_cv:MenuMatchToBooleanConverter.Instance}">
                            <Binding Path="ActiveMenu"/>
                            <Binding RelativeSource="{RelativeSource Self}" Path="Tag"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{StaticResource MilActiveMenuGradient}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource MilGoldBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0. TopBar Quân kỳ & Khẩu hiệu -->
            <RowDefinition Height="40"/>
            <!-- 1. Vùng làm việc chính -->
            <RowDefinition Height="*"/>
            <!-- 2. Khẩu hiệu chân trang (Bottom Banner) -->
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- ==================== 0. CUSTOM TOPBAR QUÂN KỲ QUYẾT THẮNG ==================== -->
        <Border Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource MilTopBarGradient}"/>
                    <Setter Property="BorderBrush" Value="#625C34"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCombatMode}" Value="False">
                            <Setter Property="Background" Value="#0A1329"/>
                            <Setter Property="BorderBrush" Value="#1E293B"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid Margin="14,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Trái: Quân hiệu sao vàng & Tiêu đề hệ thống -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="★" Foreground="#F2C94C" FontSize="15" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="QUÂN ĐỘI NHÂN DÂN VIỆT NAM  |" Foreground="#FFE17A" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="  HỆ THỐNG QUẢN LÝ HỌC VIÊN &amp; RÈN LUYỆN THỂ LỰC (TT 32/2009)" Foreground="#F7F1D4" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Giữa: Khẩu hiệu vàng kim truyền thống -->
                <TextBlock Grid.Column="1" Text="“TRUNG THÀNH - ĐOÀN KẾT - KỶ LUẬT - QUYẾT THẮNG”" 
                           Foreground="#FFE17A" FontSize="11.5" FontWeight="ExtraBold" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0"/>

                <!-- Phải: Nút Gạt Dual-Theme + Khóa Bảo Mật + Điều Khiển Cửa Sổ -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Nút Gạt Chuyển Đổi 2 Giao Diện (Dual-Theme) -->
                    <Button Command="{Binding ToggleThemeModeCommand}" ToolTip="{Binding ThemeModeTooltip}"
                            Height="26" Padding="10,0" Margin="0,0,12,0" Cursor="Hand" BorderThickness="1">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#18251A"/>
                                <Setter Property="BorderBrush" Value="#F2C94C"/>
                                <Setter Property="Foreground" Value="#FFE17A"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCombatMode}" Value="False">
                                        <Setter Property="Background" Value="#1E293B"/>
                                        <Setter Property="BorderBrush" Value="#60A5FA"/>
                                        <Setter Property="Foreground" Value="#93C5FD"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔄 " FontSize="10"/>
                            <TextBlock Text="{Binding ThemeModeButtonText}" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <!-- Widget Khóa bảo mật -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"
                                Visibility="{Binding IsSecurityProtectionEnabled, Converter={x:Static local_cv:BooleanToVisibilityConverter.Instance}}">
                        <!-- Trạng thái: Đang mở khóa (có đếm ngược) -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding IsSecurityUnlocked, Converter={x:Static local_cv:BooleanToVisibilityConverter.Instance}}">
                            <Border Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🔓" FontSize="11" Margin="0,0,4,0"/>
                                    <TextBlock Text="MỞ KHÓA: " FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                                    <TextBlock Text="{Binding SecurityRemainingTime}" FontSize="11" FontWeight="ExtraBold" Foreground="#6EE7B7"/>
                                </StackPanel>
                            </Border>
                            <Button Content="🔒 Khóa Ngay" Height="24" Padding="8,0" Background="#DC2626" Foreground="White" BorderThickness="0"
                                    FontSize="10" FontWeight="Bold" Cursor="Hand" ToolTip="Lập tức khóa màn hình để bảo vệ dữ liệu khi rời máy"
                                    Command="{Binding QuickLockCommand}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>

                        <!-- Trạng thái: Đang khóa (bấm để mở khóa) -->
                        <Button Background="#1E293B" BorderBrush="#475569" BorderThickness="1" Padding="8,2" Height="24" Cursor="Hand"
                                ToolTip="{Binding SecurityStatusTooltip}"
                                Command="{Binding QuickUnlockCommand}"
                                Visibility="{Binding IsSecurityUnlocked, Converter={x:Static local_cv:InvertedBooleanToVisibilityConverter.Instance}}">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔒" FontSize="10" Margin="0,0,4,0"/>
                                <TextBlock Text="KHÓA BẢO MẬT (CHỈ XEM)" FontSize="10" FontWeight="Bold" Foreground="#F59E0B"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Các nút điều khiển cửa sổ -->
                    <Button Content="—" Width="34" Height="28" Background="Transparent" Foreground="#F7F1D4" BorderThickness="0"
                            Cursor="Hand" Click="BtnMinimize_Click"/>
                    <Button x:Name="BtnMax" Content="☐" Width="34" Height="28" Background="Transparent" Foreground="#F7F1D4" BorderThickness="0"
                            Cursor="Hand" Click="BtnMaximize_Click"/>
                    <Button Content="✕" Width="34" Height="28" Background="Transparent" Foreground="#F7F1D4" BorderThickness="0"
                            Cursor="Hand" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 1. THÂN ỨNG DỤNG ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Cột Sidebar bên trái chuẩn 270px như DemoUI -->
                <ColumnDefinition Width="270"/>
                <!-- Cột Nội dung chính -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR BÊN TRÁI -->
            <Border Grid.Column="0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource MilSidebarBrush}"/>
                        <Setter Property="BorderBrush" Value="#18291D"/>
                        <Setter Property="BorderThickness" Value="0,0,1,0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCombatMode}" Value="False">
                                <Setter Property="Background" Value="#0F172A"/>
                                <Setter Property="BorderBrush" Value="#1E293B"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Header Sidebar: Quân hiệu & Biểu trưng QĐNDVN -->
                        <RowDefinition Height="Auto"/>
                        <!-- Menu Links -->
                        <RowDefinition Height="*"/>
                        <!-- Footer / Thông tin người dùng đăng nhập -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header Sidebar Quân Hiệu QĐNDVN Chuẩn DemoUI -->
                    <Border Grid.Row="0" BorderBrush="#2B3D2B" BorderThickness="0,0,0,1" Height="168" Background="#0D1610">
                        <Image Source="/Assets/Images/sidebar_header.png" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Menu Chức Năng Sidebar (Không thanh cuộn trắng, cuộn mượt bằng chuột) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Margin="0,2" PanningMode="VerticalOnly">
                        <StackPanel>
                            <!-- NHÓM 1: HỆ THỐNG QUẢN LÝ -->
                            <Border BorderBrush="#2B3D2B" BorderThickness="0,0,0,1" Margin="12,4,12,2" Padding="0,0,0,2">
                                <TextBlock Text="HỆ THỐNG QUẢN LÝ" FontSize="10" FontWeight="Bold" Foreground="#8C7D46"/>
                            </Border>

                            <!-- 1. Bảng Tổng Quan -->
                            <Button Style="{StaticResource SidebarNavButtonStyle}" Tag="Dashboard"
                                    Command="{Binding NavigateToDashboardCommand}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⌂" FontSize="15" FontWeight="Bold" Foreground="#FFE17A" Width="22" TextAlignment="Center" Margin="0,-2,8,0"/>
                                    <TextBlock Text="Bảng Tổng Quan" FontSize="12.5"/>
                                </StackPanel>
                            </Button>

                            <!-- 2. Quản Lý Cán Bộ (Chỉ Quản Trị Viên) -->
                            <Button Style="{StaticResource SidebarNavButtonStyle}" Tag="OfficerManagement"
                                    Command="{Binding NavigateToOfficerManagementCommand}"
                                    Visibility="{Binding IsAdmin, Converter={x:Static local_cv:BooleanToVisibilityConverter.Instance}}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="★" FontSize="14" FontWeight="Bold" Foreground="#F2C94C" Width="22" TextAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Quản Lý Cán Bộ" FontSize="12.5"/>
                                </StackPanel>
                            </Button>

                            <!-- 3. Quản Lý Học Viên -->
                            <Button Style="{StaticResource SidebarNavButtonStyle}" Tag="CadetManagement"
                                    Command="{Binding NavigateToCadetManagementCommand}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="👤" FontSize="14" Foreground="#F2C94C" Width="22" TextAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Quản Lý Học Viên" FontSize="12.5"/>
                                </StackPanel>
                            </Button>

                            <!-- 4. Quản Lý Lớp Học -->
                            <Button Style="{StaticResource SidebarNavButtonStyle}" Tag="ClassManagement"
                                    Command="{Binding NavigateToClassManagementCommand}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="👥" FontSize="14" Foreground="#F2C94C" Width="22" TextAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Quản Lý Lớp Học" FontSize="12.5"/>
                                </StackPanel>
                            </Button>

                            <!-- 5. Danh Mục Tổ Chức (Đại Đội, Cấp Bậc, Chức Vụ - Chỉ Quản Trị Viên) -->
                            <Button Style="{StaticResource SidebarNavButtonStyle}" Tag="CatalogManagement"
                                    Command="{Binding NavigateToCatalogManagementCommand}"
                                    Visibility="{Binding IsAdmin, Converter={x:Static local_cv:BooleanToVisibilityConverter.Instance}}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📖" FontSize="13" Foreground="#F2C94C" Width="22" TextAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Danh Mục &amp; Đại Đội" FontSize="12.5"/>
                                </StackPanel>
                            </Button>

                            <!-- 6. Môn Học -->
                            <Button Style="{StaticResource SidebarNavButtonStyle}" Tag="CreditSubjectManagement"
                                    Command="{Binding NavigateToCreditSubjectManagementCommand}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📖" FontSize="13" Foreground="#F2C94C" Width="22" TextAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Môn Học" FontSize="12.5"/>
                                </StackPanel>
                            </Button>

                            <!-- 7. Phân Tích Học Lực -->
                            <Button Style="{StaticResource SidebarNavButtonStyle}" Tag="AcademicAnalytics"
                                    Command="{Binding NavigateToAcademicAnalyticsCommand}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📊" FontSize="13" Foreground="#F2C94C" Width="22" TextAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Phân Tích Học Lực" FontSize="12.5"/>
                                </StackPanel>
                            </Button>

                            <!-- 8. Tiêu Chuẩn Môn Thể Lực -->
                            <Button Style="{StaticResource SidebarNavButtonStyle}" Tag="SubjectManagement"
                                    Command="{Binding NavigateToSubjectManagementCommand}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🏆" FontSize="13" Foreground="#F2C94C" Width="22" TextAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Tiêu Chuẩn Môn Thể Lực" FontSize="12.5"/>
                                </StackPanel>
                            </Button>

                            <!-- NHÓM 2: RÈN LUYỆN & HỆ THỐNG -->
                            <Border BorderBrush="#2B3D2B" BorderThickness="0,0,0,1" Margin="12,5,12,2" Padding="0,0,0,2">
                                <TextBlock Text="RÈN LUYỆN &amp; HỆ THỐNG" FontSize="10" FontWeight="Bold" Foreground="#8C7D46"/>
                            </Border>

                            <!-- 9. Rèn Luyện Thể Lực (Chuẩn TT 32) -->
                            <Button Style="{StaticResource SidebarNavButtonStyle}" Tag="PhysicalExam"
                                    Command="{Binding NavigateToPhysicalExamCommand}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🏃" FontSize="14" Foreground="#F2C94C" Width="24" TextAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Rèn Luyện Thể Lực" FontSize="12.5"/>
                                </StackPanel>
                            </Button>

                            <!-- 10. Phân Tích Thể Lực -->
                            <Button Style="{StaticResource SidebarNavButtonStyle}" Tag="ExamAnalytics"
                                    Command="{Binding NavigateToExamAnalyticsCommand}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📈" FontSize="14" Foreground="#F2C94C" Width="24" TextAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Phân Tích Thể Lực" FontSize="12.5"/>
                                </StackPanel>
                            </Button>

                            <!-- 11. Lịch Huấn Luyện & Mốc Sự Kiện -->
                            <Button Style="{StaticResource SidebarNavButtonStyle}" Tag="TrainingTimeline"
                                    Command="{Binding NavigateToTrainingTimelineCommand}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📅" FontSize="14" Foreground="#F2C94C" Width="24" TextAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Lịch Huấn Luyện &amp; Sự Kiện" FontSize="12.5"/>
                                </StackPanel>
                            </Button>

                            <!-- 12. Cài Đặt & Bảo Mật (Chỉ Quản Trị Viên) -->
                            <Button Style="{StaticResource SidebarNavButtonStyle}" Tag="Settings"
                                    Command="{Binding NavigateToSettingsCommand}"
                                    Visibility="{Binding IsAdmin, Converter={x:Static local_cv:BooleanToVisibilityConverter.Instance}}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚙" FontSize="14" Foreground="#F2C94C" Width="24" TextAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Cài Đặt &amp; Bảo Mật" FontSize="12.5"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer Sidebar: Người Dùng & Đăng Xuất chuẩn DemoUI -->
                    <Border Grid.Row="2" Background="#0C150E" Padding="12,6" BorderBrush="#1F3022" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Phù hiệu quân hàm 3 vạch vàng -->
                            <Image Grid.Column="0" Source="/Assets/Images/user_rank_badge.png" Width="34" Height="34" Margin="0,0,8,0"/>

                            <!-- Tên và vai trò -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentUser.FullName, FallbackValue='Quản Trị Viên Hệ Thống'}" 
                                           FontWeight="Bold" FontSize="12" Foreground="#F7F1D4" TextTrimming="CharacterEllipsis"/>
                                <Border Background="#168A40" CornerRadius="4" Padding="7,2" HorizontalAlignment="Left" Margin="0,3,0,0">
                                    <TextBlock Text="{Binding CurrentUser.Role, FallbackValue='Admin'}" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </Border>
                            </StackPanel>

                            <!-- Nút Đăng xuất cửa đỏ chuẩn DemoUI -->
                            <Button Grid.Column="2" Width="26" Height="30" Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" ToolTip="Đăng xuất khỏi hệ thống" VerticalAlignment="Center"
                                    Command="{Binding LogoutCommand}">
                                <Image Source="/Assets/Images/logout_icon.png" Width="18" Height="22" Stretch="Uniform"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- VÙNG HIỂN THỊ NỘI DUNG CHÍNH (CONTENT AREA) -->
            <Border Grid.Column="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource MilBackgroundBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCombatMode}" Value="False">
                                <Setter Property="Background" Value="#F8FAFC"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <ContentControl Content="{Binding CurrentView}"/>
                    <!-- Xe tăng & Đoàn quân tiến công ở đáy màn hình chuẩn DemoUI -->
                    <Image Source="/Assets/Images/tank_silhouette_peek.png" 
                           Height="46" HorizontalAlignment="Left" VerticalAlignment="Bottom" Stretch="Uniform" 
                           Margin="15,0,0,0" IsHitTestVisible="False" Opacity="0.95"
                           Visibility="{Binding IsCombatMode, Converter={x:Static local_cv:BooleanToVisibilityConverter.Instance}}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 2. KHẨU HIỆU CHÂN TRANG (BOTTOM SLOGAN BAR CHUẨN DEMOUI) ==================== -->
        <Border Grid.Row="2" Height="38">
            <Image Source="/Assets/Images/bottom_slogan_bar.png" Stretch="UniformToFill" VerticalAlignment="Bottom"/>
        </Border>
    </Grid>
</Window>
