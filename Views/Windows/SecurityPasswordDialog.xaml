<Window x:Class="QL_HocVien.Views.Windows.SecurityPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Xác Thực Khóa Bảo Mật Cấp 2" 
        Height="360" Width="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border Background="#0A1329" BorderBrush="#3B82F6" BorderThickness="1.5" CornerRadius="14" Padding="28" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="6" Opacity="0.55"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Description Box -->
                <RowDefinition Height="Auto"/> <!-- Password Box -->
                <RowDefinition Height="Auto"/> <!-- Error Message -->
                <RowDefinition Height="*"/>    <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                    <TextBlock Text="🛡️" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="XÁC THỰC BẢO MẬT CẤP 2" FontSize="18" FontWeight="Bold" Foreground="#60A5FA" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Cơ chế bảo vệ dữ liệu &amp; tự động khóa sau 5 phút" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- 2. Action Box -->
            <Border Grid.Row="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Yêu cầu bảo mật cho hành động:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBlock x:Name="txtActionDescription" Text="Xác nhận chỉnh sửa dữ liệu" FontSize="13" FontWeight="Bold" Foreground="#F1F5F9" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="⏱️ Mở khóa thành công sẽ có hiệu lực trong vòng 5 phút." FontSize="11" Foreground="#10B981" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- 3. Password Input -->
            <StackPanel Grid.Row="2" Margin="0,0,0,8">
                <TextBlock Text="Nhập mật khẩu cấp 2 của bạn:" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,6"/>
                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="6,2">
                    <PasswordBox x:Name="txtPassword" 
                                 Background="Transparent" 
                                 Foreground="#FFFFFF" 
                                 CaretBrush="#60A5FA" 
                                 BorderThickness="0" 
                                 FontSize="15" 
                                 VerticalContentAlignment="Center"
                                 Height="36"
                                 KeyDown="TxtPassword_KeyDown"/>
                </Border>
            </StackPanel>

            <!-- 4. Error Message -->
            <TextBlock Grid.Row="3" x:Name="txtErrorMessage" Text="Mật khẩu không chính xác. Vui lòng thử lại!" 
                       Foreground="#EF4444" FontSize="12" FontWeight="SemiBold" 
                       Margin="0,0,0,8" Visibility="Collapsed" HorizontalAlignment="Left"/>

            <!-- 5. Action Buttons -->
            <Grid Grid.Row="4" VerticalAlignment="Bottom" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="✕ Hủy Bỏ" Height="40" 
                        Background="#1E293B" Foreground="#94A3B8" BorderThickness="0"
                        FontSize="13" FontWeight="SemiBold" Cursor="Hand"
                        Click="BtnCancel_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Grid.Column="2" Content="🔓 Mở Khóa" Height="40" 
                        Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0"
                        FontSize="13" FontWeight="Bold" Cursor="Hand"
                        Click="BtnUnlock_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
